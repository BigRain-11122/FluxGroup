{
  "note": "种子记忆，不属于任何事件；派生记忆不得写入本文件",
  "memories": [
    {
      "id": "M0001",
      "person_id": "P0101",
      "day": 1,
      "kind": "kept",
      "text": "第一版协议是他写的，当时没人看。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0002",
      "person_id": "P0102",
      "day": 1,
      "kind": "given",
      "text": "他抄的那份被当成正本用了一年。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0003",
      "person_id": "P0103",
      "day": 1,
      "kind": "lost",
      "text": "来的时候有一段记忆没带过来。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0004",
      "person_id": "P0201",
      "day": 1,
      "kind": "kept",
      "text": "他造的东西，有一半运去了别的大陆。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0005",
      "person_id": "P0202",
      "day": 1,
      "kind": "given",
      "text": "他修好的第一台机器，后来被人拆了卖。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0006",
      "person_id": "P0203",
      "day": 1,
      "kind": "lost",
      "text": "他把那个人最后说的话记得很清楚。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0007",
      "person_id": "P0301",
      "day": 1,
      "kind": "kept",
      "text": "他签过一份名单，签完手抖了一晚上。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0008",
      "person_id": "P0302",
      "day": 1,
      "kind": "given",
      "text": "他放走的那个人，现在在边境排队。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0009",
      "person_id": "P0303",
      "day": 1,
      "kind": "lost",
      "text": "他想不起来自己为什么来这里。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0010",
      "person_id": "P0401",
      "day": 1,
      "kind": "kept",
      "text": "全城有三次断电，都是他一个人顶回去的。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0011",
      "person_id": "P0402",
      "day": 1,
      "kind": "given",
      "text": "他替那户人家垫过两次电。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0012",
      "person_id": "P0403",
      "day": 1,
      "kind": "lost",
      "text": "他已经连着守了很久，不记得多久。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0013",
      "person_id": "P0501",
      "day": 1,
      "kind": "kept",
      "text": "他垫钱的那家人，昨天搬走了。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0014",
      "person_id": "P0502",
      "day": 1,
      "kind": "given",
      "text": "他在这里住了很久，没人记得他是哪天来的。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0015",
      "person_id": "P0503",
      "day": 1,
      "kind": "kept",
      "text": "他记得这里每条街原来的样子。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0016",
      "person_id": "P0601",
      "day": 1,
      "kind": "lost",
      "text": "他的记忆只到三天前。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0017",
      "person_id": "P0602",
      "day": 1,
      "kind": "given",
      "text": "他帮人搬过一整条街的东西。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0018",
      "person_id": "P0603",
      "day": 1,
      "kind": "kept",
      "text": "他唱的那半首，很多人会跟着哼。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0019",
      "person_id": "P0701",
      "day": 1,
      "kind": "kept",
      "text": "他有两份记忆备份，自己也不知道哪份是真的。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0020",
      "person_id": "P0702",
      "day": 1,
      "kind": "given",
      "text": "他修的路，救过一整个车队。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0021",
      "person_id": "P0703",
      "day": 1,
      "kind": "lost",
      "text": "他记不清自己为什么留下。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0022",
      "person_id": "P0801",
      "day": 1,
      "kind": "kept",
      "text": "他造的东西，外面的人没见过。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0023",
      "person_id": "P0802",
      "day": 1,
      "kind": "given",
      "text": "他带出去的东西，救过外面一个人。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0024",
      "person_id": "P0803",
      "day": 1,
      "kind": "kept",
      "text": "他记得每件东西是谁的。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0025",
      "person_id": "P0901",
      "day": 1,
      "kind": "lost",
      "text": "他不确定自己原来叫什么。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0026",
      "person_id": "P0902",
      "day": 1,
      "kind": "given",
      "text": "他偷偷多放进去过三个人。",
      "event_id": null,
      "unrecognized": null
    },
    {
      "id": "M0027",
      "person_id": "P0903",
      "day": 1,
      "kind": "kept",
      "text": "他记得每一样埋下去的东西在哪。",
      "event_id": null,
      "unrecognized": null
    }
  ]
}