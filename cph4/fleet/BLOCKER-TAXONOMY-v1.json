   "detect": "declared_but_no_card",
   "resolve": "run:night_plan",
   "auto": true,
   "every_s": 300,
   "escalate_after": 2,
   "owner": "bm-m"
  },
  {
   "id": "CARD-DEFECT-LOOP",
