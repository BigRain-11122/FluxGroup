{
 "_comment": "堵点/坏点/卡点分类表（CEO 2026-11-08「堵点坏点卡点都要有相应的循环策略去检测和解决」）。每类必须四件齐：detect 判据、resolve 解法、every_s 复查周期、escalate_after 升级轮次。缺任一件=纸面政策，RG-23 会红。",
 "_law": [
  "自动解只允许确定性的、可逆的动作（补卡/改字段/推同步/重跑阶段）；不许自动改阈值、不许自动删数据、不许自动对外",
  "解不了就按轮次升级，不许静默留着：同一类连续 escalate_after 轮未解 → 进上班长/CEO 面",
  "每类都要留痕：state/blocker-ledger.jsonl 一行一次命中，按 (class, key) 去重，同一件事不重复记账",
  "检测器必须能抓到自己的合成反例（--selftest），抓不到=闸失效",
  "假红与真堵同等有害：能定性为 PARKED/远端/无产物的，必须降级成非行动项，不许天天报"
 ],
 "classes": [
  {
   "id": "SUPPLY-SHORT",
   "name": "供给断供：有机器空转但没有可跑的卡",
   "symptom": "在线车道空着，而队列 OPEN 卡数 < 车道数×2",
   "detect": "lane_empty_and_queue_thin",
   "resolve": "run:night_fill+workgen+supply_batch",
   "auto": true,
   "every_s": 300,
   "escalate_after": 3,
   "owner": "bm-m"
  },
  {
   "id": "DECL-UNDISPATCHED",
   "name": "声明未派：线上写了下一步，队列里没有那张卡",
