{"schema": "stockera.episode.v1", "drama_id": "drama-001-stockera", "season": 1, "episode_id": "EP008", "episode_no": 8, "title": "有人在憋气", "written_by": "编剧席A1", "version": "2.0（返工覆盖：时长压档+镜数压缩）", "duration_seconds": 73, "duration_breakdown": {"main": 64, "compliance_tail": 5, "next_ep_teaser": 4}, "shot_count": 23, "shot_length_rule": "单镜2-5秒", "duration_band": "60-90s全系列统一档", "aspect_ratio": "9:16", "era_anchor": "1997年春·华证证券人民路营业部", "paywall": {"is_paywall_episode": false, "season_paywall_blast_episode": "EP006", "note": "付费正文"}, "arc": {"act": "S1-A3", "phase": "试探期升级：人为砸盘考他+长虹反杀+请帖阴谋", "episode_mission": "①金鼎被人为砸盘（F-020执行）；②长虹以父亲笔记识破方形单节奏；③『明天十点二十它会自己回来』救满仓于恐慌；④熊天成判定及格收手；⑤熊伟下帖：大户室请喝茶"}, "hook_trio": {"opening": {"timecode": "00:00-00:14", "type": "盘口识人钩", "shots": "R1-R5", "summary": "金鼎瀑布跳水，长虹盯出方形单节奏：这盘口有人在憋气；笔记本批注：方单必有肉疼的成本线"}, "midpoint": {"timecode": "00:22-00:42", "type": "点单立誓钩", "shots": "R9-R14", "summary": "明天十点二十它会自己回来；满仓折单——满仓连信人也满仓；次日10:20反抽应验，分毫不差"}, "ending": {"timecode": "00:52-01:04", "type": "阴谋钩", "shots": "R18-R21", "summary": "熊伟送烫金请帖（茶钱预付）：茶是明天的答案是今天的，上不上来你自己算；深夜请帖压在父亲笔记本上——两封战书并排：这杯茶是请还是埋"}}, "hook_rotation": {"index": 8, "ending_hook_type": "阴谋钩", "rotation_map": {"EP004": "悬念钩", "EP005": "反转钩", "EP006": "危机钩", "EP007": "身份钩", "EP008": "阴谋钩", "EP009": "情感钩"}}, "characters_present": ["长虹", "满仓", "红利", "老蔡", "熊天成", "熊伟"], "dialogue_fingerprints": [{"character": "熊天成", "fingerprint": "信条句", "required_min": 2, "delivered": ["模型算市场，算不了人心。他算的，是人的呼吸。", "考砸的人才继续考。他及格了。"]}, {"character": "熊伟", "fingerprint": "算法冷感", "required_min": 1, "delivered": ["我砸的每一单，他都提前一秒知道。这不在模型里。", "茶，是明天的。答案，是今天的。上不上来，你自己算。"]}, {"character": "长虹", "fingerprint": "K线比喻", "required_min": 1, "delivered": ["这盘口……有人在憋气。", "破的是画出来的位。"]}, {"character": "满仓", "fingerprint": "全仓梗", "required_min": 1, "delivered": ["我满仓，连信人也满仓！"]}, {"character": "红利", "fingerprint": "账目眼", "required_min": 1, "delivered": ["委托单排号！插队的，没收。", "恐慌单，我照收；后悔药，本店没有。"]}], "plot_state": {"protagonist_cash_yuan": 3000, "protagonist_identity": "夜班保洁+黑板军师（获大户室茶局请帖）", "alias_status": "长虹", "notebook_pages_remaining": 41, "key_foreshadow_ids": ["F-022", "F-023"], "foreshadows_closed": ["F-020"], "foreshadows_advanced": ["F-015（满仓信仰满格）"], "xiong_family_state": {"熊天成": "判定及格，转入收编试探（茶局请帖）", "熊伟": "模型失效存疑，继续观察"}, "relationships": {"满仓": "生死之交（十点二十救仓）", "红利": "大厅秩序维护者，中立偏长虹"}}, "compliance": {"guardrails_v8_checked": true, "items_passed": 8, "fictional_tickers": ["金鼎电子"], "risk_disclaimer_shot": "R22", "notes": ["砸盘仅呈现结果与节奏隐喻，无下单手法与协同细节", "十点二十为戏剧化时点预判，片尾追加不可复现专项声明", "长虹台词『谢你自己没乱动』传递风控价值观"]}, "linked_files": {"script": "EP008-script.md", "next_script": "EP009-script.md"}, "next_episode_constraints": ["EP009必须完成：大户室茶局正面谈判（信条句vsK线句不对等威压）／婉拒收编『先生的茶太贵我喝不起』／搭伙成交（红利账本立约：本金账户下单均归满仓，长虹只写点位，盈亏对半，亏一成歇三天）／熊伟收尾建档『样本外事件』", "EP009时长60-90s档、20-25镜", "EP009尾钩类型：情感钩（轮换位#9）", "交给EP010接口：茶局结怨+搭伙成形→金鼎下一轮异动，EP009内勿展开新战局"]}