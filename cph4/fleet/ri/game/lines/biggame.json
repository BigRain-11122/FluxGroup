{
 "line": "biggame",
 "name": "游戏（可上线清单 → 一款可玩包 → 提审材料）",
 "group": "game",
 "note": "游戏仓在工作机；机器能判的只有'哪几款现在就能提审'。选款/提审材料是判断与资质活，不写成工序卡——写了就必然假红（2026-11-03 实测）。",
 "stages": [
  {
   "id": "pack-scan",
   "name": "可上线包清单（唯一能机器判的段）",
   "cmd": "python {root_tools}/fleet/game_pack_scan.py --root gaming --out cph4/fleet/queue-receipts/game-packs-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/game-packs-{date}.json",
   "accept": "给出可提审候选（<200MB 的包）与各自分区；0 个也要写明扫了哪些目录",
   "needs": "cpu",
   "nodes": [
    "bm-a"
   ],
   "minutes": 3,
   "requires": [
    "gaming/MiniGame"
   ],
   "day_ok": false
  },
  {
   "id": "accept",
   "name": "质量验收（缺一份闸回执就不算交付）",
   "cmd": "python {root_tools}/fleet/quality_gate.py --line biggame --out cph4/fleet/queue-receipts/quality-biggame-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/quality-biggame-{date}.json",
   "accept": "verdict=PASS；否则列出缺哪份闸/哪份 FAIL",
   "needs": "cpu",
   "minutes": 1,
   "depends_on": [
    "pack-scan"
   ]
  }
 ]
}