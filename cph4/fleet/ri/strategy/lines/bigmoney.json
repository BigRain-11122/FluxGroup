{
 "line": "bigmoney",
 "name": "金融量化（回测 → 一页结论 → 可报价或写清卡点）",
 "group": "strategy",
 "note": "量化仓只在 bm-b/bm-d；白天 bm-a 让路，别派给它。2026-11-03 梳理：主交付物=每月「结论 + 下月信号 CSV」，回测只是过程。",
 "stages": [
  {
   "id": "backtest",
   "name": "生产候选回测（去债档 + 8% 波动目标）",
   "cmd": "python quant/bigmoney/scripts/etf_nobond_vt.py",
   "deliverable": "quant/bigmoney/results/etf_nobond_vt.json",
   "accept": "JSON 在盘且含 cagr/sharpe/maxdd；同时打印 OOS 段；失败留 stderr 尾部",
   "needs": "cpu",
   "nodes": [
    "bm-b",
    "bm-d"
   ],
   "minutes": 20,
   "requires": [
    "quant/bigmoney/scripts/etf_nobond_vt.py"
   ],
   "why": "2026-11-03 梳理：日更原指 etf_composite_pf.py（旧书，含债档无波动目标），绿的是没人会买的策略"
  },
  {
   "id": "signal",
   "name": "下月持仓信号 CSV（可卖的唯一产物）",
   "cmd": "python {root_tools}/fleet/quant_signal.py --in quant/bigmoney/results/etf_nobond_vt.json --out cph4/fleet/queue-receipts/quant-signal-{date}.csv",
   "deliverable": "cph4/fleet/queue-receipts/quant-signal-{date}.csv",
   "accept": "CSV 每行含 代码/权重/因子值/生成时间/输入指纹；空仓也要写（含原因）",
   "needs": "cpu",
   "nodes": [
    "bm-b",
    "bm-d"
   ],
   "minutes": 3,
   "depends_on": [
    "backtest"
   ],
   "why": "客户买的是下月买什么，不是回测曲线"
  },
  {
   "id": "conclusion",
   "name": "一页结论（四件齐才许对外）",
   "cmd": "python {root_tools}/fleet/quant_conclusion.py --in quant/bigmoney/results/etf_composite_pf.json --line bigmoney --out cph4/fleet/queue-receipts/quant-conclusion-{date}.md",
   "deliverable": "cph4/fleet/queue-receipts/quant-conclusion-{date}.md",
   "accept": "四件齐全→可对外；缺件→写明缺什么（rc=3 也算如实）",
   "needs": "cpu",
   "nodes": [
    "bm-b",
    "bm-d"
   ],
   "minutes": 3,
   "depends_on": [
    "signal"
   ]
  },
  {
   "id": "quote",
   "name": "19.9 套餐可交付性判定（能不能卖、卡在哪）",
   "cmd": "python {root_tools}/fleet/line_triage.py --line bigmoney",
   "deliverable": "cph4/fleet/queue-receipts/quant-quote-{date}.md",
   "accept": "给一句能卖/不能卖的判断，附证据指针",
   "needs": "cpu",
   "nodes": [
    "bm-b",
    "bm-d"
   ],
   "minutes": 3,
   "depends_on": [
    "conclusion"
   ]
  },
  {
   "id": "accept",
   "name": "质量验收（缺一份闸回执就不算交付）",
   "cmd": "python {root_tools}/fleet/quality_gate.py --line bigmoney --out cph4/fleet/queue-receipts/quality-bigmoney-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/quality-bigmoney-{date}.json",
   "accept": "verdict=PASS；否则列出缺哪份闸/哪份 FAIL",
   "needs": "cpu",
   "minutes": 1,
   "depends_on": [
    "quote"
   ]
  }
 ]
}