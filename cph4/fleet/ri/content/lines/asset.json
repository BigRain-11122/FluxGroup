{
 "line": "asset-lib",
 "name": "资产储备（角色 LoRA / 音色库）",
 "group": "content",
 "internal": true,
 "priority": "P0",
 "note": "CEO 2026-11-03 令：先不做短剧与漫剧，先储备资产。这条线不对外卖，所以没有市场门（internal=true）。机器能判的只到「数据集合不合格、环境能不能烧」；「有没有特色」只能人看/人听，故不写成机器判据。训练本身不在工序卡里，因为要先过 env-check 才知道哪台机走哪条路线，见 cph4/fleet/asset-lib-v1/ASSET-LIB-BUILD-v1.md。",
 "stages": [
  {
   "id": "env-check",
   "name": "训练环境自检（这台机能不能烧）",
   "cmd": "python {root_tools}/fleet/asset_env_check.py --out cph4/fleet/queue-receipts/asset-env-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/asset-env-{date}.json",
   "accept": "verdict=PASS 且 routes_ok 非空；FAIL 时 gaps 必须点名缺哪套栈（kohya / GPT-SoVITS / CUDA / 磁盘）",
   "needs": "cpu",
   "nodes": [],
   "minutes": 2
  },
  {
   "id": "voice-corpus-bma",
   "name": "音色语料工程·分片 0/4（bm-a，纯 CPU）",
   "cmd": "python {root_tools}/fleet/voice_corpus_prep.py --inbox media/asset/inbox --group batch-{date} --shard 0/4 --receipt cph4/fleet/queue-receipts/voice-corpus-bm-a-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/voice-corpus-bm-a-{date}.json",
   "accept": "本分片切出片段并写 index.json；inbox 无本分片输入时回执 BLOCKED 并说明（rc=3 属等投料）",
   "needs": "cpu",
   "nodes": [
    "bm-a"
   ],
   "minutes": 40,
   "parallel": true,
   "ok_rc": [
    0,
    3
   ]
  },
  {
   "id": "voice-corpus-bmb",
   "name": "音色语料工程·分片 1/4（bm-b，纯 CPU）",
   "cmd": "python {root_tools}/fleet/voice_corpus_prep.py --inbox media/asset/inbox --group batch-{date} --shard 1/4 --receipt cph4/fleet/queue-receipts/voice-corpus-bm-b-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/voice-corpus-bm-b-{date}.json",
   "accept": "本分片切出片段并写 index.json；inbox 无本分片输入时回执 BLOCKED 并说明（rc=3 属等投料）",
   "needs": "cpu",
   "nodes": [
    "bm-b"
   ],
   "minutes": 40,
   "parallel": true,
   "ok_rc": [
    0,
    3
   ]
  },
  {
   "id": "voice-corpus-bmc",
   "name": "音色语料工程·分片 2/4（bm-c，纯 CPU）",
   "cmd": "python {root_tools}/fleet/voice_corpus_prep.py --inbox media/asset/inbox --group batch-{date} --shard 2/4 --receipt cph4/fleet/queue-receipts/voice-corpus-bm-c-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/voice-corpus-bm-c-{date}.json",
   "accept": "本分片切出片段并写 index.json；inbox 无本分片输入时回执 BLOCKED 并说明（rc=3 属等投料）",
   "needs": "cpu",
   "nodes": [
    "bm-c"
   ],
   "minutes": 40,
   "parallel": true,
   "ok_rc": [
    0,
    3
   ]
  },
  {
   "id": "voice-corpus-bmm",
   "name": "音色语料工程·分片 3/4（bm-m，纯 CPU）",
   "cmd": "python {root_tools}/fleet/voice_corpus_prep.py --inbox media/asset/inbox --group batch-{date} --shard 3/4 --receipt cph4/fleet/queue-receipts/voice-corpus-bm-m-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/voice-corpus-bm-m-{date}.json",
   "accept": "本分片切出片段并写 index.json（本机是主控，只夜间跑以免抢脉冲）；inbox 无输入时 BLOCKED（rc=3）",
   "needs": "cpu",
   "nodes": [
    "bm-m"
   ],
   "minutes": 40,
   "parallel": true,
   "ok_rc": [
    0,
    3
   ],
   "day_ok": false
  },
  {
   "id": "face-dataset",
   "name": "人脸数据集准入（反 AI 脸的第一道门）",
   "cmd": "python {root_tools}/fleet/asset_dataset_audit.py --mode face --dir media/asset/faces --out cph4/fleet/queue-receipts/asset-face-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/asset-face-{date}.json",
   "accept": "verdict=PASS（张数≥12/短边≥768/近似重复≤30%/细节能量达标）；FAIL 时逐条写明是网红脸还是磨皮脸",
   "needs": "cpu",
   "nodes": [],
   "minutes": 5
  },
  {
   "id": "voice-dataset",
   "name": "音色数据集准入（反播音腔的第一道门）",
   "cmd": "python {root_tools}/fleet/asset_dataset_audit.py --mode voice --dir media/asset/voices --out cph4/fleet/queue-receipts/asset-voice-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/asset-voice-{date}.json",
   "accept": "verdict=PASS（≥8 条/总时长≥60s/2-12s 占比≥80%/停顿密度≥6 次每分/LRA≥5）；FAIL 时写明是不是播音腔",
   "needs": "cpu",
   "nodes": [],
   "minutes": 5,
   "depends_on": [
    "voice-corpus-bma",
    "voice-corpus-bmb",
    "voice-corpus-bmc",
    "voice-corpus-bmm"
   ]
  },
  {
   "id": "face-caption",
   "name": "人脸数据集打标（vision 草稿，人只校对）",
   "cmd": "python {root_tools}/fleet/asset_caption.py --dir media/asset/faces --out cph4/fleet/queue-receipts/asset-caption-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/asset-caption-{date}.json",
   "accept": "每张图产出 <同名>.txt（<触发词>, 可见属性描述）；含推测/身份词的一律退回不写；没有待打标图时 BLOCKED rc=3",
   "needs": "gpu",
   "nodes": [
    "bm-m"
   ],
   "minutes": 10,
   "ok_rc": [
    0,
    3
   ],
   "depends_on": [
    "face-dataset"
   ]
  },
  {
   "id": "index",
   "name": "入库登记（没过闸的不许进资产库）",
   "cmd": "python {root_tools}/fleet/vault.py list --limit 5",
   "deliverable": "cph4/fleet/queue-receipts/asset-index-{date}.json",
   "accept": "台账里有本批角色/音色条目，且 license 字段非空；未过闸的数据集不得登记为 cleared",
   "needs": "cpu",
   "nodes": [],
   "minutes": 3,
   "depends_on": [
    "face-dataset",
    "voice-dataset"
   ]
  },
  {
   "id": "library-check",
   "name": "库体检（数量/规格/授权/缺口）",
   "cmd": "python {root_tools}/fleet/asset_library_check.py --tier p0 --out cph4/fleet/queue-receipts/asset-library-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/asset-library-{date}.json",
   "accept": "产出十类逐项 数量/目标/授权 与缺口清单；EMPTY 与 GAPS 都算诚实状态，不判失败但要列差多少",
   "needs": "cpu",
   "nodes": [],
   "minutes": 5,
   "ok_rc": [
    0,
    1
   ],
   "parallel": true
  },
  {
   "id": "accept",
   "name": "质量验收（缺一份闸回执就不算交付）",
   "cmd": "python {root_tools}/fleet/quality_gate.py --line asset-lib --out cph4/fleet/queue-receipts/quality-asset-lib-{date}.json",
   "deliverable": "cph4/fleet/queue-receipts/quality-asset-lib-{date}.json",
   "accept": "verdict=PASS；否则列出缺哪份闸",
   "needs": "cpu",
   "minutes": 1,
   "depends_on": [
    "index"
   ]
  },
  {
   "id": "char-prompts",
   "name": "角色包出图计划（8 原创角色 × 6 视角提示词包）",
   "cmd": "python {root_tools}/fleet/char_plan.py",
   "deliverable": "cph4/fleet/queue-receipts/char-gen-plan-{date}.json",
   "accept": "8 个角色目录各有 PROMPTS.json；汇总回执 characters=8、total_images_needed=48",
   "needs": "cpu",
   "nodes": [
    "bm-c",
    "bm-a"
   ],
   "minutes": 5,
   "day_ok": true
  },
  {
   "id": "char-gen",
   "name": "角色包出图（本机 ComfyUI，1024²，同 seed 组）",
   "cmd": "python {root_tools}/fleet/char_gen.py --node bm-c --limit 12",
   "deliverable": "cph4/fleet/queue-receipts/char-gen-bm-c-{date}.json",
   "accept": "回执 made>0 且无 failed；BLOCKED 时必须写明缺模型配置或 ComfyUI 不可达",
   "needs": "gpu",
   "nodes": [
    "bm-c"
   ],
   "minutes": 40,
   "day_ok": false,
   "depends_on": [
    "char-prompts"
   ]
  },
  {
   "id": "char-dataset",
   "name": "角色数据集装配（出图→faces/<ID>+授权→逐角色过准入闸）",
   "cmd": "python {root_tools}/fleet/char_dataset.py",
   "deliverable": "cph4/fleet/queue-receipts/char-dataset-{date}.json",
   "accept": "passed>0；每个角色列出 图数/准入结论；图不足或未过闸的角色写明缺口",
   "needs": "cpu",
   "nodes": [
    "bm-c",
    "bm-a"
   ],
   "minutes": 10,
   "day_ok": true,
   "ok_rc": [
    0,
    3
   ],
   "depends_on": [
    "char-gen"
   ]
  },
  {
   "id": "voice-assemble",
   "name": "音色数据集装配（授权核查→voices/<组> 准入）",
   "cmd": "python {root_tools}/fleet/voice_dataset.py",
   "deliverable": "cph4/fleet/queue-receipts/voice-dataset-{date}.json",
   "accept": "passed>0；每组列出 片段数/授权结论/准入结论；缺授权或缺片段写明缺口",
   "needs": "cpu",
   "nodes": [
    "bm-b",
    "bm-c"
   ],
   "minutes": 10,
   "day_ok": true,
   "ok_rc": [
    0,
    3
   ],
   "depends_on": [
    "voice-corpus-bma"
   ]
  },
  {
   "id": "char-probe",
   "name": "角色出图模型探针（问本机 ComfyUI 有哪些模型，不出图）",
   "cmd": "python {root_tools}/fleet/char_gen.py --node bm-c --probe-only",
   "deliverable": "cph4/fleet/asset-lib-v1/comfy-bm-c.json",
   "accept": "配置在盘且 route 非空；route 为空时写明没有任何可用 checkpoint",
   "needs": "cpu",
   "nodes": [
    "bm-c"
   ],
   "minutes": 3,
   "day_ok": true,
   "ok_rc": [
    0,
    3
   ]
  }
 ]
}