{
 "line": "bigstream-duanju",
 "name": "短剧（配音质检→带声合流→可发集数）",
 "group": "content",
 "note": "素材与配音在工作机（bm-b/bm-c）。真正的产出是'可发布集数'而不是报告，所以第三段必须给出集号清单。",
 "stages": [
  {
   "id": "tts-qc",
   "name": "配音质检（逐集时长/静音/体积 → 可发布清单）",
   "cmd": "python {root_tools}/fleet/tts_batch_check.py --dir media/drama-tts-batch",
   "deliverable": "cph4/fleet/queue-receipts/duanju-tts-qc-{date}.json",
   "accept": "每集给出 ok/bad 与原因；给出可发布集数",
   "needs": "cpu",
   "nodes": ["bm-b"],
   "minutes": 10
  },
  {
   "id": "remux",
   "name": "带声合流（三层混音 → 成片，loudnorm -14）",
   "cmd": "python {root_tools}/backlog_fill.py --root .",
   "deliverable": "cph4/fleet/queue-receipts/duanju-remux-{date}.json",
   "accept": "新增成片数>0 时，每集输出路径在盘且 ffprobe 能读",
   "needs": "cpu",
   "nodes": ["bm-b"],
   "minutes": 20,
   "depends_on": ["tts-qc"]
  },
  {
   "id": "episode-list",
   "name": "可发集数清单（集号+时长+体积+闸结论）",
   "cmd": "python {root_tools}/fleet/line_triage.py --line bigstream-duanju",
   "deliverable": "cph4/fleet/queue-receipts/duanju-shippable-{date}.md",
   "accept": "给出可直接发的集号，或写明卡在哪一步",
   "needs": "cpu",
   "nodes": ["bm-b"],
   "minutes": 5,
   "depends_on": ["remux"]
  }
 ]
}