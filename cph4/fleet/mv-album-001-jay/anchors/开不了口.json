 "lines": [
  {
   "t0": 4.4,
   "t1": 5.8,
   "text": "Zither Harp"
  },
  {
   "t0": 27.52,
   "t1": 28.28,
   "text": "Zither Harp"
  },
  {
   "t0": 28.28,
   "t1": 31.82,
   "text": "才离开没多久就开始担心"
  },
  {
   "t0": 31.82,
   "t1": 33.64,
   "text": "今天的你过得好不好"
  },
  {
   "t0": 33.64,
   "t1": 37.06,
   "text": "整个画面是你"
  },
  {
   "t0": 37.06,
   "t1": 39.74,
   "text": "像你像的睡不着"
  },
  {
   "t0": 41.2,
   "t1": 44.82,
   "text": "最多的那可爱的模样"
  },
  {
   "t0": 44.82,
   "t1": 48.06,
   "text": "还有在你身上想想的味道"
  },
  {
   "t0": 48.06,
   "t1": 50.72,
   "text": "我的快乐是你"
  },
  {
   "t0": 50.72,
   "t1": 53.84,
   "text": "像你想的都会在"
  },
  {
   "t0": 53.84,
   "t1": 58.7,
   "text": "没有你在我有多难耐"
  },
  {
   "t0": 58.7,
   "t1": 61.02,
   "text": "没有你在我有多难耐"
  },
  {
   "t0": 61.02,
   "t1": 66.1,
   "text": "没有你烦我有多烦啊"
  },
  {
   "t0": 67.72,
   "t1": 74.54,
   "text": "我穿过眼层我试着努力向你发抖"
  },
  {
   "t0": 74.54,
   "t1": 77.16,
   "text": "爱再送到你去"
  },
  {
   "t0": 77.16,
   "t1": 80.16,
   "text": "才别的我害怕"
  },
  {
   "t0": 81.7,
   "t1": 86.06,
   "text": "就算爱不了不让它震荡"
  },
  {
   "t0": 87.06,
   "t1": 92.82,
   "text": "我一定会呵护着你也懂你笑"
  },
  {
   "t0": 94.08,
   "t1": 97.46,
   "text": "你对我有多重要"
  },
  {
   "t0": 97.62,
   "t1": 100.66,
   "text": "我好为没让你知道"
  },
  {
   "t0": 100.66,
   "t1": 104.6,
   "text": "安静的盯你傻角"
  },
  {
   "t0": 104.6,
   "t1": 108.22,
   "text": "看你睡着一直打牢"
  },
  {
   "t0": 108.22,
   "t1": 113.1,
   "text": "就是开不了口让它知道"
  },
  {
   "t0": 114.58,
   "t1": 117.44,
   "text": "就是那么简单"
  },
  {
   "t0": 117.44,
   "t1": 120.0,
   "text": "几句我办不到"
  },
  {
   "t0": 121.6,
   "t1": 125.12,
   "text": "整个星星在办公"
  },
  {
   "t0": 125.12,
   "t1": 128.62,
   "text": "我只能够远远靠着"
  },
  {
   "t0": 128.62,
   "t1": 132.08,
   "text": "只是我都做得到"
  },
  {
   "t0": 132.08,
   "t1": 136.6,
   "text": "但那个人已经不是我"
  },
