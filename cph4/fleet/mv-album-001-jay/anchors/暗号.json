  {
   "t0": 5.76,
   "t1": 6.28,
   "text": "作曲 李宗盛"
  },
  {
   "t0": 6.28,
   "t1": 6.82,
   "text": "作曲 李宗盛"
  },
  {
   "t0": 6.82,
   "t1": 6.82,
   "text": ""
  },
  {
   "t0": 14.66,
   "t1": 15.18,
   "text": "作曲 李宗盛"
  },
  {
   "t0": 15.9,
   "t1": 17.86,
   "text": "我想要的 想做的"
  },
  {
   "t0": 17.86,
   "t1": 19.92,
   "text": "比比赛 都了不起"
  },
  {
   "t0": 19.92,
   "t1": 21.68,
   "text": "想说的 想给的"
  },
  {
   "t0": 21.68,
   "t1": 23.26,
   "text": "我却都知道"
  },
  {
   "t0": 23.26,
   "t1": 25.32,
   "text": "未接来电 没留言"
  },
  {
   "t0": 25.76,
   "t1": 27.84,
   "text": "一定是你无人计算点"
  },
  {
   "t0": 27.84,
   "t1": 29.68,
   "text": "任何人都猜不到"
  },
  {
   "t0": 29.68,
   "t1": 31.7,
   "text": "这就是我的感觉"
  },
  {
   "t0": 31.7,
   "t1": 33.58,
   "text": "他们在 随便猜"
  },
  {
   "t0": 33.58,
   "t1": 36.92,
   "text": "不重要 连上彼此的信号"
  },
  {
   "t0": 36.92,
   "t1": 38.62,
   "text": "才有个一个"
  },
  {
   "t0": 38.62,
   "t1": 40.7,
   "text": "有太多人 太多事"
  },
  {
   "t0": 40.7,
   "t1": 42.58,
   "text": "它在我们之间跑"
  },
  {
   "t0": 42.58,
   "t1": 44.74,
   "text": "傻傻寻 太多心啊"
  },
  {
   "t0": 44.74,
   "t1": 45.78,
   "text": "若有脸风"
  },
  {
   "t0": 45.78,
   "t1": 49.18,
   "text": "吹都要感扰 可是你不想"
  },
  {
   "t0": 49.98,
   "t1": 53.62,
   "text": "一直就在黑暗地下倒"
  },
  {
   "t0": 53.62,
   "t1": 55.82,
   "text": "想追风 想自由"
  },
  {
   "t0": 55.82,
   "t1": 57.84,
   "text": "想要一切收听说"
  },
  {
   "t0": 57.84,
   "t1": 60.82,
   "text": "去看海 保持世界流浪"
  },
  {
   "t0": 61.82,
   "t1": 65.8,
   "text": "我还怕你心碎没人"
  },
  {
   "t0": 65.8,
   "t1": 68.42,
   "text": "把你擦眼泪"
  },
  {
   "t0": 69.46,
   "t1": 72.12,
   "text": "别管它是非"
  },
  {
   "t0": 72.82,
   "t1": 75.98,
   "text": "只要我们能绝对"
  },
  {
   "t0": 77.02,
   "t1": 81.02,
   "text": "我还怕你心碎没人"
  },
  {
   "t0": 81.02,
   "t1": 83.62,
   "text": "把你擦眼泪"
  },
  {
   "t0": 84.82,
   "t1": 87.84,
   "text": "别离开身边"
  },
  {
   "t0": 87.84,
   "t1": 90.78,
   "text": "拥有你我的世界"
  },
  {
   "t0": 90.78,
   "t1": 93.72,
   "text": "才能完美"
  },
