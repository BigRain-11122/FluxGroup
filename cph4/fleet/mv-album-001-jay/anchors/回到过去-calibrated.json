[
 {
  "t0": 7.72,
  "t1": 13.22,
  "text": "一盏黄黄旧旧的灯",
  "approx": false
 },
 {
  "t0": 13.22,
  "t1": 18.81,
  "text": "时间在旁闷不吭声",
  "approx": false
 },
 {
  "t0": 18.81,
  "t1": 24.41,
  "text": "寂寞下手毫无分寸",
  "approx": false
 },
 {
  "t0": 24.41,
  "t1": 30.11,
  "text": "不懂得轻重之分",
  "approx": false
 },
 {
  "t0": 30.11,
  "t1": 35.92,
  "text": "沉默支撑跃过陌生",
  "approx": false
 },
 {
  "t0": 35.92,
  "t1": 41.56,
  "text": "静静看着凌晨黄昏",
  "approx": false
 },
 {
  "t0": 41.56,
  "t1": 44.35,
  "text": "你的身影",
  "approx": false
 },
 {
  "t0": 44.35,
  "t1": 46.03,
  "text": "失去平衡",
  "approx": false
 },
 {
  "t0": 46.03,
  "t1": 52.09,
  "text": "慢慢下沉",
  "approx": false
 },
 {
  "t0": 52.09,
  "t1": 56.02,
  "text": "黑暗已在空中盘旋",
  "approx": false
 },
 {
  "t0": 56.02,
  "t1": 61.2,
  "text": "该往哪我看不见",
  "approx": false
 },
 {
  "t0": 61.2,
  "t1": 66.67,
  "text": "也许爱在梦的另一端",
  "approx": false
 },
 {
  "t0": 66.67,
  "t1": 72.31,
  "text": "无法存活在真实的空间",
  "approx": false
 },
 {
  "t0": 72.31,
  "t1": 75.47,
  "text": "想回到过去",
  "approx": false
 },
 {
  "t0": 75.47,
  "t1": 78.97,
  "text": "试着抱你在怀里",
  "approx": false
 },
 {
  "t0": 78.97,
  "t1": 84.22,
  "text": "羞怯的脸带有一点稚气",
  "approx": false
 },
 {
  "t0": 84.22,
  "t1": 87.14,
  "text": "想看你看的世界",
  "approx": false
 },
 {
  "t0": 87.14,
  "t1": 89.87,
  "text": "想在你梦的画面",
  "approx": false
 },
 {
  "t0": 89.87,
  "t1": 92.16,
  "text": "只要靠在一起",
  "approx": false
 },
 {
  "t0": 92.16,
  "t1": 95.04,
  "text": "就能感觉甜蜜",
  "approx": false
 },
 {
  "t0": 95.04,
  "t1": 97.99,
  "text": "想回到过去",
  "approx": false
 },
 {
  "t0": 97.99,
  "t1": 101.54,
  "text": "试着让故事继续",
  "approx": false
 },
 {
  "t0": 101.54,
  "t1": 106.82,
  "text": "至少不再让你离我而去",
  "approx": false
 },
 {
  "t0": 106.82,
  "t1": 109.57,
  "text": "分散时间的注意",
  "approx": false
 },
 {
  "t0": 109.57,
  "t1": 112.47,
  "text": "这次会抱得更紧",
  "approx": false
 },
 {
  "t0": 112.47,
  "t1": 114.53,
  "text": "这样挽留不知",
  "approx": false
 },
 {
  "t0": 114.53,
  "t1": 117.17,
  "text": "还来不来得及",
  "approx": false
 },
 {
  "t0": 117.17,
  "t1": 125.22,
  "text": "想回到过去",
  "approx": false
 },
 {
  "t0": 125.22,
  "t1": 126.66,
  "text": "思绪不断",
  "approx": false
 },
 {
  "t0": 126.66,
  "t1": 129.4,
  "text": "阻挡着回忆播放",
  "approx": false
 },
 {
  "t0": 129.4,
  "t1": 131.24,
  "text": "盲目的追寻",
  "approx": false
 },
 {
  "t0": 131.24,
  "t1": 135.09,
  "text": "仍然空空荡荡",
  "approx": false
 },
 {
  "t0": 135.09,
  "t1": 137.2,
  "text": "灰蒙蒙的夜晚",
  "approx": false
 },
 {
  "t0": 137.2,
  "t1": 141.09,
  "text": "睡意又不知躲到哪去",
  "approx": false
 },
 {
  "t0": 141.09,
  "t1": 142.85,
  "text": "一转身孤单",
  "approx": false
 },
 {
