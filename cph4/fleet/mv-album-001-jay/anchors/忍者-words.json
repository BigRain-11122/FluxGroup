 "lines": [
  {
   "t0": 30.5,
   "t1": 36.26,
   "text": "Oi Oi Oi Oi"
  },
  {
   "t0": 36.26,
   "t1": 38.84,
   "text": "你和了冷靜的想法"
  },
  {
   "t0": 38.84,
   "t1": 41.06,
   "text": "最會用無視的倒閉畫"
  },
  {
   "t0": 41.06,
   "t1": 43.64,
   "text": "我一個人在家乖乖再學插畫"
  },
  {
   "t0": 43.64,
   "t1": 44.4,
   "text": "嗨嗨嗨"
  },
  {
   "t0": 44.4,
   "t1": 45.4,
   "text": "我要跟你們一起玩"
  },
  {
   "t0": 45.4,
   "t1": 47.04,
   "text": "一起逆散戲"
  },
  {
   "t0": 47.04,
   "t1": 48.1,
   "text": "應往的蠻地"
  },
  {
   "t0": 48.1,
   "t1": 49.24,
   "text": "用一種生命"
  },
  {
   "t0": 49.24,
   "t1": 50.36,
   "text": "連接的不及"
  },
  {
   "t0": 50.36,
   "t1": 51.6,
   "text": "一起逆散戲"
  },
  {
   "t0": 51.6,
   "t1": 52.62,
   "text": "黑暗的兔戲"
  },
  {
   "t0": 52.62,
   "t1": 53.34,
   "text": "去逆境"
  },
  {
   "t0": 53.34,
   "t1": 54.6,
   "text": "也無道無忌"
  },
  {
   "t0": 54.6,
   "t1": 56.1,
   "text": "一起逆散戲"
  },
  {
   "t0": 56.1,
   "t1": 58.24,
   "text": "來自本不必要去放過去"
  },
  {
   "t0": 58.24,
   "t1": 59.42,
   "text": "重新從未已"
  },
  {
   "t0": 59.42,
   "t1": 60.6,
   "text": "一起逆散戲"
  },
  {
   "t0": 60.6,
   "t1": 61.68,
   "text": "一生在徹底"
  },
  {
   "t0": 61.68,
   "t1": 63.56,
   "text": "用盡的什麼是自己"
  },
  {
   "t0": 81.04,
   "t1": 81.76,
   "text": "居住"
  },
  {
   "t0": 81.76,
   "t1": 82.92,
   "text": "我能力的照燈看"
  },
  {
   "t0": 82.92,
   "t1": 84.1,
   "text": "你不滿熱血的群"
  },
  {
   "t0": 84.1,
   "t1": 84.86,
   "text": "管他不得已"
  },
  {
   "t0": 84.86,
   "t1": 85.72,
   "text": "沒法的信用我"
  },
  {
   "t0": 85.72,
   "t1": 86.58,
   "text": "走在何為擔當"
  },
  {
   "t0": 86.58,
   "t1": 87.5,
   "text": "再包含看天圓"
  },
  {
   "t0": 87.5,
   "t1": 88.62,
   "text": "加上金座太陽外"
  },
  {
   "t0": 88.62,
   "t1": 89.7,
   "text": "有一種疼痛迷"
  },
  {
   "t0": 89.7,
   "t1": 91.36,
   "text": "疼痛想找出餐拿地"
  },
  {
