 "lines": [
  {
   "t0": 5.64,
   "t1": 6.36,
   "text": "《獨一報》"
  },
  {
   "t0": 6.36,
   "t1": 8.58,
   "text": "獨一報的詐 給你重溫的交錯價"
  },
  {
   "t0": 11.52,
   "t1": 13.96,
   "text": "獨一報的詐 聽說明明你都不能"
  },
  {
   "t0": 16.88,
   "t1": 19.8,
   "text": "獨一報的詐 給你重溫的交錯價"
  },
  {
   "t0": 19.8,
   "t1": 22.58,
   "text": "獨一報的詐 果然會絕好"
  },
  {
   "t0": 22.58,
   "t1": 25.46,
   "text": "獨一報的詐 像波波的山水花"
  },
  {
   "t0": 28.78,
   "t1": 29.28,
   "text": "獨一報的詐 像波波的山水花"
  },
  {
   "t0": 29.28,
   "t1": 30.64,
   "text": "山君在地跑萬年"
  },
  {
   "t0": 30.64,
   "t1": 32.36,
   "text": "今晚終然就一見"
  },
  {
   "t0": 32.36,
   "t1": 34.24,
   "text": "我有一場自己的臉"
  },
  {
   "t0": 34.24,
   "t1": 36.46,
   "text": "全身多盡狂爭言"
  },
  {
   "t0": 36.46,
   "t1": 39.04,
   "text": "也也在從的藏墓書秒著上面"
  },
  {
   "t0": 39.04,
   "t1": 41.98,
   "text": "多記得那年 在一個雨天"
  },
  {
   "t0": 41.98,
   "t1": 44.22,
   "text": "那清水頭我躲在屋簷"
  },
  {
   "t0": 44.22,
   "t1": 46.16,
   "text": "就一直想去當秋千"
  },
  {
   "t0": 46.16,
   "t1": 49.34,
   "text": "也也做著言 手趟著路一些茶前"
  },
  {
   "t0": 49.34,
   "t1": 51.1,
   "text": "山君都穿了千年"
  },
  {
   "t0": 51.1,
   "t1": 53.18,
   "text": "那天我翻譯此點"
  },
  {
   "t0": 53.18,
   "t1": 55.84,
   "text": "擦身馬車也 形容一件"
  },
  {
   "t0": 55.84,
   "t1": 57.38,
   "text": "想你能更遠天邊"
  },
  {
   "t0": 57.38,
   "t1": 59.7,
   "text": "是否在海久對面"
  },
  {
   "t0": 59.7,
   "t1": 62.16,
   "text": "我知道就睡著知道 讓我失眠"
  },
  {
   "t0": 62.16,
   "t1": 63.88,
   "text": "這場錯場 我的看見面"
  },
  {
   "t0": 63.88,
   "t1": 65.24,
   "text": "年份永遠是三圈"
  },
  {
   "t0": 65.24,
   "t1": 68.04,
   "text": "心頭的另一邊 掉進我沉上的臉"
  },
  {
   "t0": 68.04,
   "t1": 70.54,
   "text": "盡過這線面 一眼的手間"
  },
  {
   "t0": 70.54,
   "t1": 73.7,
   "text": "保證水裡會讓我擦身抹煙"
  },
  {
   "t0": 73.7,
   "t1": 76.34,
   "text": "獨一報的詐 用一種文章作詐"
  },
  {
   "t0": 76.34,
   "t1": 79.02,
   "text": "沒法調題它 口感完全還過操"
  },
  {
   "t0": 79.02,
   "t1": 81.74,
   "text": "獨一報的詐 聽說明明你都不能"
  },
  {
   "t0": 81.74,
   "t1": 84.76,
   "text": "它牽著 別逼松 把著作天的"
  },
  {
   "t0": 84.76,
   "t1": 87.62,
   "text": "獨一報的詐 用一種文章作詐"
  },
  {
   "t0": 87.62,
   "t1": 90.42,
   "text": "它們的白髮 和它事不准說好"
  },
  {
   "t0": 90.42,
   "t1": 93.18,
   "text": "獨一報的詐 像個光芒山最晚"
  },
  {
   "t0": 93.18,
   "t1": 96.22,
   "text": "看著千年的風沙 現在還在滾"
  },
  {
   "t0": 106.9,
   "t1": 109.64,
   "text": "千年那天我翻譯此點"
  },
  {
   "t0": 109.64,
   "t1": 112.58,
   "text": "擦身抹紙 用心容易見識"
  },
  {
   "t0": 112.58,
   "t1": 116.18,
   "text": "難道越天秤 是否在海角的面"
  },
  {
