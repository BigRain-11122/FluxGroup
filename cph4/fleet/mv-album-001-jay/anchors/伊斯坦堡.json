 "lines": [
  {
   "t0": 2.8,
   "t1": 4.2,
   "text": "Zither Harp"
  },
  {
   "t0": 13.08,
   "t1": 14.2,
   "text": "Zither Harp"
  },
  {
   "t0": 23.82,
   "t1": 27.52,
   "text": "走過了很多地方"
  },
  {
   "t0": 27.52,
   "t1": 30.74,
   "text": "我來到一次彈幕"
  },
  {
   "t0": 30.74,
   "t1": 33.66,
   "text": "就像是童話故事"
  },
  {
   "t0": 33.66,
   "t1": 36.46,
   "text": "又在彈又從頭"
  },
  {
   "t0": 36.46,
   "t1": 39.92,
   "text": "每天夢中的睡到"
  },
  {
   "t0": 39.92,
   "t1": 43.02,
   "text": "劉迪是你我想要"
  },
  {
   "t0": 43.02,
   "t1": 46.0,
   "text": "卻不想你樂落"
  },
  {
   "t0": 46.0,
   "t1": 48.38,
   "text": "怎麼跳也跳不到"
  },
  {
   "t0": 49.51,
   "t1": 51.96,
   "text": "醒下來就去給他"
  },
  {
   "t0": 51.96,
   "t1": 52.98,
   "text": "到這兒嗎"
  },
  {
   "t0": 52.98,
   "t1": 55.3,
   "text": "我也睡不著"
  },
  {
   "t0": 55.3,
   "t1": 59.18,
   "text": "昨晚夢裡你來找我"
  },
  {
   "t0": 59.18,
   "t1": 61.36,
   "text": "I'm so tired"
  },
  {
   "t0": 61.36,
   "t1": 64.46,
   "text": "原來我只想要你陪我去"
  },
  {
   "t0": 64.46,
   "t1": 67.32,
   "text": "只做記住我的願望"
  },
  {
   "t0": 67.32,
   "t1": 70.9,
   "text": "什麼沒的記得我的心"
  },
  {
   "t0": 70.9,
   "t1": 72.0,
   "text": "讓你知道"
  },
  {
   "t0": 73.4,
   "t1": 75.54,
   "text": "就再一次彈抱"
  },
  {
   "t0": 75.54,
   "t1": 77.14,
   "text": "就只想你愛我"
  },
  {
   "t0": 77.14,
   "t1": 78.86,
   "text": "我想要你的微笑"
  },
  {
   "t0": 78.86,
   "t1": 81.12,
   "text": "每天有那個我交到這裡"
  },
  {
   "t0": 81.12,
   "t1": 84.74,
   "text": "你的揪上了你和我"
  },
