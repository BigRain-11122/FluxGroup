[
 {
  "t0": 29.73,
  "t1": 31.0,
  "text": "岩烧店的烟味弥漫",
  "approx": false
 },
 {
  "t0": 31.0,
  "t1": 32.18,
  "text": "隔壁是国术馆",
  "approx": false
 },
 {
  "t0": 32.18,
  "t1": 33.2,
  "text": "店里面的妈妈桑",
  "approx": false
 },
 {
  "t0": 33.2,
  "t1": 34.43,
  "text": "茶道 有三段",
  "approx": false
 },
 {
  "t0": 34.43,
  "t1": 35.64,
  "text": "教拳脚武术的老板",
  "approx": false
 },
 {
  "t0": 35.64,
  "t1": 36.96,
  "text": "练铁沙掌 耍杨家枪",
  "approx": false
 },
 {
  "t0": 36.96,
  "t1": 38.16,
  "text": "硬底子功夫最擅长",
  "approx": false
 },
 {
  "t0": 38.16,
  "t1": 39.46,
  "text": "还会金钟罩铁布衫",
  "approx": false
 },
 {
  "t0": 39.46,
  "t1": 40.41,
  "text": "他们儿子我习惯",
  "approx": false
 },
 {
  "t0": 40.41,
  "t1": 41.65,
  "text": "从小就耳濡目染",
  "approx": false
 },
 {
  "t0": 41.65,
  "t1": 42.62,
  "text": "什么刀枪跟棍棒",
  "approx": false
 },
 {
  "t0": 42.62,
  "t1": 44.24,
  "text": "我都耍的有模有样",
  "approx": false
 },
 {
  "t0": 44.24,
  "t1": 45.24,
  "text": "什么兵器最喜欢",
  "approx": false
 },
 {
  "t0": 45.24,
  "t1": 46.3,
  "text": "双截棍柔中带刚",
  "approx": false
 },
 {
  "t0": 46.3,
  "t1": 47.48,
  "text": "想要去河南嵩山",
  "approx": false
 },
 {
  "t0": 47.48,
  "t1": 48.85,
  "text": "学少林跟武当",
  "approx": false
 },
 {
  "t0": 48.85,
  "t1": 49.39,
  "text": "干什么",
  "approx": false
 },
 {
  "t0": 49.39,
  "t1": 50.05,
  "text": "干什么",
  "approx": false
 },
 {
  "t0": 50.05,
  "t1": 51.1,
  "text": "呼吸吐纳心自在",
  "approx": false
 },
 {
