  "text": "干什么",
  "approx": false
 },
 {
  "t0": 54.74,
  "t1": 55.79,
  "text": "日行千里系沙袋",
  "approx": false
 },
 {
  "t0": 55.79,
  "t1": 57.12,
  "text": "飞檐走壁莫奇怪",
  "approx": false
 },
 {
  "t0": 57.12,
  "t1": 58.03,
  "text": "去去就来",
  "approx": false
 },
 {
  "t0": 58.03,
  "t1": 59.46,
  "text": "一个马步向前",
  "approx": false
 },
 {
  "t0": 59.46,
  "t1": 61.21,
  "text": "一记左钩拳右钩拳",
  "approx": false
 },
 {
  "t0": 61.21,
  "t1": 62.91,
  "text": "一句惹毛我的人有危险",
  "approx": false
 },
 {
  "t0": 62.91,
  "t1": 63.7,
  "text": "一再重演",
  "approx": false
 },
 {
  "t0": 63.7,
  "t1": 64.85,
  "text": "一根我不抽的烟",
  "approx": false
 },
 {
  "t0": 64.85,
  "t1": 65.83,
  "text": "一放好多年",
  "approx": false
 },
 {
