[
 {
  "t0": 6.27,
  "t1": 7.23,
  "text": "爷爷泡的茶",
  "approx": false
 },
 {
  "t0": 7.23,
  "t1": 11.74,
  "text": "有一种味道叫做家",
  "approx": false
 },
 {
  "t0": 11.74,
  "t1": 12.82,
  "text": "陆羽泡的茶",
  "approx": false
 },
 {
  "t0": 12.82,
  "t1": 17.49,
  "text": "听说名和利都不拿",
  "approx": false
 },
 {
  "t0": 17.49,
  "t1": 18.48,
  "text": "爷爷泡的茶",
  "approx": false
 },
 {
  "t0": 18.48,
  "t1": 20.23,
  "text": "有一种味道叫做家",
  "approx": false
 },
 {
  "t0": 20.23,
  "t1": 21.4,
  "text": "爷爷泡的茶",
  "approx": false
 },
 {
  "t0": 21.4,
  "t1": 23.07,
  "text": "口感味觉好啊",
  "approx": false
 },
 {
  "t0": 23.07,
  "t1": 24.17,
  "text": "陆羽泡的茶",
  "approx": false
 },
 {
  "t0": 24.17,
  "t1": 29.11,
  "text": "像幅泼墨的山水画",
  "approx": false
 },
 {
  "t0": 29.11,
  "t1": 30.92,
  "text": "山泉在地表蜿蜒",
  "approx": false
 },
 {
  "t0": 30.92,
  "t1": 32.84,
  "text": "从很久很久以前",
  "approx": false
 },
 {
  "t0": 32.84,
  "t1": 34.43,
  "text": "我有一张稚气的脸",
  "approx": false
 },
 {
  "t0": 34.43,
  "t1": 36.7,
  "text": "泉水渗透进矿层岩",
  "approx": false
 },
 {
  "t0": 36.7,
  "t1": 39.53,
  "text": "爷爷栽种的樟木树苗在上面",
  "approx": false
 },
 {
  "t0": 39.53,
  "t1": 40.95,
  "text": "犹记得那年",
  "approx": false
 },
 {
  "t0": 40.95,
  "t1": 42.41,
  "text": "在一个雨天",
  "approx": false
 },
 {
  "t0": 42.41,
  "t1": 44.48,
  "text": "那七岁的我躲在屋檐",
  "approx": false
 },
 {
  "t0": 44.48,
  "t1": 46.62,
  "text": "却一直想去荡秋千",
  "approx": false
 },
 {
  "t0": 46.62,
  "t1": 47.99,
  "text": "爷爷抽着烟",
  "approx": false
 },
 {
  "t0": 47.99,
  "t1": 50.13,
  "text": "说唐朝陆羽写茶经三卷",
  "approx": false
 },
 {
  "t0": 50.13,
  "t1": 51.4,
  "text": "流传了千年",
  "approx": false
 },
 {
  "t0": 51.4,
  "t1": 53.46,
  "text": "那天我翻阅字典",
  "approx": false
 },
 {
  "t0": 53.46,
  "t1": 54.86,
  "text": "查什么字眼",
  "approx": false
 },
 {
  "t0": 54.86,
  "t1": 57.03,
  "text": "形容一件事很遥远",
  "approx": false
 },
 {
  "t0": 57.03,
  "t1": 59.97,
  "text": "天边是否在海角对面",
  "approx": false
 },
 {
  "t0": 59.97,
  "t1": 62.47,
  "text": "直到九岁才知道浪费时间",
  "approx": false
 },
 {
  "t0": 62.47,
  "t1": 64.07,
  "text": "这茶桌樟木的横切面",
  "approx": false
 },
 {
  "t0": 64.07,
  "t1": 65.6,
  "text": "年轮有二十三圈",
  "approx": false
 },
 {
  "t0": 65.6,
  "t1": 68.51,
  "text": "镜头的另一边跳接我成熟的脸",
  "approx": false
 },
 {
  "t0": 68.51,
  "t1": 70.8,
  "text": "经过这些年爷爷的手茧",
  "approx": false
 },
 {
  "t0": 70.8,
  "t1": 73.9,
  "text": "泡在水里会有茶色蔓延",
  "approx": false
 },
 {
  "t0": 73.9,
  "t1": 74.99,
  "text": "爷爷泡的茶",
  "approx": false
 },
 {
  "t0": 74.99,
  "t1": 76.72,
  "text": "有一种味道叫做家",
  "approx": false
 },
 {
  "t0": 76.72,
  "t1": 77.82,
  "text": "没法挑剔它",
  "approx": false
 },
 {
  "t0": 77.82,
  "t1": 79.53,
  "text": "口感味觉还不差",
  "approx": false
 },
 {
  "t0": 79.53,
  "t1": 80.66,
  "text": "陆羽泡的茶",
  "approx": false
 },
 {
  "t0": 80.66,
  "t1": 82.1,
  "text": "听说名和利都不拿",
  "approx": false
 },
 {
  "t0": 82.1,
  "t1": 85.17,
  "text": "他牵着一匹瘦马在走天涯",
  "approx": false
 },
 {
  "t0": 85.17,
  "t1": 86.28,
  "text": "爷爷泡的茶",
  "approx": false
 },
 {
  "t0": 86.28,
  "t1": 87.97,
  "text": "有一种味道叫做家",
  "approx": false
 },
 {
  "t0": 87.97,
  "t1": 89.09,
  "text": "他满头白发",
  "approx": false
 },
 {
  "t0": 89.09,
  "t1": 90.82,
  "text": "喝茶时不准说话",
  "approx": false
 },
 {
