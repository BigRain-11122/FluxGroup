 "lines": [
  {
   "t0": 3.72,
   "t1": 5.12,
   "text": "Zither Harp"
  },
  {
   "t0": 31.22,
   "t1": 33.34,
   "text": "Zither Harp"
  },
  {
   "t0": 33.34,
   "t1": 36.18,
   "text": "他變了弩唱又老過來尊重"
  },
  {
   "t0": 36.18,
   "t1": 38.84,
   "text": "他就等待結交的酒泡彈"
  },
  {
   "t0": 38.84,
   "t1": 41.4,
   "text": "眼睛聽著特別離的逐漸"
  },
  {
   "t0": 41.4,
   "t1": 44.16,
   "text": "一把吉他雲煙心上"
  },
  {
   "t0": 44.16,
   "t1": 45.62,
   "text": "不疼"
  },
  {
   "t0": 45.62,
   "t1": 48.22,
   "text": "不疼"
  },
  {
   "t0": 48.22,
   "t1": 50.74,
   "text": "不疼"
  },
  {
   "t0": 50.74,
   "t1": 53.08,
   "text": "生理不如當小天長的結婚"
  },
  {
   "t0": 53.08,
   "t1": 54.64,
   "text": "希望在流海"
  },
  {
   "t0": 54.64,
   "t1": 57.38,
   "text": "大樓可見處的街頭等"
  },
  {
   "t0": 57.38,
   "t1": 59.84,
   "text": "一家煙火繚繞的酒館"
  },
  {
   "t0": 60.28,
   "t1": 62.68,
   "text": "不然的一場時仍在探紙上"
  },
  {
   "t0": 62.68,
   "t1": 64.4,
   "text": "天降在門外進步去"
  },
  {
   "t0": 64.4,
   "t1": 66.86,
   "text": "在苦惱他的同伴還太小"
  },
  {
   "t0": 67.7,
   "t1": 70.4,
   "text": "他真的真的想知道"
  },
  {
   "t0": 70.4,
   "t1": 72.76,
   "text": "那是垃圾動作的評價"
  },
  {
   "t0": 72.76,
   "t1": 75.04,
   "text": "可惜他底下空高"
  },
  {
   "t0": 75.04,
