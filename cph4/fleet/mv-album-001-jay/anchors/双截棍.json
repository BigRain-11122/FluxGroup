 "lines": [
  {
   "t0": 5.02,
   "t1": 6.42,
   "text": "Zither Harp"
  },
  {
   "t0": 11.84,
   "t1": 12.18,
   "text": "Zither Harp"
  },
  {
   "t0": 29.58,
   "t1": 31.52,
   "text": "眼少天的眼問你們隔壁是過"
  },
  {
   "t0": 31.52,
   "t1": 33.9,
   "text": "樹冠店裡面的媽媽散散的友善"
  },
  {
   "t0": 33.9,
   "t1": 36.84,
   "text": "短腳全照顧是老闆列帖殺小耍要加強"
  },
  {
   "t0": 36.84,
   "t1": 39.2,
   "text": "印地是空母最善長歐金銅造地有苦餐"
  },
  {
   "t0": 39.2,
   "t1": 41.48,
   "text": "他們是我習慣從小就有入木欄"
  },
  {
   "t0": 41.48,
   "t1": 44.0,
   "text": "什麼當天用根本我都耍了有我有養"
  },
  {
   "t0": 44.0,
   "t1": 46.36,
   "text": "什麼兵情最喜歡少年貫而柔衝太高"
  },
  {
   "t0": 46.36,
   "t1": 48.64,
   "text": "想要去恨難從少學少女主動舞蹈"
  },
  {
   "t0": 48.64,
   "t1": 49.94,
   "text": "怎麼該怎麼該"
  },
  {
   "t0": 49.94,
   "t1": 51.06,
   "text": "呼吸吐大清自在"
  },
  {
   "t0": 51.06,
   "t1": 52.32,
