[
 {
  "t0": 31.75,
  "t1": 33.42,
  "text": "古巴比伦王颁布了",
  "approx": false
 },
 {
  "t0": 33.42,
  "t1": 35.17,
  "text": "汉摩拉比法典",
  "approx": false
 },
 {
  "t0": 35.17,
  "t1": 37.0,
  "text": "刻在黑色的玄武岩",
  "approx": false
 },
 {
  "t0": 37.0,
  "t1": 39.42,
  "text": "距今已经三千七百多年",
  "approx": false
 },
 {
  "t0": 39.42,
  "t1": 40.79,
  "text": "你在橱窗前",
  "approx": false
 },
 {
  "t0": 40.79,
  "t1": 43.03,
  "text": "凝视碑文的字眼",
  "approx": false
 },
 {
  "t0": 43.03,
  "t1": 44.52,
  "text": "我却在旁静静欣赏",
  "approx": false
 },
 {
  "t0": 44.52,
  "t1": 47.21,
  "text": "你那张我深爱的脸",
  "approx": false
 },
 {
  "t0": 47.21,
  "t1": 49.14,
  "text": "祭司神殿征战",
  "approx": false
 },
 {
  "t0": 49.14,
  "t1": 51.0,
  "text": "弓箭是谁的从前",
  "approx": false
 },
 {
  "t0": 51.0,
  "t1": 52.09,
  "text": "喜欢在人潮中",
  "approx": false
 },
 {
  "t0": 52.09,
  "t1": 54.69,
  "text": "你只属于我的那画面",
  "approx": false
 },
 {
  "t0": 54.69,
  "t1": 56.72,
  "text": "经过苏美女神身边",
  "approx": false
 },
 {
  "t0": 56.72,
  "t1": 58.95,
  "text": "我以女神之名许愿",
  "approx": false
 },
 {
  "t0": 58.95,
  "t1": 62.81,
  "text": "思念像底格里斯河般的漫延",
  "approx": false
 },
 {
  "t0": 62.81,
  "t1": 69.2,
  "text": "当古文明只剩下难解的语言",
  "approx": false
 },
 {
  "t0": 69.2,
  "t1": 77.96,
  "text": "传说就成了永垂不朽的诗篇",
  "approx": false
 },
 {
  "t0": 77.96,
  "t1": 80.51,
  "text": "我给你的爱写在西元前",
  "approx": false
 },
 {
  "t0": 80.51,
  "t1": 85.54,
  "text": "深埋在美索不达米亚平原",
  "approx": false
 },
 {
  "t0": 85.54,
  "t1": 88.05,
  "text": "几十个世纪后出土发现",
  "approx": false
 },
 {
  "t0": 88.05,
  "t1": 93.13,
  "text": "泥板上的字迹依然清晰可见",
  "approx": false
 },
 {
  "t0": 93.13,
  "t1": 95.65,
  "text": "我给你的爱写在西元前",
  "approx": false
 },
 {
  "t0": 95.65,
