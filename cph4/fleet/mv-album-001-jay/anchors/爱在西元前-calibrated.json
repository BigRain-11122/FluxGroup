  "text": "深埋在美索不达米亚平原",
  "approx": false
 },
 {
  "t0": 100.69,
  "t1": 103.34,
  "text": "用楔形文字刻下了永远",
  "approx": false
 },
 {
  "t0": 103.34,
  "t1": 106.76,
  "text": "那已风化千年的誓言",
