   "t1": 176.01,
   "text": "為了我"
  },
  {
   "t0": 176.01,
   "t1": 177.31,
   "text": "好安好安"
  },
  {
   "t0": 177.31,
   "t1": 179.45,
   "text": "鐵盒的鑰匙我找不到"
  },
  {
