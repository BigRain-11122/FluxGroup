 "lines": [
  {
   "t0": 18.14,
   "t1": 26.56,
   "text": "有誰能比我知道 你的溫柔像陰謀"
  },
  {
   "t0": 26.56,
   "t1": 30.62,
   "text": "你明明等在我環保"
  },
  {
   "t0": 30.62,
   "t1": 34.96,
   "text": "只有你能聽得到"
  },
  {
   "t0": 34.96,
   "t1": 38.76,
   "text": "還有沒有人知道"
  },
  {
   "t0": 38.76,
   "t1": 43.1,
   "text": "你都會笑笑擁抱"
  },
  {
   "t0": 43.22,
   "t1": 47.62,
   "text": "那身擦在你眼好"
  },
  {
   "t0": 47.62,
   "t1": 50.94,
   "text": "只有我能得到"
  },
  {
   "t0": 50.94,
   "t1": 57.62,
   "text": "站在屋頂著北方就不想你左右"
  },
  {
   "t0": 57.62,
   "t1": 62.34,
   "text": "本來同一個愛的天空"
  },
  {
   "t0": 62.88,
   "t1": 66.48,
   "text": "最大聽的人說愛我"
  },
  {
   "t0": 66.48,
   "t1": 74.28,
   "text": "坐在電影裡面的偶看人群左右"
  },
  {
   "t0": 75.28,
   "t1": 78.22,
   "text": "對望那一天我們"
  },
  {
   "t0": 79.28,
   "t1": 83.06,
   "text": "多默默的揮笑很久"
  },
  {
   "t0": 84.34,
   "t1": 88.68,
   "text": "我想我是對我原來"
  },
  {
   "t0": 88.84,
   "t1": 92.66,
   "text": "在掛臉過的剛才"
  },
  {
   "t0": 92.88,
   "t1": 97.44,
   "text": "堅持學到真的想法"
  },
  {
   "t0": 97.44,
   "t1": 101.18,
   "text": "緊緊牽手著分愛"
  },
  {
   "t0": 101.18,
   "t1": 105.1,
   "text": "直到我不能再依賴"
  },
  {
   "t0": 105.1,
   "t1": 109.38,
   "text": "和你揮霸我成灰"
  },
  {
   "t0": 109.38,
   "t1": 113.6,
   "text": "你的香味一直排壞"
  },
  {
   "t0": 114.18,
   "t1": 117.5,
   "text": "我深入的離開"
  },
  {
   "t0": 118.98,
   "t1": 126.32,
   "text": "明我指腦 你的溫柔像陰謀"
  },
  {
   "t0": 126.32,
   "t1": 129.84,
   "text": "你明明等在我環保"
  },
  {
