[
 {
  "t0": null,
  "t1": 27.785,
  "text": "只剩下钢琴陪我谈了一天",
  "approx": true
 },
 {
  "t0": null,
  "t1": 27.785,
  "text": "睡着的大提琴",
  "approx": true
 },
 {
  "t0": null,
  "t1": 27.785,
  "text": "安静的旧旧的",
  "approx": true
 },
 {
  "t0": 27.785,
  "t1": 50.758,
  "text": "我想你已表现的非常明白",
  "approx": false
 },
 {
  "t0": 50.758,
  "t1": 55.769,
  "text": "我懂我也知道",
  "approx": true
 },
 {
  "t0": 50.758,
  "t1": 55.769,
  "text": "你没有舍不得",
  "approx": true
 },
 {
  "t0": 50.758,
  "t1": 55.769,
  "text": "你说你也会难过我不相信",
  "approx": true
 },
 {
  "t0": 50.758,
  "t1": 55.769,
  "text": "牵着你陪着我",
  "approx": true
 },
 {
  "t0": 50.758,
  "t1": 55.769,
  "text": "也只是曾经",
  "approx": true
 },
 {
  "t0": 55.769,
  "t1": 75.355,
  "text": "希望他是真的比我还要爱你",
  "approx": false
 },
 {
  "t0": 75.355,
  "t1": 81.913,
  "text": "我才会逼自己离开",
  "approx": true
 },
 {
  "t0": 75.355,
  "t1": 81.913,
  "text": "你要我说多难堪",
  "approx": true
 },
 {
  "t0": 75.355,
  "t1": 81.913,
  "text": "我根本不想分开",
  "approx": true
 },
 {
  "t0": 81.913,
  "t1": 108.129,
  "text": "为什么还要我用微笑来带过",
  "approx": false
 },
 {
  "t0": 108.129,
  "t1": 108.705,
  "text": "我没有这种天分",
  "approx": true
 },
 {
  "t0": 108.129,
  "t1": 108.705,
  "text": "包容你也接受他",
  "approx": true
 },
 {
  "t0": 108.129,
  "t1": 108.705,
  "text": "不用担心的太多",
  "approx": true
 },
 {
  "t0": 108.129,
  "t1": 108.705,
  "text": "我会一直好好过",
  "approx": true
 },
 {
  "t0": 108.129,
  "t1": 108.705,
  "text": "你已经远远离开",
  "approx": true
 },
 {
  "t0": 108.129,
  "t1": 108.705,
  "text": "我也会慢慢走开",
  "approx": true
 },
 {
  "t0": 108.705,
  "t1": 132.379,
  "text": "为什么我连分开都迁就着你",
  "approx": false
 },
 {
  "t0": 132.379,
  "t1": 148.301,
  "text": "我真的没有天分",
  "approx": true
 },
 {
  "t0": 132.379,
  "t1": 148.301,
  "text": "安静的没这么快",
  "approx": true
 },
 {
  "t0": 132.379,
  "t1": 148.301,
  "text": "我会学着放弃你",
  "approx": true
 },
 {
  "t0": 132.379,
  "t1": 148.301,
  "text": "是因为我太爱你",
  "approx": true
 },
