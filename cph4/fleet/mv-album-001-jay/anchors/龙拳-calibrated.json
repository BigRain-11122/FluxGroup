[
 {
  "t0": 49.21,
  "t1": 51.78,
  "text": "以敦煌为圆心的东北东",
  "approx": false
 },
 {
  "t0": 51.78,
  "t1": 54.34,
  "text": "这民族 的海岸线像一支弓",
  "approx": false
 },
 {
  "t0": 54.34,
  "t1": 56.87,
  "text": "那长城 像五千年来待射的梦",
  "approx": false
 },
 {
  "t0": 56.87,
  "t1": 59.49,
  "text": "我用手臂拉开这整个土地的重",
  "approx": false
 },
 {
  "t0": 59.49,
  "t1": 62.67,
  "text": "蒙古高原南下的风写些什么内容",
  "approx": false
 },
 {
  "t0": 62.67,
  "t1": 65.28,
  "text": "汉字到底懂不懂 一样肤色和脸孔",
  "approx": false
 },
 {
  "t0": 65.28,
  "t1": 67.75,
  "text": "跨越黄河 东 登上泰山顶峰",
  "approx": false
 },
 {
  "t0": 67.75,
  "t1": 80.55,
  "text": "我向西 引北风 晒成一身古铜",
  "approx": false
 },
 {
  "t0": 80.55,
  "t1": 85.15,
  "text": "渴望着血脉相通 无限个千万弟兄",
  "approx": false
 },
 {
  "t0": 85.15,
  "t1": 88.34,
  "text": "我把天地拆封将长江水掏空",
  "approx": false
 },
 {
  "t0": 88.34,
  "t1": 90.99,
  "text": "人在古老河床蜕变中",
  "approx": false
 },
 {
  "t0": 90.99,
  "t1": 93.5,
  "text": "我 右拳打开了天 化身为龙",
  "approx": false
 },
 {
  "t0": 93.5,
  "t1": 96.08,
  "text": "把 山河重新移动 填平裂缝",
  "approx": false
 },
 {
  "t0": 96.08,
  "t1": 98.67,
  "text": "将 东方 的日出调整了时空",
  "approx": false
 },
 {
  "t0": 98.67,
  "t1": 101.24,
  "text": "回到洪荒 去支配 去操纵",
  "approx": false
 },
 {
  "t0": 101.24,
  "t1": 103.82,
  "text": "我 右拳打开了天 化身为龙",
  "approx": false
 },
 {
  "t0": 103.82,
  "t1": 106.41,
  "text": "那 大地心脏汹涌 不安跳动",
  "approx": false
 },
 {
  "t0": 106.41,
  "t1": 108.94,
  "text": "全 世界 的表情只剩下一种",
  "approx": false
 },
 {
  "t0": 108.94,
  "t1": 111.55,
  "text": "等待英雄 我就是那条龙",
  "approx": false
 },
