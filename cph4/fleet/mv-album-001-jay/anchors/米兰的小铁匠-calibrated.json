[
 {
  "t0": 33.77,
  "t1": 36.36,
  "text": "跑遍了牧场又绕过了村庄",
  "approx": false
 },
 {
  "t0": 36.36,
  "t1": 38.98,
  "text": "他就站在街角的旧报摊",
  "approx": false
 },
 {
  "t0": 38.98,
  "t1": 41.52,
  "text": "眼睛盯着隔壁里的橱窗",
  "approx": false
 },
 {
  "t0": 41.52,
  "t1": 44.79,
  "text": "一把吉他远远欣赏",
  "approx": false
 },
 {
  "t0": 44.79,
  "t1": 47.33,
  "text": "木炭一箩筐",
  "approx": false
 },
 {
  "t0": 47.33,
  "t1": 49.89,
  "text": "木炭一直放",
  "approx": false
 },
 {
  "t0": 49.89,
  "t1": 51.74,
  "text": "木炭剩一半",
  "approx": false
 },
 {
  "t0": 51.74,
  "t1": 55.52,
  "text": "火炉烫 小铁匠存钱买希望 在流汗",
  "approx": false
 },
 {
  "t0": 55.52,
  "t1": 58.09,
  "text": "巴洛克建筑的街道旁",
  "approx": false
 },
 {
  "t0": 58.09,
  "t1": 60.39,
  "text": "一家烟雾缭绕的酒馆",
  "approx": false
 },
 {
  "t0": 60.39,
  "t1": 62.61,
  "text": "波兰的吟唱诗人在弹唱",
  "approx": false
 },
 {
  "t0": 62.61,
  "t1": 65.23,
  "text": "小铁匠在门外进不去在苦恼",
  "approx": false
 },
 {
  "t0": 65.23,
  "t1": 68.36,
  "text": "他的铜板还太少",
  "approx": false
 },
 {
  "t0": 68.36,
  "t1": 70.69,
  "text": "他真的真的想知道",
  "approx": false
 },
 {
  "t0": 70.69,
  "t1": 73.43,
  "text": "那首来自东欧的民谣和弦",
  "approx": false
 },
 {
  "t0": 73.43,
  "t1": 74.41,
  "text": "到底什么调",
  "approx": false
 },
 {
  "t0": 74.41,
  "t1": 75.84,
  "text": "米兰的天空刚破晓",
  "approx": false
 },
 {
  "t0": 75.84,
  "t1": 78.0,
  "text": "那马蹄铁还要敲多少",
  "approx": false
 },
 {
  "t0": 78.0,
  "t1": 79.4,
  "text": "吉他才能买得到",
  "approx": false
 },
 {
  "t0": 79.4,
  "t1": 80.73,
  "text": "他真的真的想知道",
  "approx": false
 },
 {
  "t0": 80.73,
  "t1": 84.49,
  "text": "他不知道怎么办才好睡不着",
  "approx": false
 },
 {
  "t0": 84.49,
  "t1": 85.97,
  "text": "他将那扑满打破了",
  "approx": false
 },
 {
  "t0": 85.97,
  "t1": 100.92,
  "text": "小小愿望就快实现了他在笑",
  "approx": false
 },
