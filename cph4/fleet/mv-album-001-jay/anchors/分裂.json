 "lines": [
  {
   "t0": 2.64,
   "t1": 4.04,
   "text": "Zither Harp"
  },
  {
   "t0": 31.8,
   "t1": 35.58,
   "text": "坐着我的摩托着"
  },
  {
   "t0": 35.58,
   "t1": 39.9,
   "text": "在你环关的离开"
  },
  {
   "t0": 39.9,
   "t1": 44.02,
   "text": "靠不上的好学校"
  },
  {
   "t0": 44.02,
   "t1": 47.6,
   "text": "可以不会笑着走"
  },
  {
   "t0": 47.6,
   "t1": 51.12,
   "text": "把手慢慢交给我"
  },
  {
   "t0": 51.86,
   "t1": 55.22,
   "text": "放下心中的滚过"
  },
  {
   "t0": 56.0,
   "t1": 59.02,
   "text": "一点重量绑滑过"
  },
  {
   "t0": 59.02,
   "t1": 63.04,
   "text": "隔开两种精神的我"
  },
  {
   "t0": 63.04,
   "t1": 65.9,
   "text": "经过老婆的家"
  },
  {
   "t0": 65.9,
   "t1": 69.32,
   "text": "和狂变的好高"
  },
  {
   "t0": 69.32,
   "t1": 71.84,
   "text": "爬过的那个树"
  },
  {
   "t0": 71.84,
   "t1": 76.1,
   "text": "又何时变得渺小"
  },
  {
   "t0": 78.86,
   "t1": 80.98,
   "text": "这样也好"
  },
  {
   "t0": 80.98,
   "t1": 84.7,
   "text": "开始没人注意的我"
  },
  {
   "t0": 84.7,
   "t1": 87.36,
   "text": "等于变成之前"
  },
  {
   "t0": 87.36,
   "t1": 90.48,
   "text": "我们将会分化软绒"
  },
  {
   "t0": 93.88,
   "t1": 97.3,
   "text": "这时间没发觉"
  },
  {
   "t0": 97.3,
   "t1": 100.34,
   "text": "让我带着你离开"
  },
  {
   "t0": 101.3,
   "t1": 102.92,
   "text": "没有了证明"
  },
  {
   "t0": 102.92,
   "t1": 105.02,
   "text": "没有了空虚"
  },
  {
   "t0": 105.02,
   "t1": 107.32,
   "text": "今日两种离疼"
  },
  {
   "t0": 107.32,
   "t1": 109.66,
   "text": "我会照着你"
  },
  {
   "t0": 109.98,
   "t1": 112.94,
   "text": "这时间没发觉"
  },
  {
   "t0": 112.94,
   "t1": 116.0,
   "text": "让我带着你离开"
  },
  {
   "t0": 116.0,
   "t1": 118.54,
   "text": "这不是完工"
  },
  {
   "t0": 118.54,
