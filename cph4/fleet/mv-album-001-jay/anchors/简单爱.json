 "lines": [
  {
   "t0": 4.14,
   "t1": 5.54,
   "text": "Zither Harp"
  },
  {
   "t0": 10.5,
   "t1": 11.3,
   "text": "Zither Harp"
  },
  {
   "t0": 26.12,
   "t1": 31.12,
   "text": "說不上為什麼 我變得很主動"
  },
  {
   "t0": 31.12,
   "t1": 36.08,
   "text": "若愛上一個人 什麼都會值得去做"
  },
  {
   "t0": 36.08,
   "t1": 40.98,
   "text": "我想大聲宣布 對你意義不捨"
  },
  {
   "t0": 40.98,
   "t1": 46.1,
   "text": "連個比臉舉頭 踩到我現在的感受"
  },
  {
   "t0": 46.1,
   "t1": 50.5,
   "text": "和變得風 再吹著頭髮"
  },
  {
   "t0": 50.5,
   "t1": 56.18,
   "text": "飄渡 牽著你的手 依著茂名感動"
  },
  {
   "t0": 56.18,
   "t1": 60.56,
   "text": "我想帶你回我的外婆家一起"
  },
  {
   "t0": 60.56,
   "t1": 65.68,
   "text": "看著日落 一直到我們都睡著"
  },
  {
   "t0": 65.68,
   "t1": 70.84,
   "text": "我想就這樣牽著你的手不放開"
  },
  {
   "t0": 70.84,
   "t1": 75.6,
   "text": "愛能不能夠永遠單純沒有悲哀"
  },
  {
   "t0": 75.6,
   "t1": 80.88,
   "text": "我想帶你一起擔著我 想和你看當球"
  },
  {
   "t0": 80.88,
   "t1": 85.68,
   "text": "想這樣被擔憂 藏著可以直動"
  },
  {
   "t0": 85.68,
   "t1": 90.72,
   "text": "我想就這樣牽著你的手不放開"
  },
  {
   "t0": 90.72,
   "t1": 95.54,
   "text": "愛可不可以 簡單的沒有傷害"
  },
  {
   "t0": 95.54,
   "t1": 100.66,
   "text": "你靠著我的肩膀 你在我胸口睡著"
  },
  {
   "t0": 100.66,
   "t1": 105.42,
   "text": "像這樣的生活 我愛你 你愛我"
  },
