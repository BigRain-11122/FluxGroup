 {
  "t0": 14.72,
  "t1": 20.37,
  "text": "难过是因为闷了很久",
  "approx": false
 },
 {
  "t0": 20.52,
  "t1": 24.04,
  "text": "是因为想了太多",
  "approx": false
 },
 {
  "t0": 24.04,
  "t1": 29.08,
  "text": "是心里起了作用",
  "approx": false
 },
 {
  "t0": 30.44,
  "t1": 35.28,
  "text": "你说苦笑常常陪着你",
  "approx": false
 },
 {
  "t0": 35.58,
  "t1": 38.92,
  "text": "在一起有点勉强",
  "approx": false
 },
 {
  "t0": 38.92,
  "t1": 43.62,
  "text": "该不该现在休了我",
  "approx": false
 },
 {
  "t0": 43.62,
  "t1": 46.78,
  "text": "不想太多",
  "approx": false
 },
 {
  "t0": 46.78,
  "t1": 49.46,
  "text": "我想一定是我",
  "approx": false
 },
 {
  "t0": 49.46,
  "t1": 54.52,
  "text": "听错弄错搞错",
