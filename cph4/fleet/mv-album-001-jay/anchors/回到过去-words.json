 "lines": [
  {
   "t0": 6.9,
   "t1": 12.46,
   "text": "一盞黃黃悄悄的燈"
  },
  {
   "t0": 13.0,
   "t1": 17.5,
   "text": "時間在旁邊不可剪"
  },
  {
   "t0": 17.5,
   "t1": 23.38,
   "text": "寂寞下手高無反折"
  },
  {
   "t0": 24.0,
   "t1": 27.98,
   "text": "不懂得情眾之分"
  },
  {
   "t0": 28.98,
   "t1": 34.64,
   "text": "沉默之稱要活陌生"
  },
  {
   "t0": 34.64,
   "t1": 40.06,
   "text": "叮叮看著凝成黃黃"
  },
  {
   "t0": 40.98,
   "t1": 49.02,
   "text": "你的水影失去平衡慢慢下沉"
  },
  {
   "t0": 51.08,
   "t1": 57.06,
   "text": "黑暗已在空中發生愛忘了"
  },
  {
   "t0": 57.06,
   "t1": 59.8,
   "text": "我看不見"
  },
  {
   "t0": 61.04,
   "t1": 65.62,
   "text": "也是愛在夢的裡頭"
  },
  {
   "t0": 65.62,
   "t1": 71.06,
   "text": "無法穿過在真實的空間"
  },
  {
   "t0": 71.88,
   "t1": 73.82,
   "text": "想回到過去"
  },
  {
   "t0": 75.06,
   "t1": 78.3,
   "text": "只得到你在懷裡"
  },
  {
   "t0": 78.6,
   "t1": 82.28,
   "text": "手卻的臉蛋又一點沉寂"
  },
  {
   "t0": 83.84,
   "t1": 86.28,
   "text": "想看你的世界"
  },
  {
   "t0": 86.28,
   "t1": 89.6,
   "text": "藏在你夢的畫面"
  },
  {
   "t0": 89.6,
   "t1": 93.7,
   "text": "只要靠在一起就能感覺見你"
  },
  {
   "t0": 94.28,
   "t1": 96.34,
   "text": "想回到過去"
  },
  {
   "t0": 97.5,
   "t1": 100.44,
   "text": "時間讓不知繼續"
  },
  {
   "t0": 100.44,
   "t1": 104.96,
   "text": "至少不再讓你離我去"
  },
  {
   "t0": 106.1,
   "t1": 109.4,
   "text": "分散時間的處理"
  },
  {
   "t0": 109.4,
   "t1": 111.94,
   "text": "這次回報的更近"
  },
  {
   "t0": 111.94,
   "t1": 116.18,
   "text": "這樣玩留不止還來不來的情"
  },
  {
   "t0": 116.92,
   "t1": 119.16,
   "text": "怎麼回到過去"
  },
  {
   "t0": 124.6,
   "t1": 128.96,
   "text": "此情不難阻擋就回憶播放"
  },
  {
