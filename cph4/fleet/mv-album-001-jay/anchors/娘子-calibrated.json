  "text": "配上几斤的牛肉",
  "approx": false
 },
 {
  "t0": 32.59,
  "t1": 36.16,
  "text": "我说店小二 三两银够不够",
  "approx": false
 },
 {
  "t0": 36.16,
  "t1": 38.17,
  "text": "景色入秋 漫天黄沙掠过",
