  "t1": 16.3,
  "text": "娘子娘子却依旧每日",
  "approx": false
 },
 {
  "t0": 16.3,
  "t1": 18.3,
  "text": "折一枝杨柳你在那里",
  "approx": false
 },
 {
  "t0": 18.3,
  "t1": 21.64,
  "text": "在小村外的溪边河口默默等着我",
  "approx": false
 },
 {
  "t0": 21.64,
  "t1": 24.58,
  "text": "娘子依旧每日折一枝杨柳",
  "approx": false
 },
 {
  "t0": 24.58,
  "t1": 27.01,
  "text": "你在那里在小村外的溪边",
  "approx": false
 },
 {
  "t0": 27.01,
  "t1": 29.15,
  "text": "默默等着 娘子",
  "approx": false
 },
 {
  "t0": 29.15,
  "t1": 31.15,
  "text": "一壶好酒 再来一碗热粥",
  "approx": false
 },
 {
  "t0": 31.15,
