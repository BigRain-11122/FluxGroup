 },
 {
  "t0": 318.18,
  "t1": 320.06,
  "text": "（孤独的光辉 才懂的感觉）",
  "approx": false
 },
 {
  "t0": 320.06,
  "t1": 321.12,
  "text": "天空是濛濛的雾",
  "approx": false
 },
 {
  "t0": 321.12,
  "t1": 322.91,
  "text": "（烛光 不不停的摇晃）",
  "approx": false
 },
 {
  "t0": 322.91,
  "t1": 325.2,
  "text": "猫头鹰在窗棂上 对着远方眺望",
  "approx": false
 },
 {
  "t0": 325.2,
  "t1": 326.45,
  "text": "父亲牵着我的双手",
  "approx": false
 },
 {
  "t0": 326.45,
  "t1": 328.23,
  "text": "（通向大厅的长廊）",
  "approx": false
 },
 {
  "t0": 328.23,
  "t1": 329.3,
  "text": "轻轻走过 清晨那",
  "approx": false
 },
 {
  "t0": 329.3,
  "t1": 330.98,
  "text": "（一样说不出的沧桑）",
  "approx": false
 },
 {
  "t0": 330.98,
  "t1": 331.94,
  "text": "安安静静的石板路",
  "approx": false
 },
 {
  "t0": 331.94,
  "t1": 333.5,
  "text": "（没有喧嚣 只有宁静围绕）",
  "approx": false
 },
 {
  "t0": 333.5,
  "t1": 334.94,
  "text": "我 慢慢睡着",
  "approx": false
 },
 {
  "t0": 334.94,
  "t1": 337.94,
  "text": "天 刚刚破晓",
  "approx": false
 }
