[
 {
  "t0": 2.39,
  "t1": 15.34,
  "text": "Ave Maria grazia ricevuta per la mia famiglia",
  "approx": false
 },
 {
  "t0": 15.34,
  "t1": 30.29,
  "text": "Con risentito con un'amorevole divino amen",
  "approx": false
 },
 {
  "t0": 30.29,
  "t1": 34.74,
  "text": "Grazie chiedo a te o signore divino",
  "approx": false
 },
 {
  "t0": 34.74,
  "t1": 38.66,
  "text": "In questo giorno di grazia prego per te",
  "approx": false
 },
 {
  "t0": 38.66,
  "t1": 40.87,
  "text": "Ave Maria piena di grazia",
  "approx": false
 },
 {
  "t0": 40.87,
  "t1": 42.58,
  "text": "Il signore e con te",
  "approx": false
 },
 {
  "t0": 42.58,
  "t1": 44.22,
  "text": "Sia fatta la tua volonta",
  "approx": false
 },
 {
  "t0": 44.22,
  "t1": 47.09,
  "text": "Così in cielo e così in terra neil nome",
  "approx": false
 },
 {
  "t0": 47.09,
  "t1": 87.14,
  "text": "Del padre del figliolo e dello spirito santo amen",
  "approx": false
 },
 {
  "t0": 87.14,
  "t1": 89.85,
  "text": "微凉的晨露沾湿黑礼服",
  "approx": false
 },
 {
  "t0": 89.85,
  "t1": 92.65,
  "text": "石板路有雾父在低诉",
  "approx": false
 },
 {
  "t0": 92.65,
  "t1": 95.5,
  "text": "无奈的觉悟只能更残酷",
  "approx": false
 },
 {
  "t0": 95.5,
  "t1": 98.18,
  "text": "一切都为了通往圣堂的路",
  "approx": false
 },
 {
  "t0": 98.18,
  "t1": 100.78,
  "text": "吹不散的雾隐没了意图",
  "approx": false
 },
 {
  "t0": 100.78,
  "t1": 103.21,
  "text": "谁轻柔踱步停住",
  "approx": false
 },
 {
  "t0": 103.21,
  "t1": 108.77,
  "text": "还来不及哭穿过的子弹就带走温度",
  "approx": false
 },
 {
  "t0": 108.77,
  "t1": 110.26,
  "text": "我们每个人都有罪",
  "approx": false
 },
 {
  "t0": 110.26,
  "t1": 111.65,
  "text": "犯着不同的罪",
  "approx": false
 },
 {
  "t0": 111.65,
  "t1": 113.03,
  "text": "我能决定谁对",
  "approx": false
 },
 {
  "t0": 113.03,
  "t1": 114.45,
  "text": "谁又该要沉睡",
  "approx": false
 },
 {
  "t0": 114.45,
  "t1": 115.87,
  "text": "争论不能解决",
  "approx": false
 },
 {
  "t0": 115.87,
  "t1": 117.26,
  "text": "在永无止境的夜",
  "approx": false
 },
 {
  "t0": 117.26,
  "t1": 118.55,
  "text": "关掉你的嘴",
  "approx": false
 },
 {
  "t0": 118.55,
  "t1": 119.6,
  "text": "唯一的恩惠",
  "approx": false
 },
 {
  "t0": 119.6,
  "t1": 121.21,
  "text": "挡在前面的人都有罪",
  "approx": false
 },
 {
  "t0": 121.21,
  "t1": 122.68,
  "text": "后悔也无路可退",
  "approx": false
 },
 {
  "t0": 122.68,
  "t1": 123.95,
  "text": "以父之名判决",
  "approx": false
 },
 {
  "t0": 123.95,
  "t1": 125.71,
  "text": "那感觉没有适合字汇",
  "approx": false
 },
 {
  "t0": 125.71,
  "t1": 127.09,
  "text": "就像边笑边掉泪",
  "approx": false
 },
 {
  "t0": 127.09,
  "t1": 128.42,
  "text": "凝视着完全的黑",
  "approx": false
 },
 {
  "t0": 128.42,
  "t1": 130.9,
  "text": "阻挡悲剧蔓延的悲剧会让我沉醉",
  "approx": false
 },
 {
  "t0": 130.9,
  "t1": 132.23,
  "text": "低头亲吻我的左手",
  "approx": false
 },
 {
  "t0": 132.23,
  "t1": 133.63,
  "text": "换取被宽恕的承诺",
  "approx": false
 },
 {
  "t0": 133.63,
  "t1": 135.05,
  "text": "老旧管风琴在角落",
  "approx": false
 },
 {
  "t0": 135.05,
  "t1": 136.38,
  "text": "一直一直一直伴奏",
  "approx": false
 },
 {
  "t0": 136.38,
  "t1": 137.73,
  "text": "黑色帘幕被风吹动",
  "approx": false
 },
 {
  "t0": 137.73,
  "t1": 139.1,
  "text": "阳光无言地穿透",
  "approx": false
 },
 {
  "t0": 139.1,
  "t1": 141.78,
  "text": "洒向那群被我驯服后的兽",
  "approx": false
 },
 {
  "t0": 141.78,
  "t1": 143.3,
  "text": "沉默地喊叫沉默地喊叫",
  "approx": false
 },
 {
  "t0": 143.3,
  "t1": 144.58,
  "text": "孤单开始发酵",
  "approx": false
 },
 {
  "t0": 144.58,
  "t1": 145.91,
  "text": "不停对着我嘲笑",
  "approx": false
 },
 {
  "t0": 145.91,
  "t1": 147.36,
  "text": "回忆逐渐延烧",
  "approx": false
 },
 {
  "t0": 147.36,
  "t1": 148.68,
  "text": "曾经纯真的画面",
  "approx": false
 },
 {
  "t0": 148.68,
  "t1": 150.08,
  "text": "残忍地温柔出现",
  "approx": false
 },
 {
  "t0": 150.08,
  "t1": 151.31,
  "text": "脆弱时间到",
  "approx": false
 },
 {
  "t0": 151.31,
  "t1": 152.81,
  "text": "我们一起来祷告",
  "approx": false
 },
 {
  "t0": 152.81,
  "t1": 156.05,
  "text": "仁慈的父我已坠入",
  "approx": false
 },
 {
  "t0": 156.05,
  "t1": 158.61,
  "text": "看不见罪的国度",
  "approx": false
 },
 {
  "t0": 158.61,
  "t1": 161.35,
  "text": "请原谅我的自负",
  "approx": false
 },
 {
  "t0": 161.35,
  "t1": 164.02,
  "text": "Ah ya ya check it check it ah ya",
  "approx": false
 },
 {
  "t0": 164.02,
  "t1": 166.86,
  "text": "没人能说没人可说",
  "approx": false
 },
 {
  "t0": 166.86,
  "t1": 168.35,
  "text": "好难承受",
  "approx": false
 },
 {
  "t0": 168.35,
  "t1": 172.26,
  "text": "荣耀的背后刻着一道孤独",
  "approx": false
 },
 {
  "t0": 172.26,
  "t1": 174.86,
  "text": "Ah ya ya check it check it ah ya",
  "approx": false
 },
 {
  "t0": 174.86,
  "t1": 177.78,
  "text": "闭上双眼我又看见",
  "approx": false
 },
 {
  "t0": 177.78,
  "t1": 180.48,
  "text": "当年那梦的画面",
  "approx": false
 },
 {
  "t0": 180.48,
  "t1": 183.29,
  "text": "天空是濛濛的雾",
  "approx": false
 },
 {
  "t0": 183.29,
  "t1": 185.79,
  "text": "Ah ya ya check it check it ah ya",
  "approx": false
 },
 {
  "t0": 185.79,
  "t1": 188.9,
  "text": "父亲牵着我的双手",
  "approx": false
 },
 {
  "t0": 188.9,
  "t1": 190.3,
  "text": "轻轻走过",
  "approx": false
 },
 {
  "t0": 190.3,
  "t1": 194.18,
  "text": "清晨那安安静静的石板路",
  "approx": false
 },
 {
  "t0": 194.18,
  "t1": 203.25,
  "text": "Ah ya ya check it check it ah ya",
  "approx": false
 },
 {
  "t0": 203.25,
  "t1": 208.43,
  "text": "Pie Jesu",
  "approx": false
 },
 {
  "t0": 208.43,
  "t1": 213.62,
  "text": "Qui tollis peccata",
  "approx": false
 },
 {
  "t0": 213.62,
  "t1": 226.37,
  "text": "Dona eis requiem",
  "approx": false
