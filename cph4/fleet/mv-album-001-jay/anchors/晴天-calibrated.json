[
 {
  "t0": 28.95,
  "t1": 32.38,
  "text": "故事的小黄花",
  "approx": false
 },
 {
  "t0": 32.38,
  "t1": 35.87,
  "text": "从出生那年就飘着",
  "approx": false
 },
 {
  "t0": 35.87,
  "t1": 39.37,
  "text": "童年的荡秋千",
  "approx": false
 },
 {
  "t0": 39.37,
  "t1": 42.44,
  "text": "随记忆一直晃到现在",
  "approx": false
 },
 {
  "t0": 42.44,
  "t1": 45.53,
  "text": "Re So So Si Do Si La",
  "approx": false
 },
 {
  "t0": 45.53,
  "t1": 49.57,
  "text": "So La Si Si Si Si La Si La So",
  "approx": false
 },
 {
  "t0": 49.57,
  "t1": 52.87,
  "text": "吹着前奏望着天空",
  "approx": false
 },
 {
  "t0": 52.87,
  "t1": 56.41,
  "text": "我想起花瓣试着掉落",
  "approx": false
 },
 {
  "t0": 56.41,
  "t1": 58.55,
  "text": "为你翘课的那一天",
  "approx": false
 },
 {
  "t0": 58.55,
  "t1": 60.19,
  "text": "花落的那一天",
  "approx": false
 },
 {
  "t0": 60.19,
  "t1": 61.99,
  "text": "教室的那一间",
  "approx": false
 },
 {
  "t0": 61.99,
  "t1": 63.88,
  "text": "我怎么看不见",
  "approx": false
 },
 {
  "t0": 63.88,
  "t1": 65.41,
  "text": "消失的下雨天",
  "approx": false
 },
 {
  "t0": 65.41,
  "t1": 69.75,
  "text": "我好想再淋一遍",
  "approx": false
 },
 {
  "t0": 69.75,
  "t1": 75.53,
  "text": "没想到失去的勇气我还留着",
  "approx": false
 },
 {
  "t0": 75.53,
  "t1": 77.52,
  "text": "好想再问一遍",
  "approx": false
 },
 {
  "t0": 77.52,
  "t1": 84.5,
  "text": "你会等待还是离开",
  "approx": false
 },
 {
  "t0": 84.5,
  "t1": 90.08,
  "text": "刮风这天我试过握着你手",
  "approx": false
 },
 {
  "t0": 90.08,
  "t1": 98.45,
  "text": "但偏偏雨渐渐大到我看你不见",
  "approx": false
 },
 {
  "t0": 98.45,
  "t1": 104.87,
  "text": "还要多久我才能在你身边",
  "approx": false
 },
 {
  "t0": 104.87,
  "t1": 112.33,
  "text": "等到放晴的那天也许我会比较好一点",
  "approx": false
 },
 {
  "t0": 112.33,
  "t1": 117.96,
  "text": "从前从前有个人爱你很久",
  "approx": false
 },
 {
  "t0": 117.96,
  "t1": 126.24,
  "text": "但偏偏风渐渐把距离吹得好远",
  "approx": false
 },
 {
  "t0": 126.24,
  "t1": 132.91,
  "text": "好不容易又能再多爱一天",
  "approx": false
 },
 {
  "t0": 132.91,
  "t1": 154.66,
  "text": "但故事的最后你好像还是说了拜拜",
