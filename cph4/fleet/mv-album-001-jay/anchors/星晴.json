 "lines": [
  {
   "t0": 30.0,
   "t1": 31.44,
   "text": "沉深開心"
  },
  {
   "t0": 33.16,
   "t1": 37.74,
   "text": "趁著風又擋在藍天邊"
  },
  {
   "t0": 38.52,
   "t1": 43.22,
   "text": "一片雲掉落在我面前"
  },
  {
   "t0": 43.86,
   "t1": 46.5,
   "text": "捏成你的形狀"
  },
  {
   "t0": 46.5,
   "t1": 51.8,
   "text": "水縫跟著我一口一口吃掉有醜"
  },
  {
   "t0": 54.28,
   "t1": 59.68,
   "text": "在著你彷彿在這陽光"
  },
  {
   "t0": 59.68,
   "t1": 64.62,
   "text": "不管到哪裡都是晴天"
  },
  {
   "t0": 64.62,
   "t1": 70.08,
   "text": "蝴蝶子太飛了 花也不滿天"
  },
  {
   "t0": 70.08,
   "t1": 73.42,
   "text": "一朵一朵因你而笑"
  },
  {
   "t0": 73.42,
   "t1": 78.82,
   "text": "是多讓夕陽飛上"
  },
  {
   "t0": 78.82,
   "t1": 86.82,
   "text": "大雨淋你我煥老大自然"
  },
  {
   "t0": 87.82,
   "t1": 95.58,
   "text": "因著風還是公共每一天"
  },
  {
   "t0": 95.58,
   "t1": 101.36,
   "text": "手牽手應不涼不散不失不忘著天"
  },
  {
   "t0": 101.36,
   "t1": 106.64,
   "text": "看星星一顆兩顆三顆四顆連成線"
  },
  {
   "t0": 106.64,
   "t1": 110.94,
   "text": "美的美 默默寫下寫美"
  },
  {
   "t0": 111.84,
   "t1": 116.74,
   "text": "看遠方的星 是否聽得見"
  },
  {
   "t0": 117.6,
   "t1": 122.98,
   "text": "手牽手應不涼不散不失不忘著天"
  },
  {
   "t0": 122.98,
   "t1": 128.2,
   "text": "看星星一顆兩顆三顆四顆連成線"
  },
  {
   "t0": 128.2,
   "t1": 132.82,
   "text": "美的美 默默寫下寫美"
  },
  {
   "t0": 133.31,
   "t1": 138.0,
   "text": "看遠方的星 如果聽得見"
  },
  {
   "t0": 138.63,
   "t1": 140.76,
   "text": "它一定是線"
