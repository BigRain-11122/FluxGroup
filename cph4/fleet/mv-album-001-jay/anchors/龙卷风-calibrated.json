[
 {
  "t0": 29.98,
  "t1": 37.0,
  "text": "爱像一阵风吹完它就走",
  "approx": false
 },
 {
  "t0": 37.22,
  "t1": 40.4,
  "text": "这样的节奏谁都无可奈何",
  "approx": false
 },
 {
  "t0": 40.94,
  "t1": 46.98,
  "text": "没有你以后我灵魂失控",
  "approx": false
 },
 {
  "t0": 46.98,
  "t1": 53.1,
  "text": "黑云在降落我被它拖着走",
  "approx": false
 },
 {
  "t0": 53.1,
  "t1": 60.74,
  "text": "静静悄悄默默离开",
  "approx": true
 },
 {
  "t0": 53.1,
  "t1": 60.74,
  "text": "陷入了危险边缘Baby",
  "approx": true
 },
 {
  "t0": 60.74,
  "t1": 65.26,
  "text": "我的世界已狂风暴雨wu",
  "approx": false
 },
 {
  "t0": 66.96,
  "t1": 70.56,
  "text": "爱情来的太快就像龙卷风",
  "approx": false
 },
 {
  "t0": 70.56,
  "t1": 73.48,
  "text": "离不开暴风圈来不及逃",
  "approx": false
 },
 {
  "t0": 73.48,
  "t1": 76.94,
  "text": "我不能再想我不能再想",
  "approx": false
 },
 {
  "t0": 76.94,
  "t1": 79.18,
  "text": "我不我不我不能",
  "approx": false
 },
 {
  "t0": 80.22,
  "t1": 83.9,
  "text": "爱情走的太快就像龙卷风",
  "approx": false
 },
 {
  "t0": 83.9,
  "t1": 86.84,
  "text": "不能承受我已无处可躲",
  "approx": false
 },
 {
  "t0": 86.84,
  "t1": 90.26,
  "text": "我不要再想我不要再想",
  "approx": false
 },
 {
  "t0": 90.26,
  "t1": 93.7,
  "text": "我不我不我不要再想你",
  "approx": false
 },
 {
  "t0": 93.7,
  "t1": 97.28,
  "text": "不知不觉你已经离开我",
  "approx": false
 },
 {
  "t0": 97.28,
  "t1": 100.7,
  "text": "不知不觉我跟了这节奏",
  "approx": false
 },
 {
  "t0": 100.7,
  "t1": 103.86,
  "text": "后知后觉又过了一个秋",
  "approx": false
 },
 {
