  },
  {
   "t0": 173.74,
   "t1": 175.7,
   "text": "快攻城篮板球"
  },
  {
   "t0": 175.7,
   "t1": 177.62,
   "text": "得分都靠我"
  },
  {
   "t0": 177.62,
   "t1": 179.5,
   "text": "拿了九户头"
  },
  {
   "t0": 179.5,
   "t1": 181.42,
   "text": "又不会隐瞞我"
  },
  {
   "t0": 181.42,
   "t1": 184.56,
   "text": "生意者中的有假可乐"
  },
  {
   "t0": 185.5,
   "t1": 187.46,
   "text": "说你说分寸怎么停留"
  },
  {
   "t0": 187.46,
   "t1": 188.42,
   "text": "一直在停留"
  },
  {
   "t0": 188.42,
   "t1": 189.6,
   "text": "谁能在停留的"
  },
  {
   "t0": 189.6,
   "t1": 191.48,
   "text": "为什么我女朋友常常见我"
  },
  {
   "t0": 191.48,
