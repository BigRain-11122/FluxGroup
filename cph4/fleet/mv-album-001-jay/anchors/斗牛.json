  },
  {
   "t0": 155.96,
   "t1": 159.1,
   "text": "三分钟大才跟踪腾溜"
  },
  {
   "t0": 159.1,
   "t1": 161.02,
   "text": "说有人看着我"
  },
  {
   "t0": 161.02,
   "t1": 162.72,
   "text": "怕无情尽求"
  },
  {
   "t0": 162.72,
   "t1": 164.66,
   "text": "跟着无人求"
  },
  {
   "t0": 164.66,
   "t1": 166.5,
   "text": "按下那穿出手"
  },
  {
   "t0": 166.5,
   "t1": 168.38,
   "text": "漂亮的假动作"
  },
  {
   "t0": 168.38,
   "t1": 169.88,
   "text": "转移来了我"
  },
  {
   "t0": 169.88,
   "t1": 172.02,
   "text": "却唱平人放手"
  },
  {
   "t0": 172.02,
