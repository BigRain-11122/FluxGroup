 "lines": [
  {
   "t0": 9.56,
   "t1": 10.82,
   "text": "要不要跳一下"
  },
  {
   "t0": 10.82,
   "t1": 11.54,
   "text": "啊"
  },
  {
   "t0": 11.54,
   "t1": 12.7,
   "text": "跳一下"
  },
  {
   "t0": 12.7,
   "t1": 14.44,
   "text": "随便啊"
  },
  {
   "t0": 43.98,
   "t1": 44.62,
   "text": "有话就接受"
  },
  {
   "t0": 44.62,
   "t1": 46.5,
   "text": "马上三分钟"
  },
  {
   "t0": 46.5,
   "t1": 48.36,
   "text": "他在空中的流"
  },
  {
   "t0": 48.36,
   "t1": 50.24,
   "text": "所有人看着我"
  },
  {
   "t0": 50.24,
   "t1": 51.88,
   "text": "跑无限尽就"
  },
  {
   "t0": 51.88,
   "t1": 53.9,
   "text": "担守过人运球"
  },
  {
   "t0": 53.9,
   "t1": 55.68,
   "text": "按下秒传出咒"
  },
  {
   "t0": 55.68,
   "t1": 57.62,
   "text": "漂亮的假动作"
  },
  {
   "t0": 57.62,
   "t1": 58.58,
   "text": "帅大了"
  },
  {
   "t0": 58.58,
   "t1": 61.3,
   "text": "全场停了放手"
  },
  {
   "t0": 61.3,
   "t1": 63.16,
   "text": "拦下进去游走"
  },
  {
   "t0": 63.16,
   "t1": 65.0,
   "text": "快攻进蓝板球"
  },
  {
   "t0": 65.0,
   "t1": 66.74,
   "text": "得分都靠我"
  },
  {
   "t0": 66.74,
   "t1": 68.7,
   "text": "用他的球骨头"
  },
  {
   "t0": 68.7,
   "t1": 70.52,
   "text": "又不可隐悟我"
  },
  {
   "t0": 70.52,
   "t1": 72.32,
   "text": "寻你这种对忧"
  },
  {
   "t0": 72.32,
   "t1": 74.34,
   "text": "他都乐为"
  },
  {
   "t0": 74.34,
   "t1": 75.7,
   "text": "能说的你说"
  },
  {
   "t0": 75.7,
   "t1": 76.68,
   "text": "本就怎么停留"
  },
  {
   "t0": 76.68,
   "t1": 77.62,
   "text": "一直停留"
  },
  {
   "t0": 77.62,
   "t1": 78.78,
   "text": "谁能够停留点"
  },
  {
   "t0": 78.78,
   "t1": 79.4,
   "text": "为什么"
  },
  {
   "t0": 79.4,
   "t1": 80.4,
   "text": "我你没有成功"
  },
  {
   "t0": 80.4,
   "t1": 81.24,
   "text": "千万的缺乏"
  },
  {
   "t0": 81.24,
   "t1": 82.0,
   "text": "还让我出去"
  },
  {
   "t0": 82.0,
   "t1": 82.56,
   "text": "让你说"
  },
  {
   "t0": 82.56,
   "t1": 85.62,
   "text": "你怎么打我"
  },
  {
   "t0": 85.62,
   "t1": 86.36,
   "text": "说你说"
  },
  {
   "t0": 86.36,
   "t1": 88.34,
   "text": "是不是你不想我"
  },
  {
   "t0": 88.92,
   "t1": 89.48,
   "text": "啊"
  },
  {
   "t0": 89.48,
   "t1": 91.42,
   "text": "说你怎么面对我"
  },
  {
   "t0": 91.42,
   "t1": 93.04,
   "text": "甩开着我们长的路"
  },
  {
   "t0": 93.58,
   "t1": 95.38,
   "text": "我想走你已经很久"
  },
  {
   "t0": 95.38,
   "t1": 96.8,
   "text": "别想走"
  },
  {
   "t0": 96.8,
   "t1": 98.82,
   "text": "说你眼睛看着我"
  },
  {
   "t0": 98.82,
   "t1": 100.72,
   "text": "别把对你给我抬起头"
  },
  {
   "t0": 100.72,
   "t1": 102.84,
   "text": "又把剧烈一样想说"
  },
  {
   "t0": 102.84,
   "t1": 104.2,
   "text": "别怪我"
  },
  {
   "t0": 104.2,
   "t1": 106.22,
   "text": "说你怎么面对我"
  },
  {
   "t0": 106.22,
