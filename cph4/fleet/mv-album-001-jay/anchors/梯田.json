 "lines": [
  {
   "t0": 16.82,
   "t1": 17.78,
   "text": "Winston"
  },
  {
   "t0": 17.78,
   "t1": 19.3,
   "text": "Winston啊 等你寫完字"
  },
  {
   "t0": 19.3,
   "t1": 21.08,
   "text": "我都蹤下常常記錄"
  },
  {
   "t0": 21.08,
   "t1": 22.78,
   "text": "沒關係 慢慢來"
  },
  {
   "t0": 22.78,
   "t1": 24.3,
   "text": "就數個我自己來"
  },
  {
   "t0": 24.3,
   "t1": 25.78,
   "text": "說到從學時期"
  },
  {
   "t0": 25.78,
   "t1": 27.8,
   "text": "就像這一片片片體貼"
  },
  {
   "t0": 27.8,
   "t1": 29.98,
   "text": "是我看過最美的理由"
  },
  {
   "t0": 29.98,
   "t1": 33.0,
   "text": "一視也影成讓我折了最佳攝影"
  },
  {
   "t0": 33.0,
   "t1": 34.86,
   "text": "我沒請求在畫面中"
  },
  {
   "t0": 34.86,
   "t1": 36.16,
   "text": "我不會寫字"
  },
  {
   "t0": 36.16,
   "t1": 38.02,
   "text": "都像個聖人坐著公車"
  },
  {
   "t0": 38.02,
   "t1": 39.04,
   "text": "上學的我"
  },
  {
   "t0": 39.04,
   "t1": 40.6,
   "text": "看到窗外的牛肝潮"
  },
  {
   "t0": 40.6,
   "t1": 43.46,
   "text": "是一種說不出的自由責任"
  },
  {
   "t0": 43.46,
   "t1": 49.72,
   "text": "我又一樣的無完那一年"
  },
  {
   "t0": 49.72,
   "t1": 56.44,
   "text": "我親愛的女兒"
  },
  {
   "t0": 56.44,
   "t1": 62.78,
   "text": "我又一樣的無完那一年"
  },
  {
   "t0": 62.78,
   "t1": 67.32,
   "text": "我抱著你"
  },
  {
   "t0": 68.46,
   "t1": 70.9,
   "text": "面臉龐著小雪狗"
  },
  {
   "t0": 70.9,
   "t1": 72.44,
   "text": "日中我們長大的夢"
  },
  {
   "t0": 72.44,
   "t1": 74.7,
   "text": "我繞過天真 跳著手個跡"
  },
  {
   "t0": 74.7,
   "t1": 77.32,
   "text": "人難捍衢 絕對滿足一環笑"
  },
  {
   "t0": 77.32,
   "t1": 80.14,
   "text": "說不見在這什麼的畫面面"
  },
  {
   "t0": 80.14,
   "t1": 82.02,
   "text": "你是我另一箱站在主坪"
  },
  {
   "t0": 82.02,
   "t1": 84.84,
   "text": "看著回憶 把這朵花拿在牆上"
  },
  {
   "t0": 84.84,
   "t1": 87.76,
   "text": "一個傻勇 鼓勵你多久回事吧"
  },
  {
   "t0": 87.76,
   "t1": 90.48,
   "text": "和我自相撕掉 放回自然"
  },
  {
   "t0": 90.48,
   "t1": 92.88,
   "text": "怎麼天天不見 多地起家飯店"
  },
  {
   "t0": 92.88,
   "t1": 96.0,
   "text": "坐在裡面 看著夕陽片 接著水流"
  },
  {
   "t0": 96.0,
   "t1": 98.2,
   "text": "卻變成火 躺在牆壁上"
  },
  {
   "t0": 98.2,
   "t1": 101.18,
   "text": "像這人們 站在一堆遊客"
  },
  {
   "t0": 101.18,
   "t1": 103.06,
   "text": "我想看個窗外的觀光"
  },
  {
   "t0": 103.06,
   "t1": 107.22,
   "text": "今天的只看到 比你住的 最高層的飯店"
  },
  {
   "t0": 107.22,
   "t1": 113.58,
   "text": "我又一樣的無完那一年"
  },
  {
   "t0": 113.58,
   "t1": 119.86,
   "text": "我親愛的女兒"
  },
  {
   "t0": 119.86,
   "t1": 126.56,
   "text": "我又一樣的無完那一年"
  },
  {
   "t0": 126.56,
   "t1": 133.94,
   "text": "我 抱抱我 失去了"
  },
  {
   "t0": 144.96,
   "t1": 147.38,
   "text": "隱匿著 走個遠遠"
  },
  {
   "t0": 147.38,
   "t1": 150.0,
   "text": "不給還是不對 自得的對"
  },
  {
   "t0": 150.0,
   "t1": 152.44,
   "text": "不給 我自願的深海"
  },
  {
   "t0": 152.44,
   "t1": 154.82,
   "text": "會不放開淚 你是為了你說"
  },
  {
   "t0": 154.82,
   "t1": 156.72,
   "text": "要看一下一個學家"
  },
  {
   "t0": 156.72,
   "t1": 159.5,
   "text": "對還是不對 說為了裝飾"
  },
  {
   "t0": 159.5,
   "t1": 161.98,
   "text": "還請你乾我啥事 說不說"
  },
  {
   "t0": 161.98,
   "t1": 164.94,
   "text": "怎麼都像記憶 自然的不相遍"
  },
  {
   "t0": 164.94,
   "t1": 167.7,
   "text": "給下帶 給下帶 會為可憐"
  },
  {
   "t0": 167.7,
   "t1": 170.7,
   "text": "更悲傷的女的 都與曾經無緣"
  },
  {
   "t0": 170.7,
   "t1": 174.1,
   "text": "我不到女傲男 只想說到無言長氣"
  },
  {
   "t0": 174.1,
   "t1": 176.22,
   "text": "我抱著教育 你們我不是"
  },
  {
   "t0": 176.22,
   "t1": 177.82,
   "text": "你們的理想 我不是"
  },
  {
   "t0": 177.82,
   "t1": 180.02,
   "text": "小菜 也不能給你個一把"
  },
  {
   "t0": 180.02,
   "t1": 183.44,
   "text": "長長長長長長長長長長長長長"
  },
  {
   "t0": 183.44,
   "t1": 185.22,
   "text": "長篇大論 雨嶙不想聽"
  },
  {
   "t0": 185.22,
   "t1": 186.92,
   "text": "我知道 都沒辦法"
  },
  {
   "t0": 186.92,
   "t1": 190.04,
   "text": "我這是要求 你們可能永遠不能體會"
  },
  {
   "t0": 190.04,
   "t1": 193.32,
   "text": "想為今天下午的人 會更現實的自私"
  },
  {
   "t0": 193.32,
   "t1": 196.12,
   "text": "這綴衣術真的很難領悟"
  },
  {
   "t0": 211.92,
   "t1": 213.32,
   "text": "詞曲 李宗盛"
  }
 ]
}