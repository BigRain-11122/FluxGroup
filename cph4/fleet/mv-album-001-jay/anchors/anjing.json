[
 {
  "start": 3.56,
  "end": 4.96,
  "text": "Zither Harp"
 },
 {
  "start": 10.0,
  "end": 10.92,
  "text": "Zither Harp"
 },
 {
  "start": 27.06,
  "end": 32.28,
  "text": "只剩下鋼琴被我吞了一天"
 },
 {
  "start": 32.28,
  "end": 39.36,
  "text": "睡著的大提琴 安靜的救救人"
 },
 {
  "start": 40.72,
  "end": 45.52,
  "text": "我想你一表現得非常明白"
 },
 {
  "start": 45.52,
  "end": 52.66,
  "text": "我懂我也知道 你理由捨不得"
 },
 {
  "start": 53.86,
  "end": 58.84,
  "text": "你說你也會難過我不相信"
 },
 {
  "start": 60.34,
  "end": 66.1,
  "text": "堅持你背著我也只是曾經"
 },
 {
  "start": 66.1,
  "end": 72.3,
  "text": "希望他是真的比我還要愛你"
 },
 {
  "start": 72.84,
  "end": 77.34,
  "text": "我才會比自己厲害"
 },
 {
  "start": 81.04,
  "end": 87.58,
  "text": "你要我說多難看我根本不想分開"
 },
 {
  "start": 87.58,
  "end": 93.44,
  "text": "為什麼還要我又會笑來帶過"
 },
 {
  "start": 93.44,
  "end": 100.86,
  "text": "我沒有這種天分 包容你也接受他"
 },
 {
  "start": 100.86,
  "end": 107.64,
  "text": "不用擔心的太多 我會一直好好過"
 },
 {
  "start": 107.64,
  "end": 114.3,
  "text": "你已經遠遠離開 我也會慢慢走開"
 },
 {
  "start": 114.3,
  "end": 120.42,
  "text": "為什麼我連分開都牽扯著你"
 },
 {
  "start": 120.42,
  "end": 127.62,
  "text": "我真的沒有天分 安靜的飛這麼快"
 },
 {
  "start": 127.62,
  "end": 134.32,
  "text": "我會試著放棄你 是因為我太愛你"
 },
