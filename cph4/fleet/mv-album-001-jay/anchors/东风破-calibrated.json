[
 {
  "t0": 14.17,
  "t1": 20.73,
  "text": "一盏离愁 孤单伫立在窗口",
  "approx": false
 },
 {
  "t0": 20.73,
  "t1": 27.26,
  "text": "我在门后 假装你人还没走",
  "approx": false
 },
 {
  "t0": 27.26,
  "t1": 33.85,
  "text": "旧地如重游 月圆更寂寞",
  "approx": false
 },
 {
  "t0": 33.85,
  "t1": 40.44,
  "text": "夜半清醒的烛火 不忍苛责我",
  "approx": false
 },
 {
  "t0": 40.44,
  "t1": 47.0,
  "text": "一壶漂泊 浪迹天涯难入喉",
  "approx": false
 },
 {
  "t0": 47.0,
  "t1": 53.58,
  "text": "你走之后 酒暖回忆思念瘦",
  "approx": false
 },
 {
  "t0": 53.58,
  "t1": 60.14,
  "text": "水向东流 时间怎么偷",
  "approx": false
 },
 {
  "t0": 60.14,
  "t1": 70.04,
  "text": "花开就一次成熟 我却错过",
  "approx": false
 },
 {
  "t0": 70.04,
  "t1": 76.57,
  "text": "谁在用琵琶弹奏 一曲东风破",
  "approx": false
 },
 {
  "t0": 76.57,
  "t1": 83.16,
  "text": "岁月在墙上剥落 看见小时候",
  "approx": false
 },
 {
  "t0": 83.16,
  "t1": 89.76,
  "text": "犹记得那年我们都还很年幼",
  "approx": false
 },
 {
  "t0": 89.76,
  "t1": 96.27,
  "text": "而如今琴声幽幽 我的等候 你没听过",
  "approx": false
 },
 {
  "t0": 96.27,
  "t1": 102.89,
  "text": "谁在用琵琶弹奏 一曲东风破",
  "approx": false
 },
 {
  "t0": 102.89,
  "t1": 109.47,
  "text": "枫叶将故事染色 结局我看透",
  "approx": false
 },
 {
  "t0": 109.47,
  "t1": 116.03,
  "text": "篱笆外的古道我牵着你走过",
  "approx": false
 },
 {
  "t0": 116.03,
  "t1": 148.93,
  "text": "荒烟蔓草的年头 就连分手都很沉默",
  "approx": false
 },
 {
