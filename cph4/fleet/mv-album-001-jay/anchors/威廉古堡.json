 "lines": [
  {
   "t0": 36.28,
   "t1": 37.04,
   "text": "Zither Harp"
  },
  {
   "t0": 42.0,
   "t1": 48.14,
   "text": "吞滿著 滿滿了佛覺的墨目"
  },
  {
   "t0": 48.14,
   "t1": 51.0,
   "text": "古堡裡變黃霧"
  },
  {
   "t0": 51.54,
   "t1": 54.52,
   "text": "剛剛找到的你都"
  },
  {
   "t0": 56.14,
   "t1": 59.4,
   "text": "無謂起手把的棒女舞"
  },
  {
   "t0": 59.4,
   "t1": 62.48,
   "text": "用拉丁萬年走雨壓的舞"
  },
  {
   "t0": 62.48,
   "t1": 66.3,
   "text": "大洋的黑馬上去帶香菇"
  },
  {
   "t0": 66.3,
   "t1": 70.44,
   "text": "啦啦啦舞 入雪晴就停了暫暫舞"
  },
  {
   "t0": 70.44,
   "t1": 73.88,
   "text": "在樹下無聲音讓我射進角落的角度"
  },
  {
   "t0": 73.88,
   "t1": 76.98,
   "text": "能知道你其實是冷的愛之編譜"
  },
  {
   "t0": 76.98,
   "t1": 80.42,
   "text": "古堡主人為了吃滿年的老塞舞"
  },
  {
   "t0": 80.42,
   "t1": 84.08,
   "text": "習慣在希望邂逅還是大悟"
  },
  {
   "t0": 84.08,
   "t1": 87.48,
   "text": "凡假是一直為了把一句字優雅得住"
  },
  {
   "t0": 87.48,
   "t1": 90.76,
   "text": "謝謝經歷你也很不願做為你一步"
  },
  {
   "t0": 90.76,
   "t1": 94.14,
   "text": "擁有你雙眼睛的開閃靈光圖"
  },
  {
   "t0": 94.14,
   "t1": 97.56,
   "text": "專注熱烈於誰的眼睛的功勞"
  },
  {
   "t0": 97.56,
   "t1": 101.52,
   "text": "古堡主人為了吃滿年的老塞舞"
  },
  {
   "t0": 101.52,
   "t1": 104.5,
   "text": "隱藏在舞手長腦製度"
  },
  {
   "t0": 104.5,
   "t1": 108.14,
   "text": "清醒古堡全場的日度"
  },
  {
   "t0": 108.14,
   "t1": 111.06,
   "text": "白色的土吻在流口"
  },
  {
   "t0": 117.48,
   "t1": 127.48,
   "text": "啦啦啦舞"
  },
  {
   "t0": 128.24,
   "t1": 133.1,
   "text": "在冷的舞 慢慢來破絕的舞"
  },
  {
   "t0": 133.1,
   "t1": 140.8,
   "text": "古堡的一邊為了掌握著朝的地圖"
  },
  {
   "t0": 141.66,
   "t1": 145.22,
   "text": "能不回氣送八個彭妮舞"
  },
  {
   "t0": 145.22,
   "t1": 148.24,
   "text": "用拉丁萬年作語的舞"
  },
  {
   "t0": 148.24,
   "t1": 152.08,
   "text": "太陽的黑暈 磨消氣的江湖"
  },
  {
   "t0": 152.08,
   "t1": 153.36,
   "text": "啦啦啦舞"
  },
  {
   "t0": 153.36,
   "t1": 156.22,
   "text": "時間過替了暖暖舞"
  },
  {
   "t0": 156.22,
   "t1": 159.64,
   "text": "在手下無聲音 讓我射進照亮的角度"
  },
  {
   "t0": 159.64,
   "t1": 162.8,
   "text": "能知道你其實是冷的愛之編譜"
  },
  {
   "t0": 162.8,
   "t1": 166.22,
   "text": "古堡主人為了吃滿年的老塞舞"
  },
  {
   "t0": 166.22,
   "t1": 169.86,
   "text": "習慣在希望邂逅還是大悟"
  },
  {
   "t0": 169.86,
   "t1": 173.26,
   "text": "凡假是一直為了把一句字優雅得住"
  },
  {
   "t0": 173.26,
   "t1": 176.58,
   "text": "謝謝千惟你 也很不願做回逆步"
  },
  {
   "t0": 176.58,
   "t1": 179.92,
   "text": "擁有一雙盤子眼睛的開閃靈光度"
  },
  {
   "t0": 179.92,
   "t1": 183.36,
   "text": "專注 任何一隻眼睛的光光"
  },
  {
   "t0": 183.36,
   "t1": 186.7,
   "text": "古堡主人為了吃滿年的老塞舞"
  },
  {
   "t0": 186.7,
   "t1": 189.36,
   "text": "隱藏在舞手長腦製度"
  },
  {
   "t0": 189.36,
   "t1": 192.84,
   "text": "清醒古堡全場的日度"
  },
  {
   "t0": 192.84,
   "t1": 196.54,
   "text": "白色的土吻在流口"
  },
  {
   "t0": 196.54,
   "t1": 198.74,
   "text": "你說你說不是怎麼停留"
  },
  {
   "t0": 198.74,
   "t1": 200.68,
   "text": "一直在停留 誰怎麼停留的"
  },
  {
   "t0": 200.68,
   "t1": 202.42,
   "text": "為什麼我裡面有長愛結婚"
  },
  {
   "t0": 202.42,
   "t1": 203.82,
   "text": "你卻還讓我追求"
  },
  {
   "t0": 203.82,
   "t1": 205.6,
   "text": "你說不是怎麼停留"
  },
  {
   "t0": 205.6,
   "t1": 207.56,
   "text": "一直在停留 誰怎麼停留的"
  },
  {
   "t0": 207.56,
   "t1": 209.26,
   "text": "為什麼我裡面有長愛結婚"
  },
  {
   "t0": 209.26,
   "t1": 210.82,
   "text": "你卻還讓我追求"
  },
  {
   "t0": 234.76,
   "t1": 236.16,
   "text": "詞曲 李宗盛"
  }
 ]
