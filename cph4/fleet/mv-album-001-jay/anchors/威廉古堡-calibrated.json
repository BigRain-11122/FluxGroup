[
 {
  "t0": 42.59,
  "t1": 48.38,
  "text": "藤蔓植物 爬满了伯爵的坟墓",
  "approx": false
 },
 {
  "t0": 48.38,
  "t1": 56.73,
  "text": "古堡里一片荒芜 长满杂草的泥土",
  "approx": false
 },
 {
  "t0": 56.73,
  "t1": 59.64,
  "text": "不会骑扫把的胖女巫",
  "approx": false
 },
 {
  "t0": 59.64,
  "t1": 63.27,
  "text": "用拉丁文念咒语啦啦呜",
  "approx": false
 },
 {
  "t0": 63.27,
  "t1": 66.59,
  "text": "她养的黑猫笑起来像哭",
  "approx": false
 },
 {
  "t0": 66.59,
  "t1": 70.57,
  "text": "啦啦啦呜 用水晶球替人占卜",
  "approx": false
 },
 {
  "t0": 70.57,
  "t1": 74.06,
  "text": "她说下午三点阳光射进教堂的角度",
  "approx": false
 },
 {
  "t0": 74.06,
  "t1": 77.45,
  "text": "能知道你前世是狼人还是蝙蝠",
  "approx": false
 },
 {
  "t0": 77.45,
  "t1": 80.79,
  "text": "古堡主人威廉二世满脸的落腮胡",
  "approx": false
 },
 {
  "t0": 80.79,
  "t1": 84.38,
  "text": "习惯 在吸完血后开始打呼",
  "approx": false
 },
 {
  "t0": 84.38,
  "t1": 87.81,
  "text": "管家是一只会说法语举止优雅的猪",
  "approx": false
 },
 {
  "t0": 87.81,
  "t1": 91.15,
  "text": "吸血前会念约翰福音做为弥补",
  "approx": false
 },
 {
  "t0": 91.15,
  "t1": 94.56,
  "text": "拥有一双蓝色眼睛的凯萨琳公主",
  "approx": false
 },
 {
  "t0": 94.56,
  "t1": 98.21,
  "text": "专吃 有AB血型的公老鼠",
  "approx": false
 },
 {
  "t0": 98.21,
  "t1": 101.5,
  "text": "恍恍惚惚 是谁的脚步",
  "approx": false
 },
 {
  "t0": 101.5,
  "t1": 104.92,
  "text": "银制茶壶 装蟑螂蜘蛛",
  "approx": false
 },
 {
  "t0": 104.92,
  "t1": 108.41,
  "text": "辛辛苦苦 全家怕日出",
  "approx": false
 },
 {
  "t0": 108.41,
  "t1": 128.08,
  "text": "白色蜡烛 温暖了空屋",
