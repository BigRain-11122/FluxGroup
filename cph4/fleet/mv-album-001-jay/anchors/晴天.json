 "lines": [
  {
   "t0": 28.46,
   "t1": 29.94,
   "text": "詞曲 李宗盛"
  },
  {
   "t0": 29.94,
   "t1": 35.68,
   "text": "你的笑 混亂 從這上來就拍攝"
  },
  {
   "t0": 35.68,
   "t1": 42.42,
   "text": "從遠的動 轉成誰 記住到現在"
  },
  {
   "t0": 42.94,
   "t1": 49.6,
   "text": "寂寞 寂寞 寂寞 寂寞 寂寞"
  },
  {
   "t0": 49.6,
   "t1": 53.02,
   "text": "吹著枕 都望著天空"
  },
  {
   "t0": 53.02,
   "t1": 56.34,
   "text": "我想起畫版 試著調整"
  },
  {
   "t0": 56.34,
   "t1": 60.34,
   "text": "為你找到的那一天 找到的那一天"
  },
  {
   "t0": 60.34,
   "t1": 63.8,
   "text": "假設的那一天 怎麼看不見"
  },
  {
   "t0": 63.8,
   "t1": 68.16,
   "text": "角色的笑 有點我倒想再另一邊"
  },
  {
   "t0": 69.3,
   "t1": 74.24,
   "text": "很陷到 失去的勇氣 我還留著"
  },
  {
   "t0": 75.74,
   "t1": 81.72,
   "text": "好像在外面 你會記得還是離開"
  },
  {
   "t0": 84.24,
   "t1": 89.98,
   "text": "掛風著天 我試過握著你手"
  },
  {
   "t0": 89.98,
   "t1": 97.12,
   "text": "難典典 一瞬間 打到我看你不見"
  },
  {
   "t0": 98.3,
   "t1": 104.8,
   "text": "還要多久 我才能在你身邊"
  },
  {
   "t0": 104.8,
   "t1": 112.2,
   "text": "能到房間的那天 也許我會比較好一點"
  },
  {
   "t0": 112.68,
   "t1": 118.02,
   "text": "從前從前 有個人愛你很久"
  },
  {
   "t0": 118.02,
   "t1": 125.24,
   "text": "但偏偏 風沾著 把記憶吹得好眼"
  },
  {
   "t0": 126.22,
   "t1": 132.0,
   "text": "好不容易 有能再多愛一點"
  },
  {
   "t0": 132.98,
   "t1": 136.38,
   "text": "難典典 最懂你"
  },
  {
   "t0": 136.38,
   "t1": 140.56,
   "text": "好像還心瘦的 拜拜"
  },
  {
   "t0": 154.02,
