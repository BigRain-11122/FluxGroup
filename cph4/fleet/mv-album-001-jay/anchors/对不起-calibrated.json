[
 {
  "t0": 21.26,
  "t1": 24.61,
  "text": "广场一枚铜币悲伤的很隐秘",
  "approx": false
 },
 {
  "t0": 24.61,
  "t1": 28.01,
  "text": "它在许愿池里轻轻叹息",
  "approx": false
 },
 {
  "t0": 28.01,
  "t1": 33.14,
  "text": "太多的我爱你让它喘不过气已经",
  "approx": false
 },
 {
  "t0": 33.14,
  "t1": 34.97,
  "text": "失去意义",
  "approx": false
 },
 {
  "t0": 34.97,
  "t1": 38.34,
  "text": "戒指在哭泣静静躺在抽屉",
  "approx": false
 },
 {
  "t0": 38.34,
  "t1": 41.75,
  "text": "它所拥有的只剩下回忆",
  "approx": false
 },
 {
  "t0": 41.75,
  "t1": 46.7,
  "text": "相爱还有别离像无法被安排的雨",
  "approx": false
 },
 {
  "t0": 46.7,
  "t1": 49.16,
  "text": "随时准备来袭",
  "approx": false
 },
 {
  "t0": 49.16,
  "t1": 53.63,
  "text": "我怀念起国小的课桌椅",
  "approx": false
 },
 {
  "t0": 53.63,
  "t1": 56.15,
  "text": "怀念着用铅笔写日记",
  "approx": false
 },
 {
  "t0": 56.15,
  "t1": 59.59,
  "text": "记录那最原始的美丽",
  "approx": false
 },
 {
  "t0": 59.59,
  "t1": 62.04,
  "text": "记录第一次遇见的你",
  "approx": false
 },
 {
  "t0": 62.04,
  "t1": 63.05,
  "text": "Jay Chou",
  "approx": false
 },
 {
  "t0": 63.05,
  "t1": 66.41,
  "text": "如果我遇见你是一场悲剧",
  "approx": false
 },
 {
  "t0": 66.41,
  "t1": 69.85,
  "text": "我想我这辈子注定一个人演戏",
  "approx": false
 },
 {
  "t0": 69.85,
  "t1": 73.33,
  "text": "最后再一个人慢慢地回忆",
  "approx": false
 },
 {
  "t0": 73.33,
  "t1": 76.76,
  "text": "没有了过去我将往事抽离",
  "approx": false
 },
 {
  "t0": 76.76,
  "t1": 80.18,
  "text": "如果我遇见你是一场悲剧",
  "approx": false
 },
 {
  "t0": 80.18,
  "t1": 83.63,
  "text": "我可以让生命就这样毫无意义",
  "approx": false
 },
 {
  "t0": 83.63,
  "t1": 87.0,
  "text": "或许在最后能听到你一句",
  "approx": false
 },
 {
  "t0": 87.0,
  "t1": 106.14,
  "text": "轻轻地叹息后悔着对不起",
  "approx": false
 },
