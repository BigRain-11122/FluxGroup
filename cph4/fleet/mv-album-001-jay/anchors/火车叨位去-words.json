 "lines": [
  {
   "t0": 4.62,
   "t1": 6.02,
   "text": "Zither Harp"
  },
  {
   "t0": 12.5,
   "t1": 13.02,
   "text": "Zither Harp"
  },
  {
   "t0": 27.34,
   "t1": 31.38,
   "text": "聽我說 三卡的路 並是兩邊的酒店"
  },
  {
   "t0": 31.38,
   "t1": 35.24,
   "text": "這位地 保留的酒店是他所發明"
  },
  {
   "t0": 35.24,
   "t1": 39.24,
   "text": "聽我說 夢境差你 水灰的茶豆味皮"
  },
  {
   "t0": 39.24,
   "t1": 43.12,
   "text": "這座坪 下過樹林你是他所發明"
  },
  {
   "t0": 43.12,
   "t1": 45.88,
   "text": "這位崩潰 並是阿彌"
  },
  {
   "t0": 46.82,
   "t1": 50.0,
   "text": "但這條迷路的軌跡"
  },
  {
   "t0": 50.78,
   "t1": 53.64,
   "text": "按著你找你的東西"
  },
  {
   "t0": 54.68,
   "t1": 58.48,
   "text": "無法過天灰 再等你"
  },
  {
   "t0": 58.48,
   "t1": 62.58,
   "text": "軌跡軌跡 全開閉的探紫龍是到天灰"
  },
  {
   "t0": 62.58,
   "t1": 65.0,
   "text": "你是真心我請你水灰"
  },
  {
   "t0": 65.0,
   "t1": 67.26,
   "text": "崩潰 去村最好 再逃去"
  },
  {
   "t0": 67.26,
   "t1": 71.42,
   "text": "過去你被人的氣 都是酒樓上感罵"
  },
  {
   "t0": 71.42,
   "t1": 73.86,
   "text": "等你過樹高峽危機"
  },
  {
   "t0": 74.42,
   "t1": 77.58,
   "text": "你那天昨天很沒消息"
  },
  {
   "t0": 78.1,
   "t1": 81.38,
   "text": "我請你接著蹦在門邊"
  },
  {
   "t0": 81.98,
   "t1": 85.48,
   "text": "總被你直接丟去丟了你"
  },
  {
   "t0": 85.48,
   "t1": 90.92,
   "text": "在你前面的高市 找你去逼人"
  },
  {
   "t0": 90.92,
   "t1": 93.2,
   "text": "昨天很沒消息"
  },
  {
   "t0": 93.92,
   "t1": 97.46,
   "text": "酒樓上的一樣等級"
  },
  {
   "t0": 97.46,
   "t1": 101.16,
   "text": "門外國東來酒吧 足比"
  },
  {
