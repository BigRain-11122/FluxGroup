 "lines": [
  {
   "t0": 26.6,
   "t1": 29.98,
   "text": "愛上一種風"
  },
  {
   "t0": 29.98,
   "t1": 37.0,
   "text": "吹完它就走 這樣的節奏"
  },
  {
   "t0": 37.22,
   "t1": 40.4,
   "text": "誰都無可奈何"
  },
  {
   "t0": 40.94,
   "t1": 46.98,
   "text": "有你以後 我靈魂失控"
  },
  {
   "t0": 46.98,
   "t1": 53.1,
   "text": "黑暈在降落 我陪它拖車"
  },
  {
   "t0": 53.1,
   "t1": 56.88,
   "text": "走緊緊 叫著我 莫離開"
  },
  {
   "t0": 56.88,
   "t1": 60.74,
   "text": "心路樂圍 心別遠 疲憊"
  },
  {
   "t0": 60.74,
   "t1": 65.26,
   "text": "我的世界一狂風把無語"
  },
  {
   "t0": 66.96,
   "t1": 70.56,
   "text": "愛情來得太快 就像龍泉風"
  },
  {
   "t0": 70.56,
   "t1": 73.48,
   "text": "離不開 暴風全來不及逃"
  },
  {
   "t0": 73.48,
   "t1": 76.94,
   "text": "我不能再傷 我不能再傷"
  },
  {
   "t0": 76.94,
   "t1": 79.18,
   "text": "我不 我不能"
  },
  {
   "t0": 80.22,
   "t1": 83.9,
   "text": "愛情走得太快 就像龍泉風"
  },
  {
   "t0": 83.9,
   "t1": 86.84,
   "text": "我不能承受 我已無處可動"
  },
  {
   "t0": 86.84,
   "t1": 90.26,
   "text": "我不要再傷 我不要再傷"
  },
  {
   "t0": 90.26,
   "t1": 93.7,
   "text": "我不 我不要再傷"
  },
  {
   "t0": 93.7,
   "t1": 97.28,
   "text": "我不覺得你已經離開我"
  },
  {
   "t0": 97.28,
   "t1": 100.7,
   "text": "不覺得我感愛這節奏"
  },
  {
   "t0": 100.7,
   "t1": 103.86,
   "text": "不覺得 又過了一段中"
  },
  {
   "t0": 103.86,
   "t1": 107.4,
   "text": "不覺得 我感愛這節奏"
  },
  {
   "t0": 107.4,
   "t1": 110.2,
   "text": "經濟悄悄我莫離開"
  },
