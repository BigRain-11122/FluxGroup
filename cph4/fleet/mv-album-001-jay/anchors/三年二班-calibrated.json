 {
  "t0": 129.28,
  "t1": 131.71,
  "text": "今天我要表扬一位同学",
  "approx": false
 },
 {
  "t0": 131.71,
  "t1": 133.09,
  "text": "他为校争光",
  "approx": false
 },
 {
  "t0": 133.09,
  "t1": 148.12,
  "text": "我们要向他看齐",
  "approx": false
 },
 {
  "t0": 148.12,
  "t1": 150.35,
  "text": "我不想就这样一直走",
  "approx": false
 },
 {
  "t0": 150.35,
  "t1": 153.38,
  "text": "每天都遇上充满敌意那种眼光",
  "approx": false
 },
 {
  "t0": 153.38,
  "t1": 155.89,
  "text": "等机会就是要打倒对方",
  "approx": false
 },
 {
  "t0": 155.89,
  "t1": 157.34,
  "text": "这种结果我不要",
  "approx": false
 },
 {
  "t0": 157.34,
  "t1": 158.7,
  "text": "这虚荣的骄傲",
  "approx": false
 },
 {
  "t0": 158.7,
  "t1": 160.05,
  "text": "这目的很好笑",
  "approx": false
 },
 {
