[
 {
  "t0": 6.4,
  "t1": 8.98,
  "text": "训导处报告 训导处报告",
  "approx": false
 },
 {
  "t0": 8.98,
  "t1": 11.12,
  "text": "三年二班周杰伦",
  "approx": false
 },
 {
  "t0": 11.12,
  "t1": 39.99,
  "text": "马上到训导处来",
  "approx": false
 },
 {
  "t0": 39.99,
  "t1": 41.1,
  "text": "眼睛你要擦亮",
  "approx": false
 },
 {
  "t0": 41.1,
  "t1": 42.41,
  "text": "记住我的模样",
  "approx": false
 },
 {
  "t0": 42.41,
  "t1": 43.79,
  "text": "表情不用太紧张",
  "approx": false
 },
 {
  "t0": 43.79,
  "t1": 45.07,
  "text": "我是三年二班",
  "approx": false
 },
 {
  "t0": 45.07,
  "t1": 47.28,
  "text": "我专心打球的侧脸还蛮好看",
  "approx": false
 },
 {
  "t0": 47.28,
  "t1": 49.19,
  "text": "黑板是吸收知识的地方",
  "approx": false
 },
 {
  "t0": 49.19,
  "t1": 50.46,
  "text": "只是教室的阳光",
  "approx": false
 },
 {
  "t0": 50.46,
  "t1": 51.89,
  "text": "那颜色我不太喜欢",
  "approx": false
 },
 {
  "t0": 51.89,
  "t1": 53.37,
  "text": "没有操场的自然",
  "approx": false
 },
 {
  "t0": 53.37,
  "t1": 55.91,
  "text": "为何比较漂亮的都是在隔壁班",
  "approx": false
 },
 {
  "t0": 55.91,
  "t1": 57.11,
  "text": "还有考卷的答案",
  "approx": false
 },
 {
  "t0": 57.11,
  "t1": 58.41,
  "text": "我刚好都不会算",
  "approx": false
 },
 {
  "t0": 58.41,
  "t1": 59.12,
  "text": "没关系",
  "approx": false
 },
 {
  "t0": 59.12,
  "t1": 60.42,
  "text": "再继续努力",
  "approx": false
 },
 {
  "t0": 60.42,
  "t1": 61.14,
  "text": "没关系",
  "approx": false
 },
 {
  "t0": 61.14,
  "t1": 63.69,
  "text": "为什么上课时举手很难",
  "approx": false
 },
 {
  "t0": 63.69,
  "t1": 66.4,
  "text": "为什么拿线上宝物简单",
  "approx": false
 },
 {
  "t0": 66.4,
  "t1": 69.06,
  "text": "为什么女生不喜欢太胖",
  "approx": false
 },
 {
  "t0": 69.06,
  "t1": 71.67,
  "text": "为什么都别人手机在响",
  "approx": false
 },
 {
  "t0": 71.67,
  "t1": 74.25,
  "text": "正手发长球的打法只是初级乒乓",
  "approx": false
 },
 {
  "t0": 74.25,
  "t1": 77.01,
  "text": "反手短打再狠狠杀球是高级乒乓",
  "approx": false
 },
 {
  "t0": 77.01,
  "t1": 78.3,
  "text": "回转技巧乒乓",
  "approx": false
 },
 {
  "t0": 78.3,
  "t1": 79.84,
  "text": "前场速攻乒乓",
  "approx": false
 },
 {
  "t0": 79.84,
  "t1": 82.62,
  "text": "对墙壁在练习乒乓乒乓",
  "approx": false
 },
 {
  "t0": 82.62,
  "t1": 85.4,
  "text": "这第一名到底要多强",
  "approx": false
 },
 {
  "t0": 85.4,
  "t1": 87.79,
  "text": "不用问 一定有人向你挑战",
  "approx": false
 },
 {
  "t0": 87.79,
  "t1": 90.79,
  "text": "到底还要过多少关",
  "approx": false
 },
 {
  "t0": 90.79,
  "t1": 93.15,
  "text": "不用怕 告诉他们谁是男子汉",
  "approx": false
 },
 {
  "t0": 93.15,
  "t1": 96.06,
  "text": "可不可以不要这个奖",
  "approx": false
 },
 {
  "t0": 96.06,
  "t1": 98.43,
  "text": "不想问 我只想要流一点汗",
  "approx": false
 },
 {
  "t0": 98.43,
  "t1": 101.42,
  "text": "我当我自己的裁判",
  "approx": false
 },
 {
  "t0": 101.42,
  "t1": 103.83,
  "text": "不想说 选择对手跟要打的仗",
  "approx": false
 },
 {
