  "approx": false
 },
 {
  "t0": 169.34,
  "t1": 171.82,
  "text": "走下乡寻找哪有花香",
  "approx": false
 },
 {
  "t0": 171.82,
  "t1": 174.57,
  "text": "为什么这么简单你做不到",
