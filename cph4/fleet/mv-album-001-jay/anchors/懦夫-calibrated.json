[
 {
  "t0": 21.58,
  "t1": 24.14,
  "text": "周围的人群堵住了我的出口",
  "approx": false
 },
 {
  "t0": 24.14,
  "t1": 26.85,
  "text": "想爬起来我只能说真的好难",
  "approx": false
 },
 {
  "t0": 26.85,
  "t1": 29.53,
  "text": "防火巷传来的枪声把我从天堂叫醒",
  "approx": false
 },
 {
  "t0": 29.53,
  "t1": 32.2,
  "text": "一名白种人褐色头发在我面前倒下",
  "approx": false
 },
 {
  "t0": 32.2,
  "t1": 33.54,
  "text": "从他的手里那半包",
  "approx": false
 },
 {
  "t0": 33.54,
  "t1": 35.06,
  "text": "看到不少我荒唐的影子",
  "approx": false
 },
 {
  "t0": 35.06,
  "t1": 36.06,
  "text": "从他的眼球看到",
  "approx": false
 },
 {
  "t0": 36.06,
  "t1": 37.73,
  "text": "发抖的我是那么的丑陋",
  "approx": false
 },
 {
  "t0": 37.73,
  "t1": 40.15,
  "text": "于是捡起地上他那第二个钮扣",
  "approx": false
 },
 {
  "t0": 40.15,
  "t1": 41.67,
  "text": "提醒自己该开始懂事",
  "approx": false
 },
 {
  "t0": 41.67,
  "t1": 43.04,
  "text": "不被软性药物控制",
  "approx": false
 },
 {
  "t0": 43.04,
  "t1": 45.51,
  "text": "在我的眼里懂得拒绝才能存活下来",
  "approx": false
 },
 {
  "t0": 45.51,
  "t1": 46.28,
  "text": "活着",
  "approx": false
 },
 {
  "t0": 46.28,
  "t1": 48.43,
  "text": "不是用来演一出糜烂的黑色喜剧",
  "approx": false
 },
 {
  "t0": 48.43,
  "t1": 48.99,
  "text": "说不",
  "approx": false
 },
 {
  "t0": 48.99,
  "t1": 51.09,
  "text": "我很后悔当初没有这样的肯定",
  "approx": false
 },
 {
  "t0": 51.09,
  "t1": 51.66,
  "text": "说不",
  "approx": false
 },
 {
  "t0": 51.66,
  "t1": 52.99,
  "text": "不代表懦夫",
  "approx": false
 },
 {
  "t0": 52.99,
  "t1": 55.62,
  "text": "真不该睁不开",
  "approx": false
 },
 {
  "t0": 55.62,
  "t1": 60.33,
  "text": "别让我的地球变暗",
  "approx": false
 },
 {
  "t0": 60.33,
  "t1": 63.59,
  "text": "互相残杀的动物真美",
  "approx": false
 },
 {
  "t0": 63.59,
  "t1": 66.18,
  "text": "被期待被覆盖",
  "approx": false
 },
 {
  "t0": 66.18,
  "t1": 70.94,
  "text": "蜕变的公式我学不来",
  "approx": false
 },
 {
  "t0": 70.94,
  "t1": 96.4,
  "text": "我闻不到腐烂的香味",
  "approx": false
 },
 {
  "t0": 96.4,
  "t1": 96.92,
  "text": "说不",
  "approx": false
 },
 {
  "t0": 96.92,
  "t1": 99.0,
  "text": "我很后悔当时没有这样的肯定",
  "approx": false
 },
 {
  "t0": 99.0,
  "t1": 100.82,
  "text": "说不不代表懦夫",
  "approx": false
 },
 {
  "t0": 100.82,
  "t1": 101.93,
  "text": "你应该很骄傲",
  "approx": false
 },
 {
  "t0": 101.93,
  "t1": 104.46,
  "text": "我看不起人们无知的好奇作祟心态",
  "approx": false
 },
 {
  "t0": 104.46,
  "t1": 105.45,
  "text": "去亲近死神",
  "approx": false
 },
 {
  "t0": 105.45,
  "t1": 106.84,
  "text": "你了吗 很了吗",
  "approx": false
 },
 {
  "t0": 106.84,
  "t1": 109.54,
  "text": "肮脏的香味我吸了太多太多",
  "approx": false
 },
 {
  "t0": 109.54,
  "t1": 112.19,
  "text": "腐败的视野我看了太多太多",
  "approx": false
 },
 {
  "t0": 112.19,
  "t1": 114.8,
  "text": "瞳孔放大不代表就能看的更多",
  "approx": false
 },
 {
  "t0": 114.8,
  "t1": 117.53,
  "text": "难怪大人们说我们永远都长不大",
  "approx": false
 },
 {
  "t0": 117.53,
  "t1": 120.19,
  "text": "那一块在我梦里的干净天空",
  "approx": false
 },
 {
  "t0": 120.19,
  "t1": 122.84,
  "text": "那一块在我梦里的干净天空",
  "approx": false
 },
 {
  "t0": 122.84,
  "t1": 125.55,
  "text": "是否玩大风吹也许就能看到",
  "approx": false
 },
 {
