[
 {
  "t0": 8.97,
  "t1": 10.63,
  "text": "居酒屋里的小神龛",
  "approx": false
 },
 {
  "t0": 10.63,
  "t1": 11.9,
  "text": "离铺满鹅卵石的玄关",
  "approx": false
 },
 {
  "t0": 11.9,
  "t1": 13.22,
  "text": "差不多一米宽的信仰",
  "approx": false
 },
 {
  "t0": 13.22,
  "t1": 14.33,
  "text": "我坐着喝味噌汤",
  "approx": false
 },
 {
  "t0": 14.33,
  "t1": 15.37,
  "text": "在旁观看 庭园假山",
  "approx": false
 },
 {
  "t0": 15.37,
  "t1": 16.32,
  "text": "京都的夜晚",
  "approx": false
 },
 {
  "t0": 16.32,
  "t1": 18.51,
  "text": "有一种榻榻米的稻香叫做禅",
  "approx": false
 },
 {
  "t0": 18.51,
  "t1": 19.88,
  "text": "那里 神社许愿",
  "approx": false
 },
 {
  "t0": 19.88,
  "t1": 21.03,
  "text": "闪过一个画面",
  "approx": false
 },
 {
  "t0": 21.03,
  "t1": 22.26,
  "text": "这里 忍者蒙着脸",
  "approx": false
 },
 {
  "t0": 22.26,
  "t1": 23.21,
  "text": "在角落吹暗箭",
  "approx": false
 },
 {
  "t0": 23.21,
  "t1": 25.04,
  "text": "心里 幕府又重现",
  "approx": false
 },
 {
  "t0": 25.04,
  "t1": 26.3,
  "text": "从前老东京那条山手线",
  "approx": false
 },
 {
  "t0": 26.3,
  "t1": 28.67,
  "text": "像一出怀旧的默片",
  "approx": false
 },
 {
  "t0": 28.67,
  "t1": 36.95,
  "text": "呵 呵 嘿",
  "approx": false
 },
 {
  "t0": 36.95,
  "t1": 38.84,
  "text": "伊贺流忍者的想法",
  "approx": false
 },
 {
  "t0": 38.84,
  "t1": 41.41,
  "text": "嘿 只会用武士刀比划 嘿",
  "approx": false
 },
 {
  "t0": 41.41,
  "t1": 42.52,
  "text": "我一个人在家",
  "approx": false
 },
 {
  "t0": 42.52,
  "t1": 43.95,
  "text": "乖乖的学插花",
  "approx": false
 },
 {
  "t0": 43.95,
  "t1": 45.91,
  "text": "はい はい はい わかりました",
  "approx": false
 },
 {
  "t0": 45.91,
  "t1": 48.21,
  "text": "いち に さん し 樱花落满地",
  "approx": false
 },
 {
  "t0": 48.21,
  "t1": 50.47,
  "text": "有一种神秘 凝结了空气",
  "approx": false
 },
 {
  "t0": 50.47,
  "t1": 52.78,
  "text": "いち に さん し 黑夜里偷袭",
  "approx": false
 },
 {
  "t0": 52.78,
  "t1": 55.01,
  "text": "去攻击 烟雾当武器",
  "approx": false
 },
 {
  "t0": 55.01,
  "t1": 57.22,
  "text": "いち に さん し 忍者的物语",
  "approx": false
 },
 {
  "t0": 57.22,
  "t1": 59.53,
  "text": "要切断过去 忠心是唯一",
  "approx": false
 },
 {
  "t0": 59.53,
  "t1": 61.79,
  "text": "いち に さん し 隐身要彻底",
  "approx": false
 },
 {
  "t0": 61.79,
  "t1": 81.36,
  "text": "要忘记 什么是自己",
  "approx": false
 },
