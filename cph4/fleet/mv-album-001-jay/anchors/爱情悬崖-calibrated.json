[
 {
  "t0": 10.37,
  "t1": 18.75,
  "text": "你说我像一个小孩",
  "approx": false
 },
 {
  "t0": 18.75,
  "t1": 24.33,
  "text": "总爱让你猜",
  "approx": false
 },
 {
  "t0": 24.33,
  "t1": 32.41,
  "text": "我说你才像个小孩",
  "approx": false
 },
 {
  "t0": 32.41,
  "t1": 38.2,
  "text": "总要我说才明白",
  "approx": false
 },
 {
  "t0": 38.2,
  "t1": 41.64,
  "text": "有些事太快",
  "approx": false
 },
 {
  "t0": 41.64,
  "t1": 46.56,
  "text": "失去了等待 障碍",
  "approx": false
 },
 {
  "t0": 46.56,
  "t1": 49.16,
  "text": "没了期待",
  "approx": false
 },
 {
  "t0": 49.16,
  "t1": 55.13,
  "text": "我们的爱怎么才自然",
  "approx": false
 },
 {
  "t0": 55.13,
  "t1": 60.42,
  "text": "每次沟通不来",
  "approx": false
 },
 {
  "t0": 60.42,
  "t1": 64.15,
  "text": "就要离开就说不要爱",
  "approx": false
 },
 {
  "t0": 64.15,
  "t1": 67.43,
  "text": "我掉进爱情悬崖",
  "approx": false
 },
 {
  "t0": 67.43,
  "t1": 70.81,
  "text": "跌太深爬不出来",
  "approx": false
 },
 {
  "t0": 70.81,
  "t1": 74.16,
  "text": "下降的速度太快",
  "approx": false
 },
 {
  "t0": 74.16,
  "t1": 77.37,
  "text": "来不及踏上未来",
  "approx": false
 },
 {
  "t0": 77.37,
  "t1": 80.92,
  "text": "你的爱反复徘徊",
  "approx": false
 },
 {
  "t0": 80.92,
  "t1": 86.04,
  "text": "打乱我呼吸节拍",
  "approx": false
 },
 {
  "t0": 86.04,
  "t1": 88.51,
  "text": "该怎么逃开",
  "approx": false
 },
 {
  "t0": 88.51,
  "t1": 91.09,
  "text": "我控制不来",
  "approx": false
 },
 {
  "t0": 91.09,
  "t1": 94.53,
  "text": "我掉进爱情悬崖",
  "approx": false
 },
 {
  "t0": 94.53,
  "t1": 97.66,
  "text": "回想起你的可爱",
  "approx": false
 },
 {
  "t0": 97.66,
  "t1": 100.42,
  "text": "傻傻地还在等待",
  "approx": false
 },
 {
  "t0": 100.42,
  "t1": 104.58,
  "text": "以为你还会回来",
  "approx": false
 },
 {
  "t0": 104.58,
  "t1": 108.01,
  "text": "你的脸慢慢离开",
  "approx": false
 },
 {
  "t0": 108.01,
  "t1": 113.38,
  "text": "时间快将我掩埋",
  "approx": false
 },
 {
  "t0": 113.38,
  "t1": 116.06,
  "text": "消失得太快",
  "approx": false
 },
 {
  "t0": 116.06,
  "t1": 132.36,
  "text": "我负荷不来",
  "approx": false
 },
