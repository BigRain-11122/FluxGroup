[
 {
  "t0": 37.76,
  "t1": 40.61,
  "text": "我听说通常在战争后就会换来和平",
  "approx": false
 },
 {
  "t0": 40.61,
  "t1": 43.85,
  "text": "为什么看到我的爸爸一直打我妈妈",
  "approx": false
 },
 {
  "t0": 43.85,
  "t1": 45.34,
  "text": "就因为喝醉酒",
  "approx": false
 },
 {
  "t0": 45.34,
  "t1": 47.36,
  "text": "他就能拿我妈出气",
  "approx": false
 },
 {
  "t0": 47.36,
  "t1": 48.91,
  "text": "我真的看不下去",
  "approx": false
 },
 {
  "t0": 48.91,
  "t1": 50.96,
  "text": "以为我较细汉",
  "approx": false
 },
 {
  "t0": 50.96,
  "t1": 53.38,
  "text": "从小到大只有妈妈的温暖",
  "approx": false
 },
 {
  "t0": 53.38,
  "t1": 56.7,
  "text": "为什么我爸爸那么凶",
  "approx": false
 },
 {
  "t0": 56.7,
  "t1": 58.61,
  "text": "如果真的我有一双翅膀",
  "approx": false
 },
 {
  "t0": 58.61,
  "t1": 60.29,
  "text": "两双翅膀随时出发",
  "approx": false
 },
 {
  "t0": 60.29,
  "t1": 63.47,
  "text": "偷偷出发我一定带我妈走",
  "approx": false
 },
 {
  "t0": 63.47,
  "t1": 64.42,
  "text": "从前的教育",
  "approx": false
 },
 {
  "t0": 64.42,
  "t1": 65.21,
  "text": "别人的家庭",
  "approx": false
 },
 {
  "t0": 65.21,
  "t1": 67.35,
  "text": "别人的爸爸种种的暴力因素",
  "approx": false
 },
 {
  "t0": 67.35,
  "t1": 69.06,
  "text": "一定都会有原因",
  "approx": false
 },
 {
  "t0": 69.06,
  "t1": 69.66,
  "text": "但是呢",
  "approx": false
 },
 {
  "t0": 69.66,
  "t1": 72.42,
  "text": "妈跟我都没有错亏我叫你一声爸",
  "approx": false
 },
 {
  "t0": 72.42,
  "t1": 76.18,
  "text": "爸我回来了",
  "approx": false
 },
 {
  "t0": 76.18,
  "t1": 82.39,
  "text": "不要再这样打我妈妈",
  "approx": false
 },
 {
  "t0": 82.39,
  "t1": 88.6,
  "text": "我说的话你甘会听",
  "approx": false
 },
 {
  "t0": 88.6,
  "t1": 94.9,
  "text": "不要再这样打我妈妈",
  "approx": false
 },
 {
  "t0": 94.9,
  "t1": 126.23,
  "text": "难道你手不会痛吗",
  "approx": false
 },
 {
  "t0": 126.23,
  "t1": 129.0,
  "text": "其实我回家就想要阻止一切",
  "approx": false
 },
 {
  "t0": 129.0,
  "t1": 130.52,
  "text": "让家庭回到过去甜甜",
  "approx": false
 },
 {
  "t0": 130.52,
  "t1": 132.25,
  "text": "温馨的欢乐香味",
  "approx": false
 },
 {
  "t0": 132.25,
  "t1": 134.44,
  "text": "虽然这是我编造出来的事实",
  "approx": false
 },
 {
  "t0": 134.44,
  "t1": 135.9,
  "text": "有点讽刺有点酸性",
  "approx": false
 },
 {
  "t0": 135.9,
  "t1": 138.63,
  "text": "但它却在这快乐社会发生产生共鸣",
  "approx": false
 },
 {
  "t0": 138.63,
  "t1": 140.51,
  "text": "产生共鸣来阻止一切暴力",
  "approx": false
 },
 {
  "t0": 140.51,
  "t1": 142.64,
  "text": "眼泪随着音符吸入血液情绪",
  "approx": false
 },
 {
  "t0": 142.64,
