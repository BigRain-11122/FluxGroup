   "text": "Zither Harp"
  },
  {
   "t0": 14.72,
   "t1": 20.37,
   "text": "難過是因為悶了很久"
  },
  {
   "t0": 20.52,
   "t1": 24.04,
   "text": "是因為傷了太多"
  },
  {
   "t0": 24.04,
   "t1": 29.08,
   "text": "是心裡起了作用"
  },
  {
   "t0": 30.44,
   "t1": 35.28,
   "text": "你說哭笑常常陪著你"
  },
  {
   "t0": 35.58,
   "t1": 38.92,
   "text": "在一起有點面前"
  },
  {
   "t0": 38.92,
   "t1": 43.62,
   "text": "該不該現在收穫"
  },
  {
   "t0": 43.62,
   "t1": 46.78,
   "text": "不想太多"
  },
  {
   "t0": 46.78,
   "t1": 49.46,
   "text": "我想一定是我"
  },
  {
   "t0": 49.46,
   "t1": 54.52,
   "text": "聽著能做高做白託"
  },
  {
   "t0": 54.52,
