[
 {
  "t0": 41.81,
  "t1": 44.44,
  "text": "全身纯白色的那雕像石膏",
  "approx": false
 },
 {
  "t0": 44.44,
  "t1": 46.8,
  "text": "颜色干净没有压力得很讨好",
  "approx": false
 },
 {
  "t0": 46.8,
  "t1": 49.38,
  "text": "我坐在客厅模仿雕像思考",
  "approx": false
 },
 {
  "t0": 49.38,
  "t1": 51.97,
  "text": "却仿佛听到同样想法的困扰",
  "approx": false
 },
 {
  "t0": 51.97,
  "t1": 54.33,
  "text": "针叶林树梢穿过绿色隧道",
  "approx": false
 },
 {
  "t0": 54.33,
  "t1": 55.51,
  "text": "一股神秘在敲",
  "approx": false
 },
 {
  "t0": 55.51,
  "t1": 59.25,
  "text": "我们都拥有着相同的大脑",
  "approx": false
 },
 {
  "t0": 59.25,
  "t1": 61.94,
  "text": "一样的嗜好",
  "approx": false
 },
 {
  "t0": 61.94,
  "t1": 64.56,
  "text": "门上流苏线条在摇晃炫耀",
  "approx": false
 },
 {
  "t0": 64.56,
  "t1": 66.89,
  "text": "但是如果没有风它也办不到",
  "approx": false
 },
 {
  "t0": 66.89,
  "t1": 69.5,
  "text": "我知道共同的默契很重要",
  "approx": false
 },
 {
  "t0": 69.5,
  "t1": 72.0,
  "text": "那骄傲才不会寂寞得很无聊",
  "approx": false
 },
 {
  "t0": 72.0,
  "t1": 74.32,
  "text": "画框的城堡很欧洲的情调",
  "approx": false
 },
 {
  "t0": 74.32,
  "t1": 75.63,
  "text": "对着这张海报",
  "approx": false
 },
 {
  "t0": 75.63,
  "t1": 80.6,
  "text": "我们在远距离欣赏与微笑",
  "approx": false
 },
 {
  "t0": 80.6,
  "t1": 82.06,
  "text": "一起来",
  "approx": false
 },
 {
  "t0": 82.06,
  "t1": 83.9,
  "text": "默契无法伪造",
  "approx": false
 },
 {
  "t0": 83.9,
  "t1": 86.41,
  "text": "我们同一种调调",
  "approx": false
 },
 {
  "t0": 86.41,
  "t1": 88.88,
  "text": "不关心天气预报",
  "approx": false
 },
 {
  "t0": 88.88,
  "t1": 91.27,
  "text": "因为那无关紧要",
  "approx": false
 },
 {
  "t0": 91.27,
  "t1": 93.95,
  "text": "想打球下大雨照跳",
  "approx": false
 },
 {
  "t0": 93.95,
  "t1": 96.45,
  "text": "只收看音乐频道",
  "approx": false
 },
 {
  "t0": 96.45,
  "t1": 99.61,
  "text": "渴望在天空一角 做记号",
  "approx": false
 },
 {
  "t0": 99.61,
  "t1": 101.48,
  "text": "那里蓝色最好",
  "approx": false
 },
 {
  "t0": 101.48,
  "t1": 103.98,
  "text": "我很了默契无法伪造",
  "approx": false
 },
 {
  "t0": 103.98,
  "t1": 106.47,
  "text": "我们同一种调调",
  "approx": false
 },
 {
  "t0": 106.47,
  "t1": 108.92,
  "text": "凡事要自己主导",
  "approx": false
 },
 {
