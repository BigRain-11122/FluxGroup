 "lines": [
  {
   "t0": 35.46,
   "t1": 35.94,
   "text": "Zither Harp"
  },
  {
   "t0": 39.4,
   "t1": 42.22,
   "text": "眼睛不要差量 借着我的模樣"
  },
  {
   "t0": 42.22,
   "t1": 44.94,
   "text": "表情不用太緊張 我是三年二半"
  },
  {
   "t0": 44.94,
   "t1": 47.04,
   "text": "我轉型單圈的側臉還蠻好看"
  },
  {
   "t0": 47.04,
   "t1": 48.94,
   "text": "黑白是洗手指數的地方"
  },
  {
   "t0": 48.94,
   "t1": 51.56,
   "text": "只是角色的陽光那顏色我不太喜歡"
  },
  {
   "t0": 51.56,
   "t1": 54.3,
   "text": "沒有操場的自然 會更比較漂亮"
  },
  {
   "t0": 54.3,
   "t1": 56.9,
   "text": "這都是在隔壁版還有考卷的答案"
  },
  {
   "t0": 56.9,
   "t1": 58.66,
   "text": "不剛好都不會算 沒關係"
  },
  {
   "t0": 58.66,
   "t1": 60.6,
   "text": "再繼續努力 沒關係"
  },
  {
   "t0": 61.12,
   "t1": 63.38,
   "text": "為什麼 上的事 取搜個囊"
  },
  {
   "t0": 63.38,
   "t1": 66.06,
   "text": "為什麼 拿線上保護子彈"
  },
  {
   "t0": 66.06,
   "t1": 68.7,
   "text": "為什麼 沒想過喜歡太胖"
  },
  {
   "t0": 69.34,
   "t1": 71.4,
   "text": "為什麼 不別人的手機在下"
  },
  {
   "t0": 71.4,
   "t1": 74.06,
   "text": "四上翻場就讓大方 自自足去平方"
  },
  {
   "t0": 74.06,
   "t1": 76.74,
   "text": "反手斷打再開 恆傻就是高級平方"
  },
  {
   "t0": 76.74,
   "t1": 79.42,
   "text": "為專輯張平方 心才輸空平方"
  },
  {
   "t0": 79.42,
   "t1": 82.04,
   "text": "對強不在 練習平方平方"
  },
  {
   "t0": 82.04,
   "t1": 85.36,
   "text": "跳平 跳平 跳平 跳平"
  },
  {
   "t0": 85.36,
   "t1": 87.4,
   "text": "不用問 一定有人向你挑戰"
  },
  {
   "t0": 87.4,
   "t1": 90.28,
   "text": "跳平 跳平 跳平 跳平"
  },
  {
   "t0": 90.28,
   "t1": 92.96,
   "text": "不用怕 告訴他們 誰是男子哈"
  },
  {
   "t0": 92.96,
   "t1": 95.86,
   "text": "跳平 跳平 跳平 跳平"
  },
  {
   "t0": 95.86,
   "t1": 98.16,
   "text": "我想問 我只想留一點汗"
  },
  {
   "t0": 98.16,
   "t1": 101.22,
   "text": "問問我自己 才能"
  },
  {
   "t0": 101.22,
   "t1": 103.8,
   "text": "你想說選擇對象更要大的操場"
  },
  {
   "t0": 103.8,
   "t1": 105.8,
   "text": "跳平 跳平 跳平 跳平"
  },
  {
   "t0": 106.4,
   "t1": 108.74,
   "text": "不用問 一定有人向你挑戰"
  },
  {
   "t0": 108.74,
