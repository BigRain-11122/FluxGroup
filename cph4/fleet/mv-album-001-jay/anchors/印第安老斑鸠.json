   "text": ""
  },
  {
   "t0": 131.48,
   "t1": 131.8,
   "text": "无从麻煩狗"
  },
  {
   "t0": 131.8,
   "t1": 135.3,
   "text": "无從麻煩狗"
  },
  {
   "t0": 135.3,
   "t1": 138.16,
   "text": "有在往旁"
  },
  {
   "t0": 138.16,
   "t1": 138.64,
   "text": "在小山"
  },
  {
   "t0": 138.64,
   "t1": 139.9,
   "text": "北北起的白鱿"
  },
  {
   "t0": 139.9,
   "t1": 140.52,
   "text": "一只唯一"
  },
  {
   "t0": 140.52,
   "t1": 141.04,
   "text": "换我"
  },
  {
   "t0": 141.04,
   "t1": 142.06,
   "text": "谁是神经病"
  },
  {
   "t0": 142.4,
   "t1": 143.26,
   "text": "我们是大年龄"
  },
  {
   "t0": 143.26,
   "t1": 143.8,
   "text": "有此个真正"
  },
  {
   "t0": 143.8,
   "t1": 145.02,
   "text": "像一个环我苦的大人"
  },
  {
   "t0": 145.02,
   "t1": 146.04,
   "text": "这故事告诉我一年"
  },
  {
   "t0": 146.04,
   "t1": 147.04,
   "text": "那真是还真下转"
  },
  {
   "t0": 147.04,
   "t1": 147.22,
   "text": "什么"
  },
  {
   "t0": 148.04,
   "t1": 148.68,
   "text": "怎么做"
  },
  {
   "t0": 148.68,
   "t1": 148.68,
   "text": ""
  },
  {
   "t0": 163.0,
   "t1": 167.28,
   "text": "在等待你 寄来的面 找的"
  },
  {
   "t0": 167.28,
   "t1": 170.42,
   "text": "哦 未来看着 这绝路的骨头"
  },
  {
   "t0": 170.42,
   "t1": 173.4,
   "text": "不一般 悬石顶着 铺肉"
  },
  {
   "t0": 173.4,
   "t1": 176.68,
   "text": "超远升 两只铃铛一牛"
  },
  {
   "t0": 176.68,
   "t1": 178.24,
   "text": "哦 再一大圈头"
  },
  {
   "t0": 178.24,
   "t1": 178.66,
   "text": "我 再一大圈头"
  },
  {
   "t0": 178.66,
   "t1": 178.66,
   "text": ""
  },
  {
   "t0": 178.66,
   "t1": 178.66,
   "text": ""
  },
