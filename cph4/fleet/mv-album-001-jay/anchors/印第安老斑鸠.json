 "lines": [
  {
   "t0": 60.84,
   "t1": 64.06,
   "text": "草原上了两只地的野牛"
  },
  {
   "t0": 64.06,
   "t1": 65.96,
   "text": "在远方剧毒"
  },
  {
   "t0": 65.96,
   "t1": 68.24,
   "text": "在一只北北起的白鱿"
  },
  {
   "t0": 68.24,
   "t1": 71.72,
   "text": "探队一次儿困的老板酒"
  },
  {
   "t0": 79.58,
   "t1": 81.22,
   "text": "我帮你买点"
  },
  {
   "t0": 81.22,
   "t1": 82.42,
   "text": "你也老板酒"
  },
  {
   "t0": 82.42,
   "t1": 83.5,
   "text": "对的闹不多"
  },
  {
   "t0": 83.5,
   "t1": 84.82,
   "text": "几点都没有"
  },
  {
   "t0": 84.82,
   "t1": 86.52,
   "text": "可谁也能过"
  },
  {
   "t0": 86.52,
   "t1": 88.7,
   "text": "脑袋刮有一点袖头"
  },
  {
   "t0": 88.7,
   "t1": 91.26,
   "text": "连我死了的鼻声都难过"
  },
  {
   "t0": 91.26,
   "t1": 92.62,
   "text": "你一定按板酒"
  },
  {
   "t0": 92.62,
   "t1": 93.76,
   "text": "回血冷开口"
  },
  {
   "t0": 93.76,
   "t1": 96.34,
   "text": "心冷脏怕熟悉恨折腾"
  },
  {
   "t0": 96.34,
   "t1": 99.24,
   "text": "这里什么奇怪的事都用"
  },
  {
   "t0": 99.24,
   "t1": 101.38,
   "text": "包括上毛的狗"
  },
  {
   "t0": 101.38,
   "t1": 102.86,
   "text": "你一定也老板酒"
  },
  {
   "t0": 102.86,
   "t1": 104.08,
   "text": "冰淨挖不动"
  },
  {
   "t0": 104.08,
   "t1": 105.4,
   "text": "除非是乌鸦"
  },
  {
   "t0": 105.4,
   "t1": 106.94,
   "text": "强热淡的火"
  },
  {
   "t0": 106.94,
   "t1": 108.16,
   "text": "淡在关键"
  },
  {
   "t0": 108.16,
   "t1": 109.2,
   "text": "无从麻煩狗"
  },
  {
   "t0": 109.2,
   "t1": 111.82,
   "text": "一直淋塌新衣的木板酒"
  },
  {
   "t0": 118.7,
   "t1": 118.7,
   "text": ""
  },
  {
   "t0": 118.7,
