   "t1": 178.66,
   "text": ""
  },
  {
   "t0": 178.66,
   "t1": 178.66,
   "text": ""
  },
  {
   "t0": 178.66,
   "t1": 180.68,
   "text": "再一次 别再去那大宇宙"
  },
  {
   "t0": 180.68,
   "t1": 183.68,
   "text": "再一次 二魂的老板"
  },
  {
   "t0": 183.68,
   "t1": 188.26,
   "text": "你等会 老板 去"
  },
  {
   "t0": 188.26,
   "t1": 190.88,
   "text": "印第安老板就 兜兜马不夺"
  },
  {
   "t0": 190.88,
   "t1": 193.84,
   "text": "今天都没有 更谁也能过"
  },
  {
   "t0": 193.84,
   "t1": 195.94,
   "text": "脑袋挂 用一点修度"
  },
  {
   "t0": 195.94,
   "t1": 198.62,
   "text": "连我死了的鼻屎都能过"
  },
  {
   "t0": 198.62,
   "t1": 200.1,
   "text": "印第安老板就"
  },
  {
   "t0": 200.5,
   "t1": 202.78,
   "text": "我休息一下 现在不怕休息"
  },
  {
   "t0": 202.78,
   "t1": 205.9,
   "text": "看着走 走什么奇怪的事"
  },
  {
   "t0": 205.9,
   "t1": 208.66,
   "text": "都由我抱过 天马的狗"
  },
  {
   "t0": 208.66,
   "t1": 211.38,
   "text": "印第安老板就 兜兜马不夺"
  },
  {
   "t0": 211.38,
   "t1": 214.24,
   "text": "除非是乌鸦 像了大灯火"
  },
  {
   "t0": 214.24,
   "t1": 216.58,
   "text": "打采关 目中的身够"
  },
  {
   "t0": 216.58,
   "t1": 217.84,
   "text": "印第安老板就"
  },
  {
   "t0": 217.84,
   "t1": 218.94,
   "text": "印第安老板就"
  },
  {
   "t0": 236.7,
   "t1": 237.74,
   "text": "你笑不一样"
  },
  {
   "t0": 237.74,
   "t1": 238.26,
   "text": "哈哈"
  },
  {
   "t0": 239.06,
   "t1": 241.94,
   "text": "印第安老板就 兜兜马不夺"
  },
  {
   "t0": 241.94,
   "t1": 244.88,
   "text": "今天都没有 更谁也能过"
  },
  {
   "t0": 244.88,
   "t1": 245.92,
   "text": "脑袋挂"
  },
  {
   "t0": 246.78,
   "t1": 249.62,
   "text": "阿雷我死了的鼻屎都能过"
  },
  {
   "t0": 249.62,
   "t1": 252.14,
   "text": "印第安老板就 回去让开口"
  },
  {
   "t0": 252.14,
   "t1": 254.74,
   "text": "现在不怕休息 看着走"
