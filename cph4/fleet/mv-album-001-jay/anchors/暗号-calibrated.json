[
 {
  "t0": 16.21,
  "t1": 20.02,
  "text": "我想要的 想做的 你比谁都了",
  "approx": false
 },
 {
  "t0": 20.02,
  "t1": 23.72,
  "text": "你想说的 想给的 我全都知道",
  "approx": false
 },
 {
  "t0": 23.72,
  "t1": 25.76,
  "text": "未接来电 没留言",
  "approx": false
 },
 {
  "t0": 25.76,
  "t1": 28.15,
  "text": "一定是你孤单的想念",
  "approx": false
 },
 {
  "t0": 28.15,
  "t1": 30.04,
  "text": "任何人都 猜不到",
  "approx": false
 },
 {
  "t0": 30.04,
  "t1": 31.97,
  "text": "这是我们的暗号",
  "approx": false
 },
 {
  "t0": 31.97,
  "t1": 35.28,
  "text": "他们猜 随便猜 不重要",
  "approx": false
 },
 {
  "t0": 35.28,
  "t1": 38.96,
  "text": "连上彼此的讯号 才有个依靠",
  "approx": false
 },
 {
  "t0": 38.96,
  "t1": 40.97,
  "text": "有太多人太多事",
  "approx": false
 },
 {
  "t0": 40.97,
  "t1": 43.33,
  "text": "夹在我们之间咆哮",
  "approx": false
 },
 {
  "t0": 43.33,
  "t1": 45.19,
  "text": "杂讯太多讯号弱",
  "approx": false
 },
 {
  "t0": 45.19,
  "t1": 47.44,
  "text": "就连风吹都要干扰",
  "approx": false
 },
 {
  "t0": 47.44,
  "t1": 54.21,
  "text": "可是你不想一直走在黑暗地下道",
  "approx": false
 },
 {
  "t0": 54.21,
  "t1": 58.13,
  "text": "想吹风 想自由 想要一起手牵手",
  "approx": false
 },
 {
  "t0": 58.13,
  "t1": 62.51,
  "text": "去看海 绕世界流浪",
  "approx": false
 },
 {
  "t0": 62.51,
  "t1": 70.07,
  "text": "我害怕你心碎没人帮你擦眼泪",
  "approx": false
 },
 {
  "t0": 70.07,
  "t1": 77.72,
  "text": "别管那是非 只要我们感觉对",
  "approx": false
 },
 {
  "t0": 77.72,
  "t1": 85.27,
  "text": "我害怕你心碎没人帮你擦眼泪",
  "approx": false
 },
 {
  "t0": 85.27,
  "t1": 88.63,
  "text": "别离开身边",
  "approx": false
 },
 {
  "t0": 88.63,
  "t1": 108.29,
  "text": "拥有你我的世界才能完美",
  "approx": false
 },
