 "lines": [
  {
   "t0": 9.72,
   "t1": 11.6,
   "text": "作曲 李宗盛"
  },
  {
   "t0": 11.6,
   "t1": 16.96,
   "text": "你说我想一个小孩"
  },
  {
   "t0": 18.7,
   "t1": 22.62,
   "text": "总来让你猜"
  },
  {
   "t0": 23.62,
   "t1": 30.48,
   "text": "我说你才像个小孩"
  },
  {
   "t0": 31.62,
   "t1": 37.38,
   "text": "总要我说才明白"
  },
  {
   "t0": 37.38,
   "t1": 41.0,
   "text": "有些现在快"
  },
  {
   "t0": 41.0,
   "t1": 44.24,
   "text": "失去了等待"
  },
  {
   "t0": 44.68,
   "t1": 48.6,
   "text": "等待 没了期待"
  },
  {
   "t0": 48.6,
   "t1": 54.56,
   "text": "我们的爱怎么才自然"
  },
  {
   "t0": 54.56,
   "t1": 59.32,
   "text": "每一次都痛不来"
  },
  {
   "t0": 59.32,
   "t1": 63.82,
   "text": "就要离开就说不要爱"
  },
  {
   "t0": 63.82,
   "t1": 67.14,
   "text": "我掉进爱情深夜"
  },
  {
   "t0": 67.14,
   "t1": 70.46,
   "text": "别太想爬不出来"
  },
  {
   "t0": 70.46,
   "t1": 73.92,
   "text": "下站的速度太快"
  },
  {
   "t0": 73.92,
   "t1": 77.36,
   "text": "来不及他送回来"
  },
  {
   "t0": 77.36,
   "t1": 80.64,
   "text": "你的爱反复百怀"
  },
  {
   "t0": 80.64,
   "t1": 85.04,
   "text": "打乱我腐气渐回"
  },
  {
   "t0": 85.04,
   "t1": 88.48,
   "text": "该怎么逃开"
  },
  {
   "t0": 88.48,
   "t1": 90.82,
   "text": "我空气不来"
  },
  {
   "t0": 90.82,
   "t1": 94.18,
   "text": "我掉进爱情深夜"
  },
  {
   "t0": 94.18,
   "t1": 97.6,
   "text": "会相信你的可爱"
  },
  {
   "t0": 97.6,
   "t1": 101.06,
   "text": "傻傻的还在等他"
  },
  {
   "t0": 101.06,
   "t1": 104.38,
   "text": "以为你还会回来"
  },
  {
   "t0": 104.38,
   "t1": 107.78,
   "text": "你的脸慢慢离开"
  },
  {
   "t0": 107.78,
   "t1": 112.08,
   "text": "世界快将我掩埋"
  },
  {
   "t0": 112.08,
   "t1": 115.54,
   "text": "像是的太快"
  },
  {
   "t0": 115.54,
   "t1": 118.06,
   "text": "我符合不来"
  },
  {
