[
 {
  "t0": 40.28,
  "t1": 44.23,
  "text": "机枪扫射声中我们寻找遮蔽的战壕",
  "approx": false
 },
 {
  "t0": 44.23,
  "t1": 48.25,
  "text": "儿时沙雕的城堡毁坏了重新盖就好",
  "approx": false
 },
 {
  "t0": 48.25,
  "t1": 52.3,
  "text": "可是你那件染血布满弹孔的军外套",
  "approx": false
 },
 {
  "t0": 52.3,
  "t1": 56.84,
  "text": "却就连祷告手都举不好",
  "approx": false
 },
 {
  "t0": 56.84,
  "t1": 60.32,
  "text": "在硝烟中想起冰棒汽水的味道",
  "approx": false
 },
 {
  "t0": 60.32,
  "t1": 64.42,
  "text": "和那些无所事事一整个夏天的年少",
  "approx": false
 },
 {
  "t0": 64.42,
  "t1": 68.4,
  "text": "我放下枪回忆去年一起毕业的学校",
  "approx": false
 },
 {
  "t0": 68.4,
  "t1": 73.96,
  "text": "而眼泪 一直都忘记要掉",
  "approx": false
 },
 {
  "t0": 73.96,
  "t1": 82.13,
  "text": "嘲笑的声音在风中不断被练习",
  "approx": false
 },
 {
  "t0": 82.13,
  "t1": 88.12,
  "text": "这树林间充满了敌意",
  "approx": false
 },
 {
  "t0": 88.12,
  "t1": 95.85,
  "text": "部队弃守阵地你坚持要我也离去",
  "approx": false
 },
 {
  "t0": 95.85,
  "t1": 101.69,
  "text": "我怎么能放弃",
  "approx": false
 },
 {
  "t0": 101.69,
  "t1": 103.63,
  "text": "我留着陪你",
  "approx": false
 },
 {
  "t0": 103.63,
  "t1": 105.55,
  "text": "强忍着泪滴",
  "approx": false
 },
 {
  "t0": 105.55,
  "t1": 109.57,
  "text": "有些事真的来不及回不去",
  "approx": false
 },
 {
  "t0": 109.57,
  "t1": 111.51,
  "text": "你脸在抽搐",
  "approx": false
 },
 {
  "t0": 111.51,
  "t1": 113.41,
  "text": "就快没力气",
  "approx": false
 },
 {
  "t0": 113.41,
  "t1": 117.8,
  "text": "家乡事不准我再提",
  "approx": false
 },
 {
  "t0": 117.8,
  "t1": 119.69,
  "text": "我留着陪你",
  "approx": false
 },
 {
  "t0": 119.69,
  "t1": 121.77,
  "text": "最后的距离",
  "approx": false
 },
 {
  "t0": 121.77,
  "t1": 125.74,
  "text": "是你的侧脸倒在我的怀里",
  "approx": false
 },
 {
  "t0": 125.74,
  "t1": 127.64,
  "text": "你慢慢睡去",
  "approx": false
 },
 {
  "t0": 127.64,
  "t1": 129.67,
  "text": "我摇不醒你",
  "approx": false
 },
 {
  "t0": 129.67,
  "t1": 135.91,
  "text": "泪水在战壕里 决了堤",
  "approx": false
 },
 {
  "t0": 135.91,
  "t1": 149.67,
  "text": "Yeah",
  "approx": false
 },
