 "lines": [
  {
   "t0": 7.78,
   "t1": 8.18,
   "text": "作曲 李宗盛"
  },
  {
   "t0": 20.92,
   "t1": 23.12,
   "text": "找我一個人 尋找出你"
  },
  {
   "t0": 23.12,
   "t1": 25.08,
   "text": "留我的出口 想發現來我"
  },
  {
   "t0": 25.08,
   "t1": 28.2,
   "text": "只能說真的好感 倒好想準備的真正的"
  },
  {
   "t0": 28.2,
   "t1": 30.52,
   "text": "我從天等就行 讓你一塊鐘的喝水"
  },
  {
   "t0": 30.52,
   "t1": 31.98,
   "text": "無法再穩定 請倒下"
  },
  {
   "t0": 31.98,
   "t1": 34.0,
   "text": "走大的手靈啊 奔到看到不少"
  },
  {
   "t0": 34.0,
   "t1": 36.74,
   "text": "往往的影子 從那裡影就看到發露的我"
  },
  {
   "t0": 36.74,
   "t1": 38.58,
   "text": "是Number Chorot 與世間的記憶"
  },
  {
   "t0": 38.58,
   "t1": 40.08,
   "text": "正大拉底 路路路路"
  },
  {
   "t0": 40.08,
   "t1": 41.9,
   "text": "你心之間 還可以看見同時的魔鬼"
  },
  {
   "t0": 41.9,
   "t1": 43.86,
   "text": "讓今夜往空之長的眼裡瘋了"
  },
  {
   "t0": 43.86,
   "t1": 45.24,
   "text": "進去才能存活下來"
  },
  {
   "t0": 45.24,
   "t1": 46.1,
   "text": "花開"
  },
  {
   "t0": 46.1,
   "t1": 48.2,
   "text": "或是用來演中彼得黑色情緒"
  },
  {
   "t0": 48.2,
   "t1": 48.76,
   "text": "抓捧"
  },
  {
   "t0": 48.76,
   "t1": 50.86,
   "text": "我後衛當時沒有想的肯定"
  },
  {
   "t0": 50.86,
   "t1": 51.46,
   "text": "抓捧"
  },
  {
   "t0": 51.46,
   "t1": 52.76,
   "text": "我代表很多苦"
  },
  {
