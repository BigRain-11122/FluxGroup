 "lines": [
  {
   "t0": 30.0,
   "t1": 32.16,
   "text": "在屋内还弥漫"
  },
  {
   "t0": 32.16,
   "t1": 36.14,
   "text": "老老当年亮的都傍角"
  },
  {
   "t0": 36.14,
   "t1": 40.42,
   "text": "我对着黑白照片开始想象"
  },
  {
   "t0": 40.42,
   "t1": 44.48,
   "text": "把个妈当年的模样"
  },
  {
   "t0": 45.42,
   "t1": 49.5,
   "text": "说他没一个无奈的女儿"
  },
  {
   "t0": 49.5,
   "t1": 51.86,
   "text": "光光走过外側"
  },
  {
   "t0": 53.6,
   "t1": 57.78,
   "text": "消失的就是光 依旧是山"
  },
  {
   "t0": 57.78,
   "t1": 62.44,
   "text": "在回忆的路上时间变好吗"
  },
  {
   "t0": 62.44,
   "t1": 66.72,
   "text": "到街坊消弄 当时属于那年代"
  },
  {
   "t0": 66.72,
   "t1": 70.14,
   "text": "白角给我的淡淡的忧伤"
  },
  {
   "t0": 70.14,
   "t1": 74.3,
   "text": "走失的就是光 依旧是山"
  },
  {
   "t0": 74.3,
   "t1": 78.76,
   "text": "回头看的片段有一些风霜"
  },
  {
   "t0": 78.76,
   "t1": 82.5,
   "text": "到长半就比 像种满了比"
  },
  {
   "t0": 82.5,
   "t1": 86.72,
   "text": "心边的天和你 照着一边玫瑰"
  },
  {
   "t0": 86.72,
   "t1": 87.96,
   "text": "我说"
  },
  {
   "t0": 102.94,
   "t1": 107.44,
   "text": "红金哥泡满了调花的门窗"
  },
  {
   "t0": 107.44,
   "t1": 111.54,
   "text": "夕阳写写印在半步的端脚"
  },
  {
   "t0": 111.54,
   "t1": 115.64,
   "text": "铺着举木板的屋内还弥漫"
