 "lines": [
  {
   "t0": 3.86,
   "t1": 5.28,
   "text": "Zither Harp"
  },
  {
   "t0": 32.78,
   "t1": 33.5,
   "text": "Zither Harp"
  },
  {
   "t0": 45.32,
   "t1": 48.12,
   "text": "你你某某你鬼点某"
  },
  {
   "t0": 48.12,
   "t1": 50.54,
   "text": "出现了我一刀痛"
  },
  {
   "t0": 50.54,
   "t1": 53.5,
   "text": "怎么可能你都没空说"
  },
  {
   "t0": 53.5,
   "t1": 55.52,
   "text": "我不懂说了没"
  },
  {
   "t0": 55.52,
   "t1": 58.3,
   "text": "他的笑容和不懂"
  },
  {
   "t0": 58.3,
   "t1": 60.68,
   "text": "在意境中还不再受处"
  },
  {
   "t0": 61.04,
   "t1": 63.34,
   "text": "我的天空是与时光"
  },
  {
   "t0": 63.34,
   "t1": 65.78,
   "text": "还是才有你的操作"
  },
  {
   "t0": 66.3,
   "t1": 68.78,
   "text": "人间即见的迷茸"
  },
  {
   "t0": 68.78,
   "t1": 71.08,
   "text": "只需解冻你"
  },
  {
   "t0": 71.08,
   "t1": 73.32,
   "text": "一个心到现在"
  },
  {
   "t0": 73.32,
   "t1": 75.18,
   "text": "爱的抽筒"
  },
  {
   "t0": 76.02,
   "t1": 78.64,
   "text": "还未夺出了解"
  },
  {
   "t0": 78.64,
   "t1": 81.56,
   "text": "拿去抱紧再感动"
  },
  {
   "t0": 81.56,
   "t1": 81.82,
   "text": "Oh"
  },
  {
   "t0": 86.34,
   "t1": 91.18,
   "text": "穿上世界的晚霧的钟"
  },
  {
   "t0": 91.18,
   "t1": 95.88,
   "text": "走到横向开始移动"
  },
  {
   "t0": 96.48,
   "t1": 100.98,
   "text": "回到当初爱你的时候"
  },
  {
   "t0": 101.56,
   "t1": 104.26,
   "text": "听得没动静"
  },
  {
   "t0": 106.36,
   "t1": 108.88,
   "text": "所有的意义"
  },
  {
   "t0": 108.88,
   "t1": 111.32,
   "text": "也都和我一共"
  },
  {
   "t0": 111.32,
   "t1": 115.9,
   "text": "我的伤口也不再过"
  },
  {
   "t0": 115.9,
   "t1": 119.16,
   "text": "是人在真一路"
  },
  {
   "t0": 119.16,
   "t1": 121.2,
   "text": "累得不懂"
  },
  {
   "t0": 121.98,
   "t1": 125.36,
   "text": "累上手有时空"
  },
  {
   "t0": 137.2,
   "t1": 138.64,
   "text": "真的有不忍耽诺"
  },
  {
   "t0": 138.64,
   "t1": 140.38,
   "text": "你跟我过去从头上"
  },
  {
   "t0": 140.38,
   "t1": 141.46,
   "text": "沧沧不敢去过"
  },
  {
   "t0": 141.46,
   "t1": 143.18,
