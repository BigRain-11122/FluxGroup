[
 {
  "t0": 17.28,
  "t1": 19.38,
  "text": "文山啊等你写完词",
  "approx": false
 },
 {
  "t0": 19.38,
  "t1": 21.06,
  "text": "我都出下张专辑喽",
  "approx": false
 },
 {
  "t0": 21.06,
  "t1": 22.71,
  "text": "没关系慢慢来",
  "approx": false
 },
 {
  "t0": 22.71,
  "t1": 24.54,
  "text": "这首歌我自己来",
  "approx": false
 },
 {
  "t0": 24.54,
  "t1": 25.82,
  "text": "说到中学时期",
  "approx": false
 },
 {
  "t0": 25.82,
  "t1": 27.95,
  "text": "家乡的一片片片梯田",
  "approx": false
 },
 {
  "t0": 27.95,
  "t1": 30.32,
  "text": "是我看过最美的绿地",
  "approx": false
 },
 {
  "t0": 30.32,
  "t1": 33.13,
  "text": "于是也因此让我得了最佳摄影",
  "approx": false
 },
 {
  "t0": 33.13,
  "t1": 35.33,
  "text": "莫名其妙在画面中的我",
  "approx": false
 },
 {
  "t0": 35.33,
  "t1": 37.11,
  "text": "不会写词都像个诗人",
  "approx": false
 },
 {
  "t0": 37.11,
  "t1": 39.07,
  "text": "坐着公车上学的我",
  "approx": false
 },
 {
  "t0": 39.07,
  "t1": 40.74,
  "text": "看着窗外的牛啃草",
  "approx": false
 },
 {
  "t0": 40.74,
  "t1": 43.66,
  "text": "是一种说不出的自由自在",
  "approx": false
 },
 {
  "t0": 43.66,
  "t1": 48.2,
  "text": "Hoi Ya Yi Ya那鲁湾",
  "approx": false
 },
 {
  "t0": 48.2,
  "t1": 50.52,
  "text": "Na Yi Na Ya Hei",
  "approx": false
 },
 {
  "t0": 50.52,
  "t1": 56.66,
  "text": "我亲爱的牛儿啊",
  "approx": false
 },
 {
  "t0": 56.66,
  "t1": 60.94,
  "text": "Hoi Ya Yi Ya那鲁湾",
  "approx": false
 },
 {
  "t0": 60.94,
  "t1": 64.43,
  "text": "Na Yi Na Ya Hei",
  "approx": false
 },
 {
  "t0": 64.43,
  "t1": 69.42,
  "text": "跑到哪儿去了",
  "approx": false
 },
 {
  "t0": 69.42,
  "t1": 70.92,
  "text": "面店旁的小水沟",
  "approx": false
 },
 {
  "t0": 70.92,
  "t1": 72.57,
  "text": "留着我们长大的梦",
  "approx": false
 },
 {
  "t0": 72.57,
  "t1": 74.72,
  "text": "绕过天真跳至收割期",
  "approx": false
 },
 {
  "t0": 74.72,
  "t1": 77.39,
  "text": "人们的汗水夹杂着满足与欢笑",
  "approx": false
 },
 {
  "t0": 77.39,
  "t1": 79.65,
  "text": "是我现在最舍不得的画面",
  "approx": false
 },
 {
  "t0": 79.65,
  "t1": 82.51,
  "text": "也是我另一项参展作品",
  "approx": false
 },
 {
  "t0": 82.51,
  "t1": 83.39,
  "text": "靠着回忆",
  "approx": false
 },
 {
  "t0": 83.39,
  "t1": 84.15,
  "text": "画成油画",
  "approx": false
 },
 {
  "t0": 84.15,
  "t1": 84.89,
  "text": "拿到奖状",
  "approx": false
 },
 {
  "t0": 84.89,
  "t1": 85.69,
  "text": "有个啥用",
  "approx": false
 },
 {
  "t0": 85.69,
  "t1": 87.66,
  "text": "鼓励你多去回忆是吧",
  "approx": false
 },
 {
  "t0": 87.66,
  "t1": 90.54,
  "text": "哼我真想撕掉换回自然",
  "approx": false
 },
 {
  "t0": 90.54,
  "t1": 92.9,
  "text": "怎么梯田不见多了几家饭店",
  "approx": false
 },
 {
  "t0": 92.9,
  "t1": 94.83,
  "text": "坐在里面看着西洋片",
  "approx": false
 },
 {
  "t0": 94.83,
  "t1": 98.15,
  "text": "几只水牛却变成画挂在墙壁上",
  "approx": false
 },
 {
  "t0": 98.15,
  "t1": 100.23,
  "text": "象征人们蒸蒸日上",
  "approx": false
 },
 {
  "t0": 100.23,
  "t1": 102.17,
  "text": "一堆游客偶尔想看看",
  "approx": false
 },
 {
  "t0": 102.17,
  "t1": 103.69,
  "text": "窗外的观光景点",
  "approx": false
 },
 {
  "t0": 103.69,
  "t1": 104.63,
  "text": "但只看到",
  "approx": false
 },
 {
  "t0": 104.63,
  "t1": 107.51,
  "text": "比你住的再高一层的饭店",
  "approx": false
 },
 {
  "t0": 107.51,
  "t1": 112.02,
  "text": "Hoi Ya Yi Ya那鲁湾",
  "approx": false
 },
 {
  "t0": 112.02,
  "t1": 114.21,
  "text": "Na Yi Na Ya Hei",
  "approx": false
 },
 {
  "t0": 114.21,
  "t1": 120.32,
  "text": "我亲爱的牛儿啊",
  "approx": false
 },
 {
  "t0": 120.32,
  "t1": 124.4,
  "text": "Hoi Ya Yi Ya那鲁湾",
  "approx": false
 },
 {
  "t0": 124.4,
  "t1": 128.24,
  "text": "Na Yi Na Ya Hei",
  "approx": false
 },
 {
  "t0": 128.24,
  "t1": 145.76,
  "text": "跑到哪儿去了",
  "approx": false
 },
 {
  "t0": 145.76,
  "t1": 147.44,
  "text": "因地制宜综合利用",
  "approx": false
 },
 {
  "t0": 147.44,
  "t1": 149.02,
  "text": "利用对还是不对",
  "approx": false
 },
 {
  "t0": 149.02,
  "t1": 150.88,
  "text": "自私的人类狼不狼狈",
  "approx": false
 },
 {
  "t0": 150.88,
  "t1": 153.69,
  "text": "破坏自然的生态会不会很累",
  "approx": false
 },
 {
  "t0": 153.69,
  "t1": 156.69,
  "text": "你说为了艺术要砍下一棵树",
  "approx": false
 },
 {
  "t0": 156.69,
  "t1": 158.4,
  "text": "这样对还是不对",
  "approx": false
 },
 {
  "t0": 158.4,
  "t1": 161.37,
  "text": "你说为了装饰请问干我啥事",
  "approx": false
 },
 {
  "t0": 161.37,
  "t1": 164.62,
  "text": "是不是只能用相机纪录自然",
  "approx": false
 },
 {
  "t0": 164.62,
  "t1": 167.13,
  "text": "拿相片给下一代给下一代回味",
  "approx": false
 },
 {
  "t0": 167.13,
  "t1": 168.4,
  "text": "可怜可悲",
  "approx": false
 },
 {
  "t0": 168.4,
  "t1": 171.05,
  "text": "森林绿地都已成纪录片",
  "approx": false
 },
 {
  "t0": 171.05,
  "t1": 172.51,
  "text": "闻不到绿意盎然",
  "approx": false
 },
 {
  "t0": 172.51,
  "t1": 174.09,
  "text": "只享受到乌烟瘴气",
  "approx": false
 },
 {
  "t0": 174.09,
  "t1": 175.65,
  "text": "我不能教育你们",
  "approx": false
 },
 {
  "t0": 175.65,
  "t1": 177.1,
  "text": "我不是你们的老师",
  "approx": false
 },
 {
  "t0": 177.1,
  "t1": 178.83,
  "text": "我不是校长",
  "approx": false
 },
 {
  "t0": 178.83,
  "t1": 180.57,
  "text": "也不能给你们一巴掌",
  "approx": false
 },
 {
  "t0": 180.57,
  "t1": 182.12,
  "text": "掌掌掌掌掌掌掌",
  "approx": false
 },
 {
  "t0": 182.12,
  "t1": 184.1,
  "text": "长长长长长长篇大论",
  "approx": false
 },
 {
  "t0": 184.1,
  "t1": 185.28,
  "text": "你们并不想听",
  "approx": false
 },
 {
  "t0": 185.28,
  "t1": 186.93,
  "text": "我知道但我没办法",
  "approx": false
 },
 {
  "t0": 186.93,
  "t1": 188.14,
  "text": "我就是要写",
  "approx": false
 },
 {
  "t0": 188.14,
  "t1": 190.08,
  "text": "你们可能永远不能体会",
  "approx": false
 },
 {
  "t0": 190.08,
  "t1": 191.86,
  "text": "显微镜底下的我们",
  "approx": false
 },
 {
  "t0": 191.86,
  "t1": 193.46,
  "text": "会更现实更自私",
  "approx": false
 },
 {
  "t0": 193.46,
  "t1": 196.46,
  "text": "这种艺术真的很难领悟",
  "approx": false
 }
]