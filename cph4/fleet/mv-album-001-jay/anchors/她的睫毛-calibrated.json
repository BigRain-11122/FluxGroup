[
 {
  "t0": 19.95,
  "t1": 23.42,
  "text": "亲爱的总有些事没办法教",
  "approx": false
 },
 {
  "t0": 23.42,
  "t1": 26.63,
  "text": "表错情的感觉有一点糟",
  "approx": false
 },
 {
  "t0": 26.63,
  "t1": 29.93,
  "text": "赖着不走会让人很感冒",
  "approx": false
 },
 {
  "t0": 29.93,
  "t1": 32.97,
  "text": "以上这道理我全都了",
  "approx": false
 },
 {
  "t0": 32.97,
  "t1": 36.06,
  "text": "我将不该犯的错都默背好",
  "approx": false
 },
 {
  "t0": 36.06,
  "t1": 39.59,
  "text": "仔细观察她的喜好",
  "approx": false
 },
 {
  "t0": 39.59,
  "t1": 41.18,
  "text": "而我紧绷的外表",
  "approx": false
 },
 {
  "t0": 41.18,
  "t1": 42.72,
  "text": "像上紧后的发条",
  "approx": false
 },
 {
  "t0": 42.72,
  "t1": 45.65,
  "text": "等她的答案揭晓",
  "approx": false
 },
 {
  "t0": 45.65,
  "t1": 48.79,
  "text": "她的睫毛 弯的嘴角",
  "approx": false
 },
 {
  "t0": 48.79,
  "t1": 52.0,
  "text": "无预警地对我笑",
  "approx": false
 },
 {
  "t0": 52.0,
  "t1": 55.09,
  "text": "没有预兆出乎意料",
  "approx": false
 },
 {
  "t0": 55.09,
  "t1": 58.27,
  "text": "竟然先对我示好",
  "approx": false
 },
 {
  "t0": 58.27,
  "t1": 61.38,
  "text": "她的睫毛弯的嘴角",
  "approx": false
 },
 {
  "t0": 61.38,
  "t1": 64.59,
  "text": "用眼神对我拍照",
  "approx": false
 },
 {
  "t0": 64.59,
  "t1": 67.77,
  "text": "我戒不掉她的微笑",
  "approx": false
 },
 {
  "t0": 67.77,
  "t1": 71.32,
  "text": "洋溢幸福的味道",
  "approx": false
 },
 {
  "t0": 71.32,
  "t1": 73.97,
  "text": "有些事没办法教",
  "approx": false
 },
 {
  "t0": 73.97,
  "t1": 77.3,
  "text": "表错情的感觉有一点糟",
  "approx": false
 },
 {
  "t0": 77.3,
  "t1": 80.2,
  "text": "赖着不走会让人很感冒",
  "approx": false
 },
 {
  "t0": 80.2,
  "t1": 83.45,
  "text": "以上这道理我全都了",
  "approx": false
 },
 {
  "t0": 83.45,
  "t1": 86.51,
  "text": "恋爱的方式无法拿笔来抄",
  "approx": false
 },
 {
  "t0": 86.51,
  "t1": 90.08,
  "text": "也没有规则可以取巧",
  "approx": false
 },
 {
  "t0": 90.08,
  "t1": 92.98,
  "text": "被动的缘分很不可靠",
  "approx": false
 },
 {
  "t0": 92.98,
  "t1": 96.29,
  "text": "喜欢的对象要自己挑",
  "approx": false
 },
 {
  "t0": 96.29,
  "t1": 98.8,
  "text": "她粉嫩清秀的外表",
  "approx": false
 },
 {
  "t0": 98.8,
  "t1": 102.46,
  "text": "像是多汁的水蜜桃谁都想咬",
  "approx": false
 },
 {
  "t0": 102.46,
  "t1": 105.07,
  "text": "她嘴上亮丽的唇膏",
  "approx": false
 },
 {
  "t0": 105.07,
  "t1": 108.76,
  "text": "有一股自信的骄傲我看得到",
  "approx": false
 },
