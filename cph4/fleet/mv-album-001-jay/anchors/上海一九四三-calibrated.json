[
 {
  "t0": 3.45,
  "t1": 7.49,
  "text": "泛黄的春联还残留在墙上",
  "approx": false
 },
 {
  "t0": 7.49,
  "t1": 11.58,
  "text": "依稀可见几个字岁岁平安",
  "approx": false
 },
 {
  "t0": 11.58,
  "t1": 15.76,
  "text": "在我没有回去过的老家米缸",
  "approx": false
 },
 {
  "t0": 15.76,
  "t1": 19.84,
  "text": "爷爷用楷书写一个满",
  "approx": false
 },
 {
  "t0": 19.84,
  "t1": 24.0,
  "text": "黄金葛爬满了雕花的门窗",
  "approx": false
 },
 {
  "t0": 24.0,
  "t1": 28.09,
  "text": "夕阳斜斜映在斑驳的砖墙",
  "approx": false
 },
 {
  "t0": 28.09,
  "t1": 32.26,
  "text": "铺着榉木板的屋内还弥漫",
  "approx": false
 },
 {
  "t0": 32.26,
  "t1": 36.65,
  "text": "姥姥当年酿的豆瓣酱",
  "approx": false
 },
 {
  "t0": 36.65,
  "t1": 40.62,
  "text": "我对着黑白照片开始想象",
  "approx": false
 },
 {
  "t0": 40.62,
  "t1": 45.84,
  "text": "爸和妈当年的模样",
  "approx": false
 },
 {
  "t0": 45.84,
  "t1": 49.55,
  "text": "说着一口吴侬软语的姑娘",
  "approx": false
 },
 {
  "t0": 49.55,
  "t1": 54.12,
  "text": "缓缓走过外滩",
  "approx": false
 },
 {
  "t0": 54.12,
  "t1": 56.4,
  "text": "消失的旧时光",
  "approx": false
 },
 {
  "t0": 56.4,
  "t1": 58.22,
  "text": "一九四三",
  "approx": false
 },
 {
  "t0": 58.22,
  "t1": 60.45,
  "text": "在回忆的路上",
  "approx": false
 },
 {
  "t0": 60.45,
  "t1": 62.53,
  "text": "时间变好慢",
  "approx": false
 },
 {
  "t0": 62.53,
  "t1": 64.69,
  "text": "老街坊 小弄堂",
  "approx": false
 },
 {
  "t0": 64.69,
  "t1": 68.48,
  "text": "是属于那年代白墙黑瓦的",
  "approx": false
 },
 {
  "t0": 68.48,
  "t1": 70.58,
  "text": "淡淡的忧伤",
  "approx": false
 },
 {
  "t0": 70.58,
  "t1": 73.01,
  "text": "消失的旧时光",
  "approx": false
 },
 {
  "t0": 73.01,
  "t1": 74.76,
  "text": "一九四三",
  "approx": false
 },
 {
  "t0": 74.76,
  "t1": 77.1,
  "text": "回头看的片段",
  "approx": false
 },
 {
  "t0": 77.1,
  "t1": 79.15,
  "text": "有一些风霜",
  "approx": false
 },
 {
  "t0": 79.15,
  "t1": 81.24,
  "text": "老唱盘 旧皮箱",
  "approx": false
 },
 {
  "t0": 81.24,
  "t1": 84.69,
  "text": "装满了明信片的铁盒里",
  "approx": false
 },
 {
  "t0": 84.69,
  "t1": 103.86,
  "text": "藏着一片玫瑰花瓣",
  "approx": false
 },
