[
 {
  "t0": 19.15,
  "t1": 22.9,
  "text": "有谁能比我知道",
  "approx": false
 },
 {
  "t0": 22.9,
  "t1": 27.15,
  "text": "你的温柔像羽毛",
  "approx": false
 },
 {
  "t0": 27.15,
  "t1": 31.2,
  "text": "秘密躺在我怀抱",
  "approx": false
 },
 {
  "t0": 31.2,
  "t1": 35.37,
  "text": "只有你能听得到",
  "approx": false
 },
 {
  "t0": 35.37,
  "t1": 39.61,
  "text": "还有没有人知道",
  "approx": false
 },
 {
  "t0": 39.61,
  "t1": 43.85,
  "text": "你的微笑像拥抱",
  "approx": false
 },
 {
  "t0": 43.85,
  "t1": 47.87,
  "text": "多想藏着你的好",
  "approx": false
 },
 {
  "t0": 47.87,
  "t1": 51.48,
  "text": "只有我看得到",
  "approx": false
 },
 {
  "t0": 51.48,
  "t1": 55.22,
  "text": "站在屋顶只对风说",
  "approx": false
 },
 {
  "t0": 55.22,
  "t1": 59.17,
  "text": "不想被左右",
  "approx": false
 },
 {
  "t0": 59.17,
  "t1": 63.35,
  "text": "本来讨厌下雨的天空",
  "approx": false
 },
 {
  "t0": 63.35,
  "t1": 68.17,
  "text": "直到听见有人说爱我",
  "approx": false
 },
 {
  "t0": 68.17,
  "t1": 71.92,
  "text": "坐在电影院的二楼",
  "approx": false
 },
 {
  "t0": 71.92,
  "t1": 75.69,
  "text": "看人群走过",
  "approx": false
 },
 {
  "t0": 75.69,
  "t1": 79.76,
  "text": "怎么那一天的我们",
  "approx": false
 },
 {
  "t0": 79.76,
  "t1": 84.8,
  "text": "都默默的微笑很久",
  "approx": false
 },
 {
  "t0": 84.8,
  "t1": 89.26,
  "text": "我想我是太过依赖",
  "approx": false
 },
 {
  "t0": 89.26,
  "t1": 93.4,
  "text": "在挂电话的刚才",
  "approx": false
 },
 {
  "t0": 93.4,
  "t1": 97.56,
  "text": "坚持学单纯的小孩",
  "approx": false
 },
 {
  "t0": 97.56,
  "t1": 101.68,
  "text": "静静看守这份爱",
  "approx": false
 },
 {
  "t0": 101.68,
  "t1": 105.8,
  "text": "知道不能太依赖",
  "approx": false
 },
 {
  "t0": 105.8,
  "t1": 109.85,
  "text": "怕你会把我宠坏",
  "approx": false
 },
 {
  "t0": 109.85,
  "t1": 114.93,
  "text": "你的香味一直徘徊",
  "approx": false
 },
 {
  "t0": 114.93,
  "t1": 120.19,
  "text": "我舍不得离开",
  "approx": false
