[
 {
  "t0": 17.12,
  "t1": 19.19,
  "text": "走廊灯关上 书包放",
  "approx": false
 },
 {
  "t0": 19.19,
  "t1": 21.17,
  "text": "走到房间窗外望",
  "approx": false
 },
 {
  "t0": 21.17,
  "t1": 22.75,
  "text": "回想刚买的书",
  "approx": false
 },
 {
  "t0": 22.75,
  "t1": 24.67,
  "text": "一本名叫半岛铁盒",
  "approx": false
 },
 {
  "t0": 24.67,
  "t1": 26.38,
  "text": "放在床边堆好多",
  "approx": false
 },
 {
  "t0": 26.38,
  "t1": 28.65,
  "text": "第一页第六页第七页序",
  "approx": false
 },
 {
  "t0": 28.65,
  "t1": 30.23,
  "text": "我永远都想不到",
  "approx": false
 },
 {
  "t0": 30.23,
  "t1": 32.15,
  "text": "陪我看这书的你会要走",
  "approx": false
 },
 {
  "t0": 32.15,
  "t1": 33.97,
  "text": "不再是不再有",
  "approx": false
 },
 {
  "t0": 33.97,
  "t1": 36.21,
  "text": "现在已经看不到",
  "approx": false
 },
 {
  "t0": 36.21,
  "t1": 37.58,
  "text": "铁盒的钥匙孔",
  "approx": false
 },
 {
  "t0": 37.58,
  "t1": 39.74,
  "text": "透了光看见它锈了好久",
  "approx": false
 },
 {
  "t0": 39.74,
  "t1": 40.9,
  "text": "好旧好旧",
  "approx": false
 },
 {
  "t0": 40.9,
  "t1": 43.38,
  "text": "外围的灰尘包围了我",
  "approx": false
 },
 {
  "t0": 43.38,
  "t1": 44.47,
  "text": "好暗好暗",
  "approx": false
 },
 {
  "t0": 44.47,
  "t1": 47.33,
  "text": "铁盒的钥匙我找不到",
  "approx": false
 },
 {
  "t0": 47.33,
  "t1": 49.9,
  "text": "放在糖果旁的",
  "approx": false
 },
 {
  "t0": 49.9,
  "t1": 54.64,
  "text": "是我很想回忆的甜",
  "approx": false
 },
 {
  "t0": 54.64,
  "t1": 57.88,
  "text": "然而过滤了你和我",
  "approx": false
 },
 {
  "t0": 57.88,
  "t1": 62.17,
  "text": "沦落而成美",
  "approx": false
 },
 {
  "t0": 62.17,
  "t1": 65.3,
  "text": "沉在盒子里的是你",
  "approx": false
 },
 {
  "t0": 65.3,
  "t1": 69.31,
  "text": "给我的快乐",
  "approx": false
 },
 {
  "t0": 69.31,
  "t1": 75.11,
  "text": "我很想记得可是我记不得",
  "approx": false
 },
 {
  "t0": 75.11,
  "t1": 78.6,
  "text": "为什么这样子",
  "approx": false
 },
 {
  "t0": 78.6,
  "t1": 82.89,
  "text": "你拉着我 说你有些犹豫",
  "approx": false
 },
 {
  "t0": 82.89,
  "t1": 85.92,
  "text": "怎么这样子",
  "approx": false
 },
 {
  "t0": 85.92,
  "t1": 90.05,
  "text": "雨还没停你就撑伞要走",
  "approx": false
 },
 {
  "t0": 90.05,
  "t1": 93.85,
  "text": "已经习惯不去阻止你",
  "approx": false
 },
 {
  "t0": 93.85,
  "t1": 98.24,
  "text": "过好一阵子你就会回来",
  "approx": false
 },
 {
  "t0": 98.24,
  "t1": 100.6,
  "text": "印象中的爱情",
  "approx": false
 },
 {
  "t0": 100.6,
  "t1": 104.5,
  "text": "好像顶不住那时间",
  "approx": false
 },
 {
  "t0": 104.5,
  "t1": 107.82,
  "text": "为什么这样子",
  "approx": false
 },
 {
  "t0": 107.82,
  "t1": 112.22,
  "text": "你看着我说你已经决定",
  "approx": false
 },
 {
  "t0": 112.22,
  "t1": 115.2,
  "text": "我拉不住你",
  "approx": false
 },
 {
  "t0": 115.2,
  "t1": 119.71,
  "text": "他的手应该比我更暖",
  "approx": false
 },
 {
  "t0": 119.71,
  "t1": 123.4,
  "text": "铁盒的序变成了日记",
  "approx": false
 },
 {
  "t0": 123.4,
  "t1": 127.59,
  "text": "变成了空气 演化成回忆",
  "approx": false
 },
 {
  "t0": 127.59,
  "t1": 130.13,
  "text": "印象中的爱情",
  "approx": false
 },
 {
  "t0": 130.13,
  "t1": 133.89,
  "text": "好像顶不住那时间",
  "approx": false
 },
 {
  "t0": 133.89,
  "t1": 149.74,
  "text": "所以你弃权",
  "approx": false
 },
 {
