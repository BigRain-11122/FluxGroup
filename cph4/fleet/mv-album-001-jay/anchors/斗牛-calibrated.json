 },
 {
  "t0": 46.5,
  "t1": 48.36,
  "text": "三分球它在空中停留",
  "approx": false
 },
 {
  "t0": 48.36,
  "t1": 50.24,
  "text": "所有人看着我",
  "approx": false
 },
 {
  "t0": 50.24,
  "t1": 51.88,
  "text": "抛物线进球",
  "approx": true
 },
 {
  "t0": 51.88,
  "t1": 53.9,
  "text": "单手过人运球",
  "approx": false
 },
 {
  "t0": 53.9,
  "t1": 55.68,
  "text": "篮下妙传出手",
  "approx": false
 },
 {
  "t0": 55.68,
  "t1": 57.62,
  "text": "漂亮的假动作",
  "approx": false
 },
 {
  "t0": 57.62,
  "t1": 58.58,
  "text": "帅呆了我",
  "approx": false
 },
 {
  "t0": 58.58,
  "t1": 61.3,
  "text": "全场盯人防守",
  "approx": false
 },
 {
  "t0": 61.3,
  "t1": 63.16,
  "text": "篮下禁区游走",
  "approx": false
 },
 {
  "t0": 63.16,
  "t1": 65.0,
  "text": "快攻抢篮板球",
  "approx": false
 },
 {
  "t0": 65.0,
  "t1": 66.74,
  "text": "得分都靠我",
  "approx": false
 },
 {
  "t0": 66.74,
  "t1": 68.7,
  "text": "你拿了球不投",
  "approx": true
 },
 {
  "t0": 68.7,
  "t1": 70.52,
  "text": "又不会掩护我",
  "approx": false
 },
 {
  "t0": 70.52,
  "t1": 72.32,
  "text": "选你这种队友",
  "approx": false
 },
 {
  "t0": 72.32,
  "t1": 75.7,
  "text": "瞎透了我",
  "approx": true
 },
 {
  "t0": 75.7,
  "t1": 76.68,
  "text": "说你说分数怎么停留",
  "approx": false
 },
 {
  "t0": 76.68,
  "t1": 77.62,
  "text": "一直在停留谁让它停留的",
  "approx": false
 },
 {
  "t0": 78.78,
  "t1": 79.4,
  "text": "为什么我女朋友场外加油",
  "approx": false
 },
 {
  "t0": 81.24,
  "t1": 82.0,
  "text": "你却还让我出糗",
  "approx": false
 },
 {
  "t0": 82.0,
  "t1": 82.56,
  "text": "你说啊你怎么抄我球",
  "approx": false
 },
 {
  "t0": 82.56,
  "t1": 85.62,
  "text": "你说啊你怎么打我手",
  "approx": false
 },
 {
  "t0": 86.36,
  "t1": 88.34,
  "text": "你说是不是你不想活",
  "approx": false
 },
 {
  "t0": 89.48,
  "t1": 91.42,
  "text": "说你怎么面对我",
  "approx": false
 },
 {
  "t0": 91.42,
  "t1": 93.04,
  "text": "甩开球我满腔的怒火",
  "approx": false
 },
 {
  "t0": 93.58,
  "t1": 95.38,
  "text": "我想揍你已经很久别想走",
  "approx": false
 },
 {
  "t0": 96.8,
  "t1": 98.82,
  "text": "说你眼睛看着我",
  "approx": false
 },
 {
  "t0": 98.82,
  "t1": 100.72,
  "text": "别发抖你给我抬起头",
  "approx": false
 },
