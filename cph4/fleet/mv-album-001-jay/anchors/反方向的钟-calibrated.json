[
 {
  "t0": 45.57,
  "t1": 47.97,
  "text": "迷迷蒙蒙 你给的梦",
  "approx": false
 },
 {
  "t0": 47.97,
  "t1": 50.35,
  "text": "出现裂缝 隐隐作痛",
  "approx": false
 },
 {
  "t0": 50.35,
  "t1": 52.8,
  "text": "怎么沟通 你都没空",
  "approx": false
 },
 {
  "t0": 52.8,
  "t1": 55.5,
  "text": "说我不懂 说了没用",
  "approx": false
 },
 {
  "t0": 55.5,
  "t1": 57.85,
  "text": "他的笑容 有何不同",
  "approx": false
 },
 {
  "t0": 57.85,
  "t1": 60.68,
  "text": "在你心中 我不再受宠",
  "approx": false
 },
 {
  "t0": 60.68,
  "t1": 63.0,
  "text": "我的天空 是雨是风",
  "approx": false
 },
 {
  "t0": 63.0,
  "t1": 66.51,
  "text": "还是彩虹 你在操纵",
  "approx": false
 },
 {
  "t0": 66.51,
  "t1": 68.59,
  "text": "恨自己真的没用",
  "approx": false
 },
 {
  "t0": 68.59,
  "t1": 71.12,
  "text": "情绪激动",
  "approx": false
 },
 {
  "t0": 71.12,
  "t1": 75.0,
  "text": "一颗心到现在还在抽痛",
  "approx": false
 },
 {
  "t0": 75.0,
  "t1": 80.28,
  "text": "还为分手前那句抱歉",
  "approx": false
 },
 {
  "t0": 80.28,
  "t1": 86.22,
  "text": "在感动",
  "approx": false
 },
 {
  "t0": 86.22,
  "t1": 90.97,
  "text": "穿梭时间的画面的钟",
  "approx": false
 },
 {
  "t0": 90.97,
  "t1": 96.17,
  "text": "从反方向开始移动",
  "approx": false
 },
 {
  "t0": 96.17,
  "t1": 101.01,
  "text": "回到当初爱你的时空",
  "approx": false
 },
 {
  "t0": 101.01,
  "t1": 106.52,
  "text": "停格内容不忠",
  "approx": false
 },
 {
  "t0": 106.52,
  "t1": 111.26,
  "text": "所有回忆对着我进攻",
  "approx": false
 },
 {
  "t0": 111.26,
  "t1": 116.4,
  "text": "我的伤口被你拆封",
  "approx": false
 },
 {
  "t0": 116.4,
  "t1": 121.28,
  "text": "誓言太沉重泪被纵容",
  "approx": false
 },
 {
  "t0": 121.28,
  "t1": 136.57,
  "text": "脸上汹涌失控",
  "approx": false
 },
 {
  "t0": 136.57,
  "t1": 138.35,
  "text": "城市霓虹 不安跳动",
  "approx": false
 },
 {
  "t0": 138.35,
  "t1": 139.22,
  "text": "染红夜空",
  "approx": false
 },
 {
  "t0": 139.22,
  "t1": 140.68,
  "text": "过去种种 像一场梦",
  "approx": false
 },
 {
  "t0": 140.68,
  "t1": 141.82,
  "text": "不敢去碰 一想就痛",
  "approx": false
 },
 {
  "t0": 141.82,
  "t1": 143.07,
  "text": "心碎内容 每一秒钟",
  "approx": false
 },
 {
  "t0": 143.07,
  "t1": 144.16,
  "text": "都有不同 你不懂",
  "approx": false
 },
 {
  "t0": 144.16,
  "t1": 145.74,
  "text": "连一句珍重 也有苦衷",
  "approx": false
 },
 {
  "t0": 145.74,
  "t1": 146.51,
  "text": "也不想送",
  "approx": false
 },
 {
  "t0": 146.51,
  "t1": 147.81,
  "text": "寒风中 废墟烟囱",
  "approx": false
 },
 {
  "t0": 147.81,
  "t1": 149.07,
  "text": "停止转动 一切落空",
  "approx": false
 },
 {
  "t0": 149.07,
  "t1": 150.57,
  "text": "在人海中 盲目跟从",
  "approx": false
 },
 {
  "t0": 150.57,
  "t1": 151.87,
  "text": "别人的梦 全面放纵",
  "approx": false
 },
 {
  "t0": 151.87,
  "t1": 153.29,
  "text": "恨没有用 疗伤止痛",
  "approx": false
 },
 {
  "t0": 153.29,
  "t1": 154.5,
  "text": "不再感动 没有梦",
  "approx": false
 },
 {
  "t0": 154.5,
  "t1": 156.03,
  "text": "痛不知轻重 泪水鲜红",
  "approx": false
 },
 {
  "t0": 156.03,
