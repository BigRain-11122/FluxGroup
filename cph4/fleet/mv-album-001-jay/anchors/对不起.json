 "lines": [
  {
   "t0": 5.66,
   "t1": 6.22,
   "text": "Zither Harp"
  },
  {
   "t0": 20.66,
   "t1": 22.56,
   "text": "光常一枚通鼻"
  },
  {
   "t0": 22.56,
   "t1": 24.28,
   "text": "悲傷的很隱秘"
  },
  {
   "t0": 24.28,
   "t1": 26.88,
   "text": "它在細菸池裡靜靜"
  },
  {
   "t0": 26.88,
   "t1": 29.4,
   "text": "疼惜太多的我愛你"
  },
  {
   "t0": 29.4,
   "t1": 32.24,
   "text": "讓它穿不過氣景"
  },
  {
   "t0": 32.8,
   "t1": 34.92,
   "text": "失去一切"
  },
  {
   "t0": 34.92,
   "t1": 36.28,
   "text": "只在哭泣"
  },
  {
   "t0": 36.28,
   "t1": 37.94,
   "text": "靜靜躺在抽屜"
  },
  {
   "t0": 37.94,
   "t1": 41.5,
   "text": "它所有擁有的只剩下唯一"
  },
  {
   "t0": 41.5,
   "t1": 43.14,
   "text": "相愛還有別地"
  },
  {
   "t0": 43.14,
   "t1": 45.86,
   "text": "像無法被安排的雨"
  },
  {
   "t0": 45.86,
   "t1": 48.52,
   "text": "誰是真沒來心"
  },
  {
   "t0": 48.52,
   "t1": 53.26,
   "text": "我懷念起過小的客座地"
  },
  {
   "t0": 53.26,
   "t1": 55.56,
   "text": "換顏值用錢筆寫不記"
  },
  {
   "t0": 55.56,
   "t1": 59.2,
   "text": "記錄那醉顏色的魅力"
  },
  {
   "t0": 59.2,
   "t1": 62.68,
   "text": "記錄第一次遇見的你追求"
  },
  {
   "t0": 62.68,
   "t1": 65.84,
   "text": "我管我遇見你是一種迷劇"
  },
  {
   "t0": 65.84,
   "t1": 69.36,
   "text": "我想過這輩子注定一個年期"
  },
  {
   "t0": 69.36,
   "t1": 73.1,
   "text": "最後再一個那慢慢回憶"
  },
  {
   "t0": 73.1,
   "t1": 74.36,
   "text": "沒有了過去"
  },
  {
   "t0": 74.36,
   "t1": 76.22,
   "text": "我將往事抽離"
  },
  {
   "t0": 76.22,
   "t1": 79.64,
   "text": "我管我遇見你是一種迷劇"
  },
  {
   "t0": 79.64,
   "t1": 83.12,
   "text": "我可以繞生命就這樣保護你"
  },
  {
   "t0": 83.12,
   "t1": 86.48,
   "text": "我許著最多能力的迷劇"
  },
  {
   "t0": 86.48,
   "t1": 89.82,
   "text": "輕輕的嘆息後面針對不起"
  },
  {
