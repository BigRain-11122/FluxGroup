 "lines": [
  {
   "t0": 5.34,
   "t1": 5.94,
   "text": "Zither Harp"
  },
  {
   "t0": 19.4,
   "t1": 23.02,
   "text": "親愛的終極 些是沒辦法交"
  },
  {
   "t0": 23.02,
   "t1": 26.08,
   "text": "老足親的感覺有一邊都"
  },
  {
   "t0": 26.08,
   "t1": 29.14,
   "text": "來這裡就會讓人的感冒"
  },
  {
   "t0": 29.14,
   "t1": 32.0,
   "text": "一想找到的過程都老"
  },
  {
   "t0": 32.0,
   "t1": 35.3,
   "text": "我走過太大都走得模糊"
  },
  {
   "t0": 35.3,
   "t1": 38.44,
   "text": "自己觀察它的信號"
  },
  {
   "t0": 39.14,
   "t1": 41.02,
   "text": "而我緊握的外表"
  },
  {
   "t0": 41.02,
   "t1": 42.58,
   "text": "想像緊握的發料"
  },
  {
   "t0": 42.58,
   "t1": 44.92,
   "text": "等待的大介紹"
  },
  {
   "t0": 44.92,
   "t1": 48.5,
   "text": "在那些冒 萬能追逃"
  },
  {
   "t0": 48.5,
   "t1": 51.34,
   "text": "無比心的對我笑"
  },
  {
   "t0": 51.34,
   "t1": 54.98,
   "text": "沒有遇到 住過一條"
  },
  {
   "t0": 54.98,
   "t1": 57.6,
   "text": "竟然現被我訊號"
  },
  {
   "t0": 57.6,
   "t1": 61.22,
   "text": "在那些冒 萬能追逃"
  },
  {
   "t0": 61.22,
   "t1": 64.0,
   "text": "有一個身對我拍照"
  },
  {
   "t0": 64.0,
   "t1": 67.52,
   "text": "我接不掉 他的微笑"
  },
  {
   "t0": 67.52,
   "t1": 70.3,
   "text": "表演幸福的回答"
  },
  {
   "t0": 70.3,
   "t1": 73.46,
   "text": "一些人是沒辦法交"
  },
  {
   "t0": 73.46,
   "t1": 76.54,
   "text": "把錯親的感覺有一點早"
  },
  {
   "t0": 76.54,
   "t1": 79.64,
   "text": "來這裡不做 為了那個冒"
  },
  {
   "t0": 79.64,
   "t1": 82.32,
   "text": "一想找到的過程都老"
  },
  {
   "t0": 82.32,
   "t1": 86.06,
   "text": "兩愛的方式 無法拿離那條"
  },
  {
   "t0": 86.06,
   "t1": 88.88,
   "text": "也沒有規則可以去找"
  },
  {
   "t0": 89.54,
   "t1": 92.44,
   "text": "白龍的遠方 遠不可靠"
  },
  {
   "t0": 92.44,
   "t1": 95.56,
   "text": "奇幻的最想要自己跳"
  },
  {
   "t0": 95.56,
   "t1": 98.56,
   "text": "找個愛情 只能外表"
  },
  {
   "t0": 98.56,
   "t1": 101.86,
   "text": "想起我只能 睡眠的這個想要"
  },
  {
   "t0": 101.86,
   "t1": 104.66,
   "text": "早點想的 你看重要"
  },
  {
   "t0": 104.66,
   "t1": 108.1,
   "text": "自己的 交我的美好"
  },
  {
