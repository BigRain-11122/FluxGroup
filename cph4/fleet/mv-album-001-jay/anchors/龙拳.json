 ],
 "lines": [
  {
   "t0": 35.54,
   "t1": 35.9,
   "text": "Zither Harp"
  },
  {
   "t0": 49.12,
   "t1": 54.1,
   "text": "一度 問我願心 自動被動 自命主的海岸 卸向於自動"
  },
  {
   "t0": 54.1,
   "t1": 59.16,
   "text": "那長城相互 今天來台上的夢 我用手陪拉開這整個土地的鐘"
  },
  {
   "t0": 59.16,
   "t1": 62.36,
   "text": "光不高 雲南下的風 現現什麼淚濃"
  },
  {
   "t0": 62.36,
   "t1": 64.98,
   "text": "漢字道 平等不懂 一樣不成何天空"
  },
  {
   "t0": 64.98,
   "t1": 67.48,
   "text": "快雲黃了 都奔程太沾頂峰"
  },
  {
   "t0": 67.48,
   "t1": 70.22,
   "text": "我想起 明明風 賽車一聲 無不通"
  },
  {
   "t0": 80.08,
   "t1": 84.98,
   "text": "要渴望著 現換向 無限的 救命英雄"
  },
  {
   "t0": 84.98,
   "t1": 90.0,
   "text": "我把地台通過 降雨 降水 風 連帶古老 滑倒的遠走"
  },
  {
   "t0": 90.74,
   "t1": 93.3,
   "text": "我多全帶來 藍天 黃色溫龍"
  },
  {
   "t0": 93.3,
   "t1": 95.64,
   "text": "把山帶最新 靈魂的天天 天天空"
  },
  {
   "t0": 95.64,
   "t1": 98.42,
   "text": "將東方的人 從飄散的星空"
  },
  {
   "t0": 98.42,
   "t1": 101.18,
   "text": "回到 回到 去進 去走走"
  },
  {
   "t0": 101.18,
   "t1": 103.62,
   "text": "我多全帶來 藍天 黃色溫龍"
  },
  {
   "t0": 103.62,
   "t1": 106.3,
   "text": "那大點心 總是永不安革龍"
  },
  {
   "t0": 106.3,
   "t1": 108.76,
   "text": "卻世界 都到盡 自身相宜中"
  },
  {
   "t0": 108.76,
   "t1": 111.4,
   "text": "等待 聽說 我就是那個龍"
  },
  {
   "t0": 111.4,
   "t1": 113.9,
   "text": "我多全帶來 藍天 黃色溫龍"
  },
  {
   "t0": 113.9,
   "t1": 116.26,
   "text": "把山帶最新 靈魂的天天空"
  },
  {
   "t0": 116.26,
   "t1": 119.14,
   "text": "將東方的人 從飄散的星空"
  },
  {
   "t0": 119.14,
   "t1": 121.84,
   "text": "回到 回到 去進去 去走走"
  },
  {
   "t0": 121.84,
   "t1": 124.36,
   "text": "我多全帶來 藍天 黃色溫龍"
  },
  {
   "t0": 124.36,
   "t1": 126.74,
   "text": "那大點心 總是永不安革龍"
  },
  {
   "t0": 126.74,
   "t1": 129.3,
   "text": "卻世界 都到盡 自身相宜中"
  },
  {
   "t0": 129.3,
   "t1": 132.06,
   "text": "等待 聽說 我就是那個龍"
  },
  {
   "t0": 146.74,
   "t1": 148.14,
   "text": "Zither Harp"
  },
  {
   "t0": 150.2,
   "t1": 150.78,
   "text": "Zither Harp"
  },
  {
   "t0": 167.1,
   "t1": 170.9,
   "text": "客人 光這些 團結 頭目 現可見"
  },
  {
   "t0": 170.9,
   "t1": 173.14,
   "text": "我聽說 沒辦法 只是財富"
  },
  {
   "t0": 173.14,
