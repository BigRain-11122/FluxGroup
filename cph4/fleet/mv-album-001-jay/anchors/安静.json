 "lines": [
  {
   "t0": 3.56,
   "t1": 4.96,
   "text": "Zither Harp"
  },
  {
   "t0": 10.0,
   "t1": 10.92,
   "text": "Zither Harp"
  },
  {
   "t0": 27.06,
   "t1": 32.28,
   "text": "只剩下鋼琴被我吞了一天"
  },
  {
   "t0": 32.28,
   "t1": 39.36,
   "text": "睡著的大提琴 安靜的救救人"
  },
  {
   "t0": 40.72,
   "t1": 45.52,
   "text": "我想你一表現得非常明白"
  },
  {
   "t0": 45.52,
   "t1": 52.66,
   "text": "我懂我也知道 你理由捨不得"
  },
  {
   "t0": 53.86,
   "t1": 58.84,
   "text": "你說你也會難過我不相信"
  },
  {
   "t0": 60.34,
   "t1": 66.1,
   "text": "堅持你背著我也只是曾經"
  },
  {
   "t0": 66.1,
   "t1": 72.3,
   "text": "希望他是真的比我還要愛你"
  },
  {
   "t0": 72.84,
   "t1": 77.34,
   "text": "我才會比自己厲害"
  },
  {
   "t0": 81.04,
   "t1": 87.58,
   "text": "你要我說多難看我根本不想分開"
  },
  {
   "t0": 87.58,
   "t1": 93.44,
   "text": "為什麼還要我又會笑來帶過"
  },
  {
   "t0": 93.44,
   "t1": 100.86,
   "text": "我沒有這種天分 包容你也接受他"
  },
  {
   "t0": 100.86,
   "t1": 107.64,
   "text": "不用擔心的太多 我會一直好好過"
  },
  {
   "t0": 107.64,
   "t1": 114.3,
   "text": "你已經遠遠離開 我也會慢慢走開"
  },
  {
   "t0": 114.3,
   "t1": 120.42,
   "text": "為什麼我連分開都牽扯著你"
  },
  {
   "t0": 120.42,
   "t1": 127.62,
   "text": "我真的沒有天分 安靜的飛這麼快"
  },
  {
   "t0": 127.62,
   "t1": 134.32,
   "text": "我會試著放棄你 是因為我太愛你"
  },
