  "approx": false
 },
 {
  "t0": 35.82,
  "t1": 37.83,
  "text": "沙漠之中怎么会有泥鳅",
  "approx": false
 },
 {
  "t0": 37.83,
  "t1": 40.81,
  "text": "话说完飞过一只海鸥",
  "approx": false
 },
 {
  "t0": 40.81,
  "t1": 44.1,
  "text": "大峡谷的风呼啸而过",
  "approx": false
 },
 {
  "t0": 44.1,
  "t1": 45.57,
  "text": "是谁说没有",
  "approx": false
 },
 {
  "t0": 45.57,
  "t1": 48.1,
  "text": "有一条热昏头的响尾蛇",
  "approx": false
 },
 {
  "t0": 48.1,
  "t1": 50.65,
  "text": "无力的躺在干枯的河",
  "approx": false
 },
 {
  "t0": 50.65,
  "t1": 56.13,
  "text": "在等待雨季来临变沼泽",
  "approx": false
 },
 {
  "t0": 56.13,
  "t1": 58.24,
  "text": "灰狼啃食着水鹿的骨头",
  "approx": false
 },
 {
  "t0": 58.24,
  "t1": 60.85,
  "text": "秃鹰盘旋死盯着腐肉",
  "approx": false
 },
 {
  "t0": 60.85,
  "t1": 64.56,
  "text": "草原上两只敌对野牛",
  "approx": false
 },
 {
  "t0": 64.56,
  "t1": 66.53,
  "text": "在远方决斗",
  "approx": false
 },
 {
  "t0": 66.53,
  "t1": 68.58,
  "text": "在一处被废弃的白蚁丘",
  "approx": false
 },
 {
  "t0": 68.58,
  "t1": 81.32,
  "text": "站着一只饿昏的老斑鸠",
  "approx": false
 },
 {
  "t0": 81.32,
  "t1": 83.79,
  "text": "印地安老斑鸠腿短毛不多",
  "approx": false
 },
 {
  "t0": 83.79,
  "t1": 86.62,
  "text": "几天都没有喝水也能活",
  "approx": false
 },
 {
  "t0": 86.62,
  "t1": 88.99,
  "text": "脑袋瓜有一点秀逗",
  "approx": false
 },
 {
  "t0": 88.99,
  "t1": 91.43,
  "text": "猎物死了它比谁都难过",
  "approx": false
 },
 {
  "t0": 91.43,
  "t1": 94.05,
  "text": "印地安斑鸠 会学人开口",
  "approx": false
 },
 {
  "t0": 94.05,
  "t1": 96.87,
  "text": "仙人掌怕羞 蜥蝪横着走",
  "approx": false
 },
 {
  "t0": 96.87,
  "t1": 99.53,
  "text": "这里什么奇怪的事都有",
  "approx": false
 },
 {
  "t0": 99.53,
  "t1": 101.86,
  "text": "包括像猫的狗",
  "approx": false
 },
 {
  "t0": 101.86,
  "t1": 104.32,
  "text": "印地安老斑鸠平常话不多",
  "approx": false
 },
 {
  "t0": 104.32,
  "t1": 107.14,
  "text": "除非是乌鸦抢了它的窝",
  "approx": false
 },
 {
  "t0": 107.14,
  "t1": 109.34,
  "text": "它在灌木丛旁邂逅",
  "approx": false
 },
 {
  "t0": 109.34,
  "t1": 137.69,
  "text": "一只令它心仪的母斑鸠",
  "approx": false
 },
 {
  "t0": 137.69,
  "t1": 139.89,
  "text": "牛仔红蕃在小镇背对背决斗",
  "approx": false
 },
 {
  "t0": 139.89,
  "t1": 142.7,
  "text": "一只灰狼问候我谁是神枪手",
  "approx": false
 },
 {
  "t0": 142.7,
  "t1": 143.8,
  "text": "巫师他念念有词地",
  "approx": false
 },
 {
  "t0": 143.8,
  "t1": 144.55,
  "text": "对酋长下诅咒",
  "approx": false
 },
 {
  "t0": 144.55,
  "t1": 145.6,
  "text": "还我骷髅头 这故事",
  "approx": false
 },
 {
  "t0": 145.6,
  "t1": 146.78,
  "text": "告诉我印地安的传说",
  "approx": false
 },
 {
  "t0": 146.78,
  "t1": 148.05,
  "text": "还真是瞎透了什么都有",
  "approx": false
 },
 {
