[
 {
  "t0": 27.7,
  "t1": 31.7,
  "text": "听我讲 庄脚ㄟ路边 蝉躲在树枝",
  "approx": false
 },
 {
  "t0": 31.7,
  "t1": 33.84,
  "text": "七月天 闹热ㄟ唱戏",
  "approx": false
 },
 {
  "t0": 33.84,
  "t1": 35.72,
  "text": "ㄒㄧ ㄌㄚ ㄙㄡ ㄈㄚ ㄇㄧ",
  "approx": false
 },
 {
  "t0": 35.72,
  "t1": 39.56,
  "text": "听我讲 风景这呢水 火车叨位去",
  "approx": false
 },
 {
  "t0": 39.56,
  "t1": 41.77,
  "text": "拿纸笔 写歌思念你",
  "approx": false
 },
 {
  "t0": 41.77,
  "t1": 43.24,
  "text": "ㄒㄧ ㄌㄚ ㄙㄡ ㄈㄚ ㄇㄧ",
  "approx": false
 },
 {
  "t0": 43.24,
  "t1": 47.16,
  "text": "车过山洞变成 暗瞑",
  "approx": false
 },
 {
  "t0": 47.16,
  "t1": 51.09,
  "text": "但是连咪都ㄟ 过去",
  "approx": false
 },
 {
  "t0": 51.09,
  "t1": 55.01,
  "text": "按怎你走那个 当时",
  "approx": false
 },
 {
  "t0": 55.01,
  "t1": 58.95,
  "text": "没留半张批纸 加字",
  "approx": false
 },
 {
  "t0": 58.95,
  "t1": 59.48,
  "text": "过去",
  "approx": false
 },
 {
  "t0": 59.48,
  "t1": 61.24,
  "text": "过去 像溪边ㄟ田蝇",
  "approx": false
 },
 {
  "t0": 61.24,
  "t1": 61.6,
  "text": "拢是",
  "approx": false
 },
 {
  "t0": 61.6,
  "t1": 63.3,
  "text": "拢是 逗阵飞ㄟ日子",
  "approx": false
 },
 {
  "t0": 63.3,
  "t1": 63.72,
  "text": "这时",
  "approx": false
 },
 {
  "t0": 63.72,
  "t1": 65.4,
  "text": "这时 我像离水ㄟ鱼",
  "approx": false
 },
 {
  "t0": 65.4,
  "t1": 65.89,
  "text": "放抹记",
  "approx": false
 },
 {
  "t0": 65.89,
  "t1": 67.32,
  "text": "放抹记 剩最后一口气",
  "approx": false
 },
 {
  "t0": 67.32,
  "t1": 67.77,
  "text": "放抹记",
  "approx": false
 },
 {
  "t0": 67.77,
  "t1": 68.49,
  "text": "过去",
  "approx": false
 },
 {
  "t0": 68.49,
  "t1": 69.91,
  "text": "过去 你迷人ㄟ气质",
  "approx": false
 },
 {
  "t0": 69.91,
  "t1": 70.28,
  "text": "拢是",
  "approx": false
 },
 {
  "t0": 70.28,
  "t1": 71.7,
  "text": "拢是 笑容酸甘呀甜",
  "approx": false
 },
 {
  "t0": 71.7,
  "t1": 72.02,
  "text": "返去",
  "approx": false
 },
 {
  "t0": 72.02,
  "t1": 74.5,
  "text": "返去 故事到这为止",
  "approx": false
 },
 {
  "t0": 74.5,
  "t1": 78.39,
  "text": "你那ㄟ全然拢没消息",
  "approx": false
 },
 {
  "t0": 78.39,
  "t1": 82.33,
  "text": "我亲像一只蜂找没蜜",
  "approx": false
 },
 {
  "t0": 82.33,
  "t1": 86.23,
  "text": "将过去一张一张ㄟ撕",
  "approx": false
 },
 {
  "t0": 86.23,
  "t1": 90.17,
  "text": "这日历 马撕到何时才有你ㄟ字",
  "approx": false
 },
 {
  "t0": 90.17,
  "t1": 94.09,
  "text": "你那 全然拢没讯息",
  "approx": false
 },
 {
  "t0": 94.09,
  "t1": 98.1,
  "text": "像往南ㄟ燕子断翅",
  "approx": false
 },
 {
  "t0": 98.1,
  "t1": 101.94,
  "text": "不曾搁返来巢看厝边",
  "approx": false
 },
 {
  "t0": 101.94,
  "t1": 104.45,
  "text": "为啥咪铁支路直直",
  "approx": false
 },
 {
